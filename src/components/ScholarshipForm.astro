---
---

<div class="bg-gradient-to-br from-navy-900 to-navy-950 text-white rounded-2xl shadow-xl border border-navy-800 p-6 md:p-8" id="form-tai-tro">
  <div class="border-b border-navy-800 pb-5 mb-6">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-400 text-xs font-semibold mb-2 border border-warmOrange-500/30">
      <svg class="w-4 h-4 text-warmOrange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Đồng hành cùng thế hệ tương lai</span>
    </div>
    <h3 class="text-xl md:text-2xl font-bold text-white">Đăng Ký Tài Trợ Quỹ Học Bổng</h3>
    <p class="text-sm text-slate-300 mt-1">
      Mỗi sự sẻ chia của anh/chị cựu học sinh là nguồn động viên to lớn giúp các em học sinh có hoàn cảnh khó khăn trường THPT Xuân Lộc vững bước đến trường.
    </p>
  </div>

  <form id="scholarship-form" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="scholarName" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">
          Họ tên cá nhân / Doanh nghiệp / Khóa <span class="text-warmOrange-400">*</span>
        </label>
        <input
          type="text"
          id="scholarName"
          name="fullName"
          required
          placeholder="VD: Cựu học sinh Nguyễn Văn A / Tập thể Khóa 2005-2008"
          class="w-full px-4 py-2.5 rounded-xl bg-navy-950/80 border border-navy-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-warmOrange-500 focus:border-warmOrange-500 text-sm outline-none transition"
        />
      </div>

      <div>
        <label for="scholarPhone" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">
          Số điện thoại / Zalo liên hệ <span class="text-warmOrange-400">*</span>
        </label>
        <input
          type="tel"
          id="scholarPhone"
          name="phone"
          required
          placeholder="VD: 0912 345 678"
          class="w-full px-4 py-2.5 rounded-xl bg-navy-950/80 border border-navy-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-warmOrange-500 focus:border-warmOrange-500 text-sm outline-none transition"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="scholarAmount" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">
          Mức đóng góp dự kiến (VNĐ) <span class="text-warmOrange-400">*</span>
        </label>
        <select
          id="scholarAmount"
          name="amount"
          required
          class="w-full px-4 py-2.5 rounded-xl bg-navy-950/80 border border-navy-700 text-white focus:ring-2 focus:ring-warmOrange-500 focus:border-warmOrange-500 text-sm outline-none transition"
        >
          <option value="500000">500.000 VNĐ</option>
          <option value="1000000" selected>1.000.000 VNĐ (1 Suất học bổng nhỏ)</option>
          <option value="2000000">2.000.000 VNĐ (1 Suất học bổng khuyến học)</option>
          <option value="5000000">5.000.000 VNĐ (Tài trợ học phí cả năm)</option>
          <option value="10000000">10.000.000 VNĐ (Đồng hành đặc biệt)</option>
          <option value="other">Số tiền khác / Hiện vật</option>
        </select>
      </div>

      <div>
        <label for="scholarBatch" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">
          Cựu học sinh khóa (hoặc tổ chức)
        </label>
        <input
          type="text"
          id="scholarBatch"
          name="batch"
          placeholder="VD: Khóa 2005 - 2008 hoặc Mạnh thường quân"
          class="w-full px-4 py-2.5 rounded-xl bg-navy-950/80 border border-navy-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-warmOrange-500 focus:border-warmOrange-500 text-sm outline-none transition"
        />
      </div>
    </div>

    <div>
      <label for="scholarNote" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">
        Lời chúc gửi gắm đến các em học sinh / Ghi chú
      </label>
      <textarea
        id="scholarNote"
        name="note"
        rows="3"
        placeholder="Lời nhắn gửi trao động lực đến các em học sinh nghèo vượt khó..."
        class="w-full px-4 py-2.5 rounded-xl bg-navy-950/80 border border-navy-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-warmOrange-500 focus:border-warmOrange-500 text-sm outline-none transition"
      ></textarea>
    </div>

    <div>
      <button
        type="submit"
        id="scholar-submit-btn"
        class="w-full py-3.5 px-6 rounded-xl text-white font-semibold bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-lg shadow-warmOrange-500/25 transition duration-200 flex items-center justify-center space-x-2"
      >
        <span id="scholar-btn-text">Xác Nhận Đăng Ký Tài Trợ</span>
        <svg id="scholar-spinner" class="hidden animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
    </div>

    <div id="scholar-feedback" class="hidden p-4 rounded-xl text-sm font-medium"></div>
  </form>
</div>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

  const form = document.getElementById('scholarship-form') as HTMLFormElement;
  const submitBtn = document.getElementById('scholar-submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('scholar-btn-text');
  const spinner = document.getElementById('scholar-spinner');
  const feedback = document.getElementById('scholar-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !btnText || !spinner || !feedback) return;

    submitBtn.disabled = true;
    btnText.textContent = 'Đang gửi đăng ký...';
    spinner.classList.remove('hidden');
    feedback.classList.add('hidden');

    try {
      const formData = new FormData(form);
      const fullName = (formData.get('fullName') as string).trim();
      const phone = (formData.get('phone') as string).trim();
      const amount = formData.get('amount') as string;
      const batch = (formData.get('batch') as string || '').trim();
      const note = (formData.get('note') as string || '').trim();

      await addDoc(collection(db, 'scholarships'), {
        fullName,
        phone,
        amount,
        batch,
        note,
        createdAt: serverTimestamp(),
      });

      feedback.className = 'p-4 rounded-xl text-sm font-medium bg-emerald-950/90 text-emerald-300 border border-emerald-800';
      feedback.innerHTML = `
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="font-bold text-white">Đăng ký tài trợ thành công!</span>
        </div>
        <p class="mt-1 text-xs text-emerald-200">Trân trọng cảm ơn tấm lòng hảo tâm của Anh/Chị. Đại diện Ban Liên Lạc và Quỹ học bổng THPT Xuân Lộc sẽ liên hệ sớm nhất để xác nhận thông tin.</p>
      `;
      feedback.classList.remove('hidden');
      form.reset();
    } catch (err: any) {
      console.error('Scholarship submit error:', err);
      feedback.className = 'p-4 rounded-xl text-sm font-medium bg-rose-950/90 text-rose-300 border border-rose-800';
      feedback.innerHTML = `
        <p class="font-bold text-white">Chưa thể gửi thông tin lúc này</p>
        <p class="text-xs text-rose-300 mt-0.5">${err.message || 'Vui lòng kiểm tra lại kết nối mạng.'}</p>
      `;
      feedback.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Xác Nhận Đăng Ký Tài Trợ';
      spinner.classList.add('hidden');
    }
  });
</script>
