---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { principalsHistoryData, vicePrincipalsNotable, leadershipLessons } from '../../data/leadershipHistory';

const milestones = [
  {
    year: '1985',
    title: 'Thành Lập Trường PTTH Xuân Lộc II',
    desc: 'Ngày 23/12/1985, UBND tỉnh Đồng Nai ký QĐ số 1768/QĐ-UBT thành lập trường với 2 dãy nhà cấp 4 (12 phòng học) trên đất đỏ Gia Ray, 19 thầy cô và 9 lớp học giải quyết việc học cho con em vùng căn cứ kháng chiến.'
  },
  {
    year: '1986',
    title: 'Kỳ Tích Khóa Tốt Nghiệp Đầu Tiên (92%)',
    desc: 'Ngay tại kỳ thi tốt nghiệp PTTH tháng 5/1986, tỷ lệ đỗ đạt tới 92%, tạo nên bất ngờ lớn vượt xa mặt bằng chung của tỉnh, mở màn cho truyền thống hiếu học kiên cường.'
  },
  {
    year: '1990 - 1998',
    title: 'Đổi Tên & Khánh Thành Khuôn Viên Mới 2 Hecta',
    desc: 'Trường chính thức đổi tên thành THPT Xuân Lộc. Năm 1998, trường khánh thành khuôn viên mới rộng 19.509,7 m² với hệ thống phòng học cao tầng khang trang thay thế phòng tạm.'
  },
  {
    year: '2009',
    title: 'Đón Nhận Bằng Trường Chuẩn Quốc Gia',
    desc: 'Ngày 06/11/2009, trường chính thức được công nhận đạt Chuẩn Quốc gia và tiếp tục duy trì, nâng cao các tiêu chí đạt Chuẩn Quốc gia Mức độ 2.'
  },
  {
    year: '2015',
    title: 'Đón Nhận Huân Chương Lao Động Hạng Nhất',
    desc: 'Phần thưởng cao quý của Chủ tịch nước trao tặng ghi nhận 30 năm nỗ lực vươn lên thành trường top đầu không chuyên của miền Đông Nam Bộ.'
  },
  {
    year: '1985 - 2025',
    title: '40 Năm Vẻ Vang - Top 149 Trường Trọng Điểm Quốc Gia',
    desc: 'Đào tạo hơn 20.000 học sinh ra trường, liên tục nằm trong Top 3 - Top 5 trường có số lượng HSG cấp tỉnh cao nhất Đồng Nai và lọt Top 149 trường THPT được ĐHQG TP.HCM ưu tiên xét tuyển thẳng.'
  }
];

const honors = [
  { year: '1997', title: 'Bằng Khen của Thủ Tướng Chính Phủ', note: 'Ghi nhận thành tích xây dựng trường và vượt khó nâng cao chất lượng giáo dục' },
  { year: '1998', title: 'Huân Chương Lao Động Hạng Ba', note: 'Chủ tịch nước trao tặng chặng đường đổi mới sau hơn 10 năm thành lập' },
  { year: '2009', title: 'Bằng Công Nhận Trường Chuẩn Quốc Gia', note: 'UBND tỉnh Đồng Nai cấp chứng nhận theo bộ tiêu chuẩn quốc gia' },
  { year: '2011', title: 'Huân Chương Lao Động Hạng Nhì', note: 'Khẳng định vị thế lá cờ đầu trong khối trường THPT không chuyên' },
  { year: '2011, 2013', title: 'Cờ Thi Đua của Chính Phủ', note: 'Đơn vị dẫn đầu phong trào thi đua dạy tốt - học tốt toàn quốc' },
  { year: '2015', title: 'Huân Chương Lao Động Hạng Nhất', note: 'Phần thưởng cao quý cấp Nhà nước ghi nhận 30 năm phát triển xuất sắc' },
  { year: '2024 – 2025', title: 'Cờ Thi Đua của UBND Tỉnh & Chính Phủ', note: 'Dấu ấn chào mừng 40 năm thành lập trường (1985 – 2025)' }
];
---

<BaseLayout
  title="Lịch Sử & Truyền Thống 40 Năm - THPT Xuân Lộc (1985 - 2025)"
  description="Tài liệu toàn tập về lịch sử hình thành, cơ sở vật chất, đội ngũ sư phạm và chặng đường 40 năm vẻ vang của Trường THPT Xuân Lộc, tỉnh Đồng Nai."
>
  <!-- Hero Section -->
  <section class="relative bg-navy-950 text-white py-16 lg:py-24 border-b border-navy-800 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/images/truong-xuan-loc.jpg"
        alt="Khuôn viên trường THPT Xuân Lộc"
        class="w-full h-full object-cover object-center filter brightness-[0.3] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/80 to-navy-950/50"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-bold uppercase tracking-wider mb-4 backdrop-blur-md">
        <span>Tài Liệu Toàn Tập • Kỷ Niệm 40 Năm (1985 – 2025)</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-4">
        Hành Trình 40 Năm Xây Dựng & Tỏa Sáng
      </h1>
      <p class="text-slate-300 max-w-3xl mx-auto text-sm sm:text-base md:text-lg leading-relaxed">
        Từ mái trường cấp 4 đơn sơ bên sườn núi Chứa Chan đến biểu tượng giáo dục mũi nhọn hàng đầu vùng Đông Nam Bộ và chiếc nôi chắp cánh cho hơn 20.000 thế hệ học sinh.
      </p>
    </div>
  </section>

  <!-- Quick Info Bar -->
  <section class="py-8 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-2xl sm:text-3xl font-extrabold text-navy-950">23/12/1985</div>
          <div class="text-xs text-slate-500 mt-1">Ngày thành lập trường</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-2xl sm:text-3xl font-extrabold text-warmOrange-600">19.509,7 m²</div>
          <div class="text-xs text-slate-500 mt-1">Khuôn viên chuẩn QG mức độ 2</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600">20.000+</div>
          <div class="text-xs text-slate-500 mt-1">Học sinh đã tốt nghiệp</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-2xl sm:text-3xl font-extrabold text-indigo-600">Top 149</div>
          <div class="text-xs text-slate-500 mt-1">Trường ưu tiên ĐHQG TP.HCM</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Lịch sử & Các giai đoạn phát triển -->
  <section class="py-16 bg-slate-50" id="lich-su">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-2 mb-12">
        <span class="text-warmOrange-600 font-bold text-xs uppercase tracking-wider">Dấu Ấn Lịch Sử</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Các Mốc Son Phát Triển Qua 4 Thập Kỷ</h2>
      </div>

      <!-- Timeline Cards -->
      <div class="space-y-6 relative before:absolute before:inset-0 before:left-4 md:before:left-1/2 before:w-0.5 before:bg-slate-200 before:z-0">
        {milestones.map((m, idx) => (
          <div class={`relative z-10 flex flex-col md:flex-row items-start ${idx % 2 === 0 ? 'md:flex-row-reverse' : ''} gap-6`}>
            
            <!-- Content card -->
            <div class="w-full md:w-1/2 bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition">
              <div class="inline-block px-3 py-1 rounded-md bg-warmOrange-100 text-warmOrange-800 text-xs font-extrabold mb-2">
                {m.year}
              </div>
              <h3 class="text-base sm:text-lg font-bold text-navy-950 mb-2">{m.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{m.desc}</p>
            </div>

            <!-- Point icon on timeline line -->
            <div class="hidden md:flex w-8 h-8 rounded-full bg-navy-900 border-4 border-white text-warmOrange-400 items-center justify-center font-bold text-xs shadow shrink-0 self-center">
              {idx + 1}
            </div>

            <div class="hidden md:block w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Cơ sở vật chất & Đội ngũ Sư phạm -->
  <section class="py-16 bg-white border-t border-slate-200" id="co-so-vat-chat">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        
        <div class="space-y-5">
          <span class="text-warmOrange-600 font-bold text-xs uppercase tracking-wider">Chuẩn Mực Sư Phạm Hiện Đại</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Quy Mô Cơ Sở Vật Chất & Đội Ngũ Sư Phạm</h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Trường tọa lạc trên diện tích gần 2 hecta (19.509,7 m²) tại Số 261 Hùng Vương, Thị trấn Gia Ray, Huyện Xuân Lộc. Hệ thống cảnh quan xanh - sạch - đẹp đạt chuẩn Quốc gia mức độ 2.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start space-x-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-navy-900 text-warmOrange-400 flex items-center justify-center font-bold shrink-0 text-xs">42+</div>
              <div>
                <div class="font-bold text-xs text-navy-950">Phòng học lý thuyết kiên cố</div>
                <p class="text-[11px] text-slate-500">100% trang bị màn hình tương tác thông minh, TV màn hình lớn và cáp quang.</p>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold shrink-0 text-xs">LAB</div>
              <div>
                <div class="font-bold text-xs text-navy-950">Phòng thực hành bộ môn đạt chuẩn</div>
                <p class="text-[11px] text-slate-500">Vật lý, Hóa học, Sinh học và nhiều phòng lab Tin học máy tính đồng bộ.</p>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-warmOrange-600 text-white flex items-center justify-center font-bold shrink-0 text-xs">100+</div>
              <div>
                <div class="font-bold text-xs text-navy-950">Cán bộ, giáo viên & nhân viên tâm huyết</div>
                <p class="text-[11px] text-slate-500">100% đạt chuẩn và trên chuẩn Thạc sĩ; phong trào cựu học sinh quay về trường giảng dạy sôi nổi.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="grid grid-cols-2 gap-4">
            <img
              src="/assets/images/truong-xuan-loc.jpg"
              alt="Cổng trường THPT Xuân Lộc"
              class="rounded-2xl shadow-md object-cover h-48 w-full border border-slate-200"
            />
            <img
              src="/assets/images/phuong-vi-san-truong.jpg"
              alt="Sân trường phượng vĩ"
              class="rounded-2xl shadow-md object-cover h-48 w-full border border-slate-200 mt-6"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 3: Huân chương & Khen thưởng cấp Nhà nước -->
  <section class="py-16 bg-navy-950 text-white" id="khen-thuong">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-2 mb-10">
        <span class="text-warmOrange-400 font-bold text-xs uppercase tracking-wider">Vinh Quang Truyền Thống</span>
        <h2 class="text-2xl sm:text-3xl font-bold">Hệ Thống Khen Thưởng Cấp Nhà Nước & Chính Phủ</h2>
        <p class="text-slate-400 text-xs sm:text-sm max-w-2xl mx-auto">
          Chuỗi phần thưởng cao quý ghi nhận sự phấn đấu không ngừng nghỉ của thầy trò THPT Xuân Lộc qua 40 năm.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-navy-800 bg-navy-900/60 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-navy-900 text-warmOrange-300 font-bold uppercase tracking-wider text-[11px] border-b border-navy-800">
            <tr>
              <th class="py-3.5 px-4 sm:px-6">Năm</th>
              <th class="py-3.5 px-4 sm:px-6">Danh Hiệu / Khen Thưởng</th>
              <th class="py-3.5 px-4 sm:px-6">Ý Nghĩa & Cấp Trao Tặng</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-navy-800/60 text-slate-200">
            {honors.map((h) => (
              <tr class="hover:bg-navy-800/40 transition">
                <td class="py-3 px-4 sm:px-6 font-bold text-warmOrange-400 whitespace-nowrap">{h.year}</td>
                <td class="py-3 px-4 sm:px-6 font-semibold text-white">{h.title}</td>
                <td class="py-3 px-4 sm:px-6 text-slate-300 text-xs">{h.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section: Biên niên sử Quản trị & Phong cách Lãnh đạo qua các thời kỳ -->
  <section class="py-16 bg-white border-b border-slate-200" id="quan-tri-su-pham">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-2 max-w-3xl mx-auto">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-navy-100 text-navy-900 text-xs font-bold uppercase tracking-wider">
          <span>Biên Niên Sử Quản Trị Sư Phạm</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-950">
          Đội Ngũ Cán Bộ Quản Lý & Phong Cách Lãnh Đạo
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          4 thập kỷ xây dựng và trưởng thành, thành công của THPT Xuân Lộc gắn liền với năng lực định hướng chiến lược, tính tiếp nối xuyên suốt và văn hóa tôn trọng người dạy - trao quyền cho người học của tập thể Ban Giám hiệu.
        </p>
      </div>

      <!-- Dấu ấn các thế hệ Hiệu trưởng -->
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-navy-900 flex items-center space-x-2">
          <span class="w-2.5 h-6 bg-warmOrange-500 rounded-full inline-block"></span>
          <span>Dấu Ấn Các Thời Kỳ Ban Giám Hiệu (1985 – Nay)</span>
        </h3>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {principalsHistoryData.map((p) => (
            <div class="bg-slate-50 rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm flex flex-col justify-between hover:border-warmOrange-300 transition duration-200">
              <div>
                <div class="flex items-start justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-md bg-navy-900 text-warmOrange-300 text-[11px] font-bold">
                    {p.badge}
                  </span>
                  <span class="text-xs font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200">
                    {p.period}
                  </span>
                </div>

                <h4 class="text-lg font-bold text-navy-950">{p.name}</h4>
                <p class="text-xs font-semibold text-warmOrange-600 mb-3">{p.role}</p>

                <div class="space-y-2 text-xs text-slate-700 mb-4">
                  <p><strong class="text-slate-900">Phong cách lãnh đạo:</strong> {p.leadershipStyle}</p>
                  <p><strong class="text-slate-900">Bối cảnh lịch sử:</strong> {p.context}</p>
                  <p><strong class="text-slate-900">Trọng tâm:</strong> {p.keyFocus}</p>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-200/80">
                <span class="text-[11px] font-bold text-navy-900 uppercase tracking-wide block mb-1.5">Thành tựu cốt lõi:</span>
                <ul class="space-y-1 text-xs text-slate-600 list-disc list-inside">
                  {p.achievements.map((ach) => (
                    <li>{ach}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Đội ngũ Phó Hiệu trưởng & Cán bộ cốt cán -->
      <div class="bg-navy-950 text-white rounded-3xl p-8 sm:p-10 border border-navy-800">
        <h3 class="text-xl font-bold mb-6 text-warmOrange-400 flex items-center space-x-2">
          <span>👥</span>
          <span>Đội Ngũ Phó Hiệu Trưởng & Cán Bộ Cốt Cán Tiêu Biểu</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
          {vicePrincipalsNotable.map((v) => (
            <div class="bg-navy-900/80 rounded-2xl p-5 border border-navy-800 flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-warmOrange-300 text-sm mb-2">{v.era}</h4>
                <p class="text-white font-medium mb-3">{v.leaders}</p>
              </div>
              <p class="text-slate-400 text-xs leading-relaxed pt-3 border-t border-navy-800/80">{v.role}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bài học kinh nghiệm lãnh đạo -->
      <div class="bg-orange-50/50 rounded-3xl p-8 sm:p-10 border border-warmOrange-200">
        <h3 class="text-xl font-bold mb-6 text-navy-950 text-center">
          Bài Học Kinh Nghiệm Từ Mô Hình Quản Trị Sư Phạm Xuân Lộc
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {leadershipLessons.map((lesson) => (
            <div class="bg-white rounded-2xl p-6 border border-warmOrange-100 shadow-sm space-y-2">
              <div class="text-2xl">{lesson.icon}</div>
              <h4 class="font-bold text-navy-900 text-sm">{lesson.title}</h4>
              <p class="text-xs text-slate-600 leading-relaxed">{lesson.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Section 4: Cựu học sinh tiêu biểu & Tinh thần kế thừa -->
  <section class="py-16 bg-slate-50" id="cuu-hoc-sinh-tieu-bieu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center space-y-2">
        <span class="text-warmOrange-600 font-bold text-xs uppercase tracking-wider">Chắp Cánh Nhân Tài</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Gương Mặt Tiêu Biểu & Tinh Thần Gắn Kết</h2>
        <p class="text-slate-600 text-xs sm:text-sm max-w-2xl mx-auto">
          Hơn 20.000 cựu học sinh hiện là các tiến sĩ, bác sĩ, kỹ sư, nhà giáo, doanh nhân và cán bộ lãnh đạo đóng góp to lớn cho quê hương và đất nước.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-lg">🔬</div>
          <h3 class="font-bold text-navy-950 text-base">Nghiên Cứu & Học Thuật</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
