---
import BaseLayout from '../layouts/BaseLayout.astro';
import CrossLinkingNav from '../components/CrossLinkingNav.astro';
import { NOTABLE_ALUMNI } from '../data/notableAlumni';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter(
  (p) => p.data.category === 'Bảng vàng' || p.data.category === 'Gương sáng'
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categories = [
  { id: 'ALL', label: 'Tất cả lĩnh vực' },
  { id: 'MuiNhon', label: 'Đội Tuyển Quốc Gia & Thủ Khoa' },
  { id: 'HocThuat', label: 'Nghiên Cứu & Học Thuật' },
  { id: 'GiaoVien', label: 'Thầy Cô Cựu Học Sinh' },
  { id: 'ChinhTri', label: 'Quản Lý Nhà Nước & LLVT' },
  { id: 'DoanhNhan', label: 'Doanh Nhân & Khởi Nghiệp' },
  { id: 'NgheThuat', label: 'Văn Hóa & Nghệ Thuật' },
];
---

<BaseLayout
  title="Bảng Vàng Thành Tích & Gương Sáng Cựu Học Sinh - THPT Xuân Lộc"
  description="Tôn vinh các thế hệ học sinh tiêu biểu, thủ khoa, giải thưởng quốc gia, tiến sĩ, doanh nhân và những người con ưu tú của THPT Xuân Lộc."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_70%_at_50%_-10%,rgba(221,107,32,0.2),transparent)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Tự Hào 40 Năm Truyền Thống Xuân Lộc</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Bảng Vàng Thành Tích & Thế Hệ Tiêu Biểu
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base">
        Tôn vinh hành trình vẻ vang của các thế hệ học trò: từ giải thưởng Quốc gia, tiến sĩ học thuật đến các nhà quản lý, doanh nhân và người truyền lửa.
      </p>
    </div>
  </section>

  <!-- Key Achievement Stats (Updated 40-Year Overview) -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-3xl font-extrabold text-navy-900">Top 3 - 5</div>
          <div class="text-xs text-slate-500 mt-1">HSG Cấp Tỉnh trên ~90 trường THPT</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-3xl font-extrabold text-warmOrange-600">60 - 80</div>
          <div class="text-xs text-slate-500 mt-1">Giải HSG Cấp Tỉnh hàng năm</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-3xl font-extrabold text-indigo-600">Top 149</div>
          <div class="text-xs text-slate-500 mt-1">Trường ưu tiên tuyển thẳng ĐHQG TP.HCM</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-3xl font-extrabold text-emerald-600">99,5 - 100%</div>
          <div class="text-xs text-slate-500 mt-1">Tỷ lệ đậu tốt nghiệp THPT ổn định</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Danh Sách Các Gương Mặt Tiêu Biểu (Phân Loại Lĩnh Vực) -->
  <section class="py-14 bg-slate-50 border-b border-slate-200" id="guong-mat-tieu-bieu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-warmOrange-600 font-bold text-xs uppercase tracking-wider">Hành Trình Tỏa Sáng</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Gương Mặt Cựu Học Sinh & Học Sinh Mũi Nhọn</h2>
        </div>

        <!-- Filter Buttons -->
        <div class="flex items-center space-x-2 overflow-x-auto pb-1 scrollbar-none" id="alumni-category-filters">
          {categories.map((cat, idx) => (
            <button
              data-cat={cat.id}
              class={`notable-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${
                idx === 0
                  ? 'bg-navy-950 text-white shadow-sm'
                  : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'
              }`}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Grid of Notable Alumni Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="notable-alumni-grid">
        {NOTABLE_ALUMNI.map((alumni) => (
          <div
            class="notable-card bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group"
            data-category={alumni.category}
          >
            <div class="space-y-4">
              <!-- Category Badge & Icon -->
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md bg-warmOrange-50 text-warmOrange-700 text-xs font-bold border border-warmOrange-200 flex items-center space-x-1">
                  <span>{alumni.icon}</span>
                  <span>{alumni.categoryLabel}</span>
                </span>
                <span class="text-[11px] font-semibold text-slate-400 bg-slate-100 px-2 py-0.5 rounded">
                  {alumni.batch}
                </span>
              </div>

              <!-- Name & Title -->
              <div>
                <h3 class="text-base sm:text-lg font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors">
                  {alumni.name}
                </h3>
                <div class="text-xs font-semibold text-warmOrange-600 mt-0.5">{alumni.role}</div>
                <div class="text-[11px] text-slate-500 mt-0.5">{alumni.organization}</div>
              </div>

              <!-- Achievements -->
              <p class="text-xs text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-xl border border-slate-100">
                {alumni.achievements}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-[11px] text-emerald-600 font-medium flex items-center space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Vinh danh truyền thống</span>
              </span>
              <a href="/gioi-thieu#cuu-hoc-sinh-tieu-bieu" class="text-navy-900 hover:text-warmOrange-600 font-bold text-[11px]">
                Xem chi tiết →
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Section 2: Bài Viết & Sự Kiện Vinh Danh -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <span class="text-warmOrange-600 font-bold text-xs uppercase tracking-wider">Tin Bài Tiêu Biểu</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Câu Chuyện & Ký Sự Vinh Danh</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition flex flex-col group">
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold bg-navy-950/80 text-warmOrange-400 backdrop-blur-sm border border-navy-800">
                {post.data.category}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-400 block mb-2">
                  {post.data.pubDate.toLocaleDateString('vi-VN')}
                </time>
                <h3 class="text-lg font-bold text-navy-900 group-hover:text-warmOrange-600 transition mb-2">
                  <a href={`/tin-tuc/${post.slug}`}>{post.data.title}</a>
                </h3>
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-200/60 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">{post.data.author}</span>
                <a href={`/tin-tuc/${post.slug}`} class="font-bold text-warmOrange-600 hover:text-warmOrange-700">
                  Xem chi tiết &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross Linking Footer -->
  <CrossLinkingNav currentModule="bang-vang" />
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.notable-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.notable-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-navy-950', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-slate-600');
      });
      btn.classList.add('bg-navy-950', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-white', 'text-slate-600');

      const selectedCat = btn.dataset.cat || 'ALL';

      cards.forEach((card) => {
        const cardCat = card.dataset.category || '';
        if (selectedCat === 'ALL' || cardCat === selectedCat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
