---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const batches = (await getCollection('batches')).sort((a, b) => b.data.startYear - a.data.startYear);
const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPost = posts[0];
const subFeaturedPosts = posts.slice(1, 3);
const recentGridPosts = posts.slice(3, 7);
---

<BaseLayout
  title="Cổng Thông Tin Cựu Học Sinh Trường THPT Xuân Lộc"
  description="Cổng thông tin kết nối các thế hệ cựu học sinh Trường THPT Xuân Lộc (Đồng Nai) qua hơn 30 năm hình thành và phát triển. Tri ân thầy cô, lưu giữ ký ức học trò và quỹ học bổng tiếp sức tương lai."
>
  <!-- Redesigned Hero Section with Vibrant School Photo Background & Crisp Clarity -->
  <section class="relative bg-navy-950 text-white overflow-hidden py-16 sm:py-24 md:py-28 border-b border-navy-800">
    
    <!-- Background School Image with Balanced Lighting & Warm Ambience -->
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/images/truong-xuan-loc.webp"
        alt="Trường THPT Xuân Lộc"
        class="w-full h-full object-cover object-center filter brightness-[0.42] contrast-105"
      />
      <!-- Gradient Overlays for High Legibility & Warmth -->
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/70 to-navy-950/40"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_0%,rgba(245,158,11,0.25),transparent_80%)]"></div>
    </div>

    <!-- Hero Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white/10 text-amber-300 border border-amber-400/30 text-xs font-bold uppercase tracking-wider backdrop-blur-md shadow-lg">
          <span class="w-2 h-2 rounded-full bg-warmOrange-400 animate-ping"></span>
          <span>KẾT NỐI - ĐỒNG HÀNH - CHIA SẺ</span>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight drop-shadow-md">
          Cổng Thông Tin Cựu Học Sinh <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-200 to-warmOrange-400">
            Trường THPT Xuân Lộc
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-slate-200 leading-relaxed max-w-2xl mx-auto font-light drop-shadow">
          Nơi hội tụ, kết nối các thế hệ học trò và lưu giữ những kỷ niệm quý báu dưới mái trường THPT Xuân Lộc thân thương.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-4">
          <a
            href="/nien-khoa"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-xl shadow-warmOrange-500/30 transition transform hover:-translate-y-0.5 text-center"
          >
            Tra Cứu Niên Khóa Của Bạn
          </a>
          <a
            href="/tim-ban"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-sm text-slate-100 bg-white/10 hover:bg-white/20 border border-white/20 hover:text-white transition text-center backdrop-blur-md"
          >
            Tìm Bạn Cùng Lớp
          </a>
          <a
            href="/thay-co"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-medium text-xs text-amber-300 hover:text-white transition text-center underline decoration-amber-400/50 underline-offset-4"
          >
            Tri Ân Quý Thầy Cô →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Special 40th Anniversary Showcase (1985 - 2025) - Bright, Elegant & Consolidated -->
  <section class="py-14 sm:py-20 bg-gradient-to-b from-amber-50/60 via-white to-slate-50 relative overflow-hidden border-b border-slate-200/80">
    <!-- Ambient Warm Accents -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.12),transparent_70%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Title & Badge -->
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-amber-100/90 text-amber-900 border border-amber-300/80 text-xs sm:text-sm font-bold uppercase tracking-wider mb-4 shadow-sm">
          <span class="text-amber-600">✨</span>
          <span>DẤU ẤN BỐN THẬP KỶ • 1985 – 2025</span>
          <span class="text-amber-600">✨</span>
        </div>
        <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-navy-950 tracking-tight leading-tight">
          Hành Trình 40 Năm Vẻ Vang <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-warmOrange-600 via-amber-600 to-yellow-600">
            Trường THPT Xuân Lộc
          </span>
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-3 max-w-2xl mx-auto leading-relaxed">
          Từ mái trường cấp 4 đơn sơ bên sườn núi Chứa Chan năm 1985 đến biểu tượng giáo dục mũi nhọn, nơi chắp cánh cho hơn 20.000 thế hệ học sinh tỏa sáng muôn phương.
        </p>
      </div>

      <!-- MAIN FEATURED 40-YEAR SHOWCASE CARD (Clean, Light & Elevated) -->
      <div class="relative group rounded-3xl p-1 bg-gradient-to-r from-amber-400/40 via-warmOrange-400/40 to-amber-300/40 shadow-xl shadow-amber-500/10 mb-10 transition-all duration-300 hover:shadow-2xl hover:shadow-amber-500/15">
        <div class="bg-white rounded-[22px] p-6 sm:p-8 lg:p-10 border border-amber-100 relative overflow-hidden flex flex-col lg:flex-row items-center gap-8">
          
          <!-- Card Visual Side -->
          <div class="w-full lg:w-1/2 relative rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[16/9] lg:aspect-[4/3] bg-navy-950 shrink-0 shadow-md border border-slate-200">
            <img
              src="/assets/images/truong-xuan-loc.webp"
              alt="Toàn cảnh khuôn viên trường THPT Xuân Lộc 40 năm"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-navy-950/20 to-transparent"></div>
            
            <!-- Floating Milestone Badge on Image -->
            <div class="absolute top-3.5 left-3.5 sm:top-4 sm:left-4">
              <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-navy-950/90 backdrop-blur-md text-amber-300 border border-amber-400/50 shadow-md flex items-center space-x-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span>Kỷ Niệm 40 Năm (1985 - 2025)</span>
              </span>
            </div>

            <div class="absolute bottom-3.5 left-3.5 right-3.5 sm:bottom-4 sm:left-4 sm:right-4">
              <div class="text-xs sm:text-sm text-slate-100 font-medium bg-navy-950/85 backdrop-blur-md p-3 rounded-xl border border-white/10 flex items-center justify-between">
                <span class="flex items-center space-x-2">
                  <span>🏛️</span>
                  <span>Khuôn viên 19.509,7 m² Đạt Chuẩn QG Mức Độ 2</span>
                </span>
                <span class="text-amber-300 text-xs font-bold">Gia Ray, Đồng Nai</span>
              </div>
            </div>
          </div>

          <!-- Card Content Side with Consolidated Key Stats -->
          <div class="w-full lg:w-1/2 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-warmOrange-600">
                <span>⭐ Chuyên Trang Kỷ Niệm Trọng Thể</span>
                <span>•</span>
                <span>Tài Liệu Toàn Tập</span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-extrabold text-navy-950 leading-tight group-hover:text-warmOrange-600 transition-colors">
                Bốn Thập Kỷ Trồng Người, Vun Đắp Khát Vọng & Tự Hào
              </h3>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                Khám phá trọn vẹn tư liệu lịch sử 40 năm hình thành, biên niên sử các thời kỳ lãnh đạo Ban Giám hiệu, bảng vàng Huân chương Lao động cao quý cùng phóng sự về hơn 20.000 cựu học sinh trên khắp mọi miền đất nước.
              </p>

              <!-- Consolidated Quick Highlights (Integrated Statistics) -->
              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 group-hover:border-amber-200 transition">
                  <div class="text-xs text-slate-500 font-medium">Thành lập trường</div>
                  <div class="text-base sm:text-lg font-extrabold text-navy-950">23/12/1985</div>
                  <div class="text-[11px] text-slate-400">40 năm phát triển</div>
                </div>
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 group-hover:border-emerald-200 transition">
                  <div class="text-xs text-slate-500 font-medium">Khen thưởng cấp cao</div>
                  <div class="text-base sm:text-lg font-extrabold text-emerald-700">Huân Chương Hạng I</div>
                  <div class="text-[11px] text-emerald-600 font-medium">Chủ tịch nước trao tặng</div>
                </div>
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 group-hover:border-warmOrange-200 transition">
                  <div class="text-xs text-slate-500 font-medium">Học sinh tốt nghiệp</div>
                  <div class="text-base sm:text-lg font-extrabold text-warmOrange-600">20.000+ Học sinh</div>
                  <div class="text-[11px] text-slate-400">Tỏa sáng muôn phương</div>
                </div>
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 group-hover:border-indigo-200 transition">
                  <div class="text-xs text-slate-500 font-medium">Chất lượng đào tạo</div>
                  <div class="text-base sm:text-lg font-extrabold text-indigo-700">Top 149 ĐHQG</div>
                  <div class="text-[11px] text-indigo-600 font-medium">Ưu tiên xét tuyển TP.HCM</div>
                </div>
              </div>
            </div>

            <!-- Call to action button -->
            <div class="pt-2">
              <a
                href="/40-nam-thpt-xuan-loc"
                class="inline-flex items-center justify-center space-x-2.5 w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-sm sm:text-base text-white bg-gradient-to-r from-warmOrange-500 via-amber-500 to-warmOrange-600 hover:from-warmOrange-600 hover:to-amber-600 shadow-xl shadow-warmOrange-500/25 transition-all transform hover:-translate-y-0.5"
                id="btn-explore-40-years"
              >
                <span>Xem Toàn Tập Kỷ Niệm 40 Năm</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </div>

        </div>
      </div>

      <!-- 4 INTERACTIVE EXPLORATION CARDS (Bright, Modern Cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Card 1: Lịch Sử Mốc Son -->
        <a
          href="/40-nam-thpt-xuan-loc#lich-su"
          class="bg-white hover:bg-amber-50/40 rounded-2xl p-5 border border-slate-200 hover:border-amber-400/60 shadow-sm hover:shadow-md transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl mb-3.5 group-hover:scale-110 transition-transform">
              📜
            </div>
            <div class="text-[11px] font-bold text-amber-700 uppercase tracking-wider mb-1">Mốc Son Lịch Sử</div>
            <h4 class="text-base font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors mb-2">
              Các Giai Đoạn Phát Triển
            </h4>
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
              Từ trường PTTH Xuân Lộc II với 2 dãy phòng học cấp 4 năm 1985 đến cơ sở mới 2ha khang trang hiện đại.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-warmOrange-600 group-hover:text-warmOrange-700">
            <span>Xem mốc thời gian</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- Card 2: Bảng Vàng Khen Thưởng -->
        <a
          href="/40-nam-thpt-xuan-loc#khen-thuong"
          class="bg-white hover:bg-orange-50/40 rounded-2xl p-5 border border-slate-200 hover:border-warmOrange-400/60 shadow-sm hover:shadow-md transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-800 flex items-center justify-center text-xl mb-3.5 group-hover:scale-110 transition-transform">
              🎖️
            </div>
            <div class="text-[11px] font-bold text-warmOrange-700 uppercase tracking-wider mb-1">Vinh Quang Truyền Thống</div>
            <h4 class="text-base font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors mb-2">
              Khen Thưởng Cấp Nhà Nước
            </h4>
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
              Huân chương Lao động Hạng I, II, III; Bằng khen Thủ tướng Chính phủ và nhiều cờ thi đua xuất sắc.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-warmOrange-600 group-hover:text-warmOrange-700">
            <span>Xem bảng vàng</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- Card 3: Biên Niên Sử Lãnh Đạo -->
        <a
          href="/40-nam-thpt-xuan-loc#quan-tri-su-pham"
          class="bg-white hover:bg-indigo-50/40 rounded-2xl p-5 border border-slate-200 hover:border-indigo-300 shadow-sm hover:shadow-md transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-800 flex items-center justify-center text-xl mb-3.5 group-hover:scale-110 transition-transform">
              🏛️
            </div>
            <div class="text-[11px] font-bold text-indigo-700 uppercase tracking-wider mb-1">Quản Trị Sư Phạm</div>
            <h4 class="text-base font-bold text-navy-950 group-hover:text-indigo-600 transition-colors mb-2">
              Dấu Ấn Ban Giám Hiệu
            </h4>
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
              Biên niên sử quản lý và phong cách lãnh đạo tiếp nối qua các thế hệ Hiệu trưởng từ năm 1985 đến nay.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-indigo-600 group-hover:text-indigo-700">
            <span>Xem biên niên sử</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- Card 4: Cựu Học Sinh & Quỹ Học Bổng -->
        <a
          href="/40-nam-thpt-xuan-loc#cuu-hoc-sinh-tieu-bieu"
          class="bg-white hover:bg-emerald-50/40 rounded-2xl p-5 border border-slate-200 hover:border-emerald-300 shadow-sm hover:shadow-md transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl mb-3.5 group-hover:scale-110 transition-transform">
              🎓
            </div>
            <div class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider mb-1">Kế Thừa & Lan Tỏa</div>
            <h4 class="text-base font-bold text-navy-950 group-hover:text-emerald-600 transition-colors mb-2">
              20.000+ Thế Hệ Tỏa Sáng
            </h4>
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
              Gương mặt cựu học sinh tiêu biểu trong học thuật, doanh nghiệp, quản lý và quỹ học bổng tiếp sức.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-emerald-600 group-hover:text-emerald-700">
            <span>Xem gương mặt tiêu biểu</span>
            <span>&rarr;</span>
          </div>
        </a>

      </div>

    </div>
  </section>

  <!-- Featured Batches Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-warmOrange-600 mb-1">Dấu ấn thời gian</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900">Kỷ Yếu Các Niên Khóa</h2>
        </div>
        <a href="/nien-khoa" class="mt-4 md:mt-0 inline-flex items-center text-sm font-semibold text-warmOrange-600 hover:text-warmOrange-700">
          <span>Xem tất cả niên khóa</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {batches.slice(0, 3).map((batch) => (
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300 group">
            <div class="h-44 bg-navy-900 relative overflow-hidden flex items-center justify-center p-6 text-white text-center">
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950 to-transparent opacity-80 z-10"></div>
              <div class="relative z-20">
                <span class="inline-block px-3 py-1 rounded-full bg-warmOrange-500/80 text-white text-xs font-semibold uppercase tracking-wider mb-2">
                  {batch.data.startYear} - {batch.data.endYear}
                </span>
                <h3 class="text-xl font-bold text-white group-hover:text-warmOrange-300 transition-colors">
                  {batch.data.batchName}
                </h3>
              </div>
            </div>
            
            <div class="p-6 flex-1 flex flex-col justify-between">
              <p class="text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed">
                {batch.data.description}
              </p>
              
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500">{batch.data.studentCount || 0} học sinh</span>
                <a
                  href={`/nien-khoa/${batch.slug}`}
                  class="inline-flex items-center text-xs font-bold text-warmOrange-600 hover:text-warmOrange-700 group-hover:translate-x-0.5 transition-transform"
                >
                  Xem kỷ yếu &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest News & Announcements (Rich Magazine Layout) -->
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200 relative overflow-hidden">
    <!-- Subtle Background Accent -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.08),transparent_70%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-12">
        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/10 text-warmOrange-700 border border-warmOrange-500/20 text-xs font-bold uppercase tracking-wider mb-2">
            <span>📰 Dòng Thời Sự • Nhịp Cầu Kết Nối</span>
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-950 tracking-tight">
            Cộng Đồng & Bản Tin Xuân Lộc
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl">
            Cập nhật những hoạt động mới nhất của Đoàn trường, thông tin sự kiện nhà trường và nhịp sống cựu học sinh.
          </p>
        </div>
        <a
          href="/tin-tuc"
          class="mt-4 md:mt-0 inline-flex items-center px-4 py-2.5 rounded-xl text-sm font-bold text-warmOrange-700 bg-warmOrange-50 hover:bg-warmOrange-100 border border-warmOrange-200 shadow-sm transition-all group shrink-0"
        >
          <span>Xem tất cả bài viết</span>
          <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Top Row: 1 Big Featured Article (Left) + 2 Medium Side Articles (Right) -->
      {featuredPost && (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 mb-8">
          
          <!-- Main Highlight Post (7 Cols) -->
          <div class="lg:col-span-7">
            <article class="h-full bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col hover:shadow-xl transition-all duration-300 group">
              <a href={`/tin-tuc/${featuredPost.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-navy-950">
                <img
                  src={featuredPost.data.featuredImage || '/assets/images/truong-xuan-loc.webp'}
                  alt={featuredPost.data.title}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-warmOrange-500 text-white shadow-md">
                    {featuredPost.data.category || 'Tin tức'}
                  </span>
                </div>
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <div class="flex items-center space-x-3 text-xs text-slate-200">
                    <span>{featuredPost.data.author || 'Đoàn Trường THPT Xuân Lộc'}</span>
                    <span>•</span>
                    <time datetime={featuredPost.data.pubDate.toISOString()}>
                      {featuredPost.data.pubDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })}
                    </time>
                  </div>
                </div>
              </a>
              
              <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors leading-snug mb-3">
                    <a href={`/tin-tuc/${featuredPost.slug}`}>
                      {featuredPost.data.title}
                    </a>
                  </h3>
                  <p class="text-slate-600 text-sm sm:text-base line-clamp-3 leading-relaxed">
                    {featuredPost.data.description}
                  </p>
                </div>
                <div class="pt-5 mt-5 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs text-slate-400 font-medium">Bản tin tiêu điểm</span>
                  <a
                    href={`/tin-tuc/${featuredPost.slug}`}
                    class="inline-flex items-center text-sm font-bold text-warmOrange-600 hover:text-warmOrange-700 group-hover:translate-x-0.5 transition-transform"
                  >
                    Đọc toàn văn &rarr;
                  </a>
                </div>
              </div>
            </article>
          </div>

          <!-- 2 Sub-Featured Articles (5 Cols) -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            {subFeaturedPosts.map((post) => (
              <article class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col sm:flex-row lg:flex-row flex-1 hover:shadow-lg transition-all duration-300 group">
                <a href={`/tin-tuc/${post.slug}`} class="sm:w-44 lg:w-44 shrink-0 aspect-[4/3] sm:aspect-auto relative overflow-hidden bg-navy-950">
                  <img
                    src={post.data.featuredImage || '/assets/images/truong-xuan-loc.webp'}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute top-2.5 left-2.5">
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-navy-900/80 backdrop-blur-md text-warmOrange-300 border border-white/10">
                      {post.data.category || 'Tin tức'}
                    </span>
                  </div>
                </a>
                <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="text-[11px] text-slate-400 mb-1.5 font-medium">
                      {post.data.pubDate.toLocaleDateString('vi-VN')}
                    </div>
                    <h4 class="text-sm sm:text-base font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors line-clamp-2 leading-snug mb-2">
                      <a href={`/tin-tuc/${post.slug}`}>{post.data.title}</a>
                    </h4>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  </div>
                  <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                    <span class="text-slate-400 truncate max-w-[130px]">{post.data.author || 'THPT Xuân Lộc'}</span>
                    <a href={`/tin-tuc/${post.slug}`} class="font-bold text-warmOrange-600 hover:text-warmOrange-700">
                      Chi tiết &rarr;
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

        </div>
      )}

      <!-- Bottom Row: 4 Additional News Cards with Visual Thumbnails -->
      {recentGridPosts.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {recentGridPosts.map((post) => (
            <article class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 group">
              <a href={`/tin-tuc/${post.slug}`} class="block aspect-[16/10] relative overflow-hidden bg-navy-950">
                <img
                  src={post.data.featuredImage || '/assets/images/truong-xuan-loc.webp'}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-2.5 left-2.5">
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-navy-950/80 backdrop-blur-md text-warmOrange-300 border border-white/10">
                    {post.data.category || 'Tin tức'}
                  </span>
                </div>
              </a>
              <div class="p-4 flex-1 flex flex-col justify-between">
                <div>
                  <div class="text-[11px] text-slate-400 mb-1.5 font-medium">
                    {post.data.pubDate.toLocaleDateString('vi-VN')}
                  </div>
                  <h4 class="text-sm font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors line-clamp-2 leading-snug mb-1.5">
                    <a href={`/tin-tuc/${post.slug}`}>{post.data.title}</a>
                  </h4>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
                <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                  <span class="text-slate-400 truncate max-w-[100px]">{post.data.author || 'THPT Xuân Lộc'}</span>
                  <a href={`/tin-tuc/${post.slug}`} class="font-bold text-warmOrange-600 hover:text-warmOrange-700">
                    Xem &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- Quote & Tribute Banner -->
  <section class="py-16 bg-navy-950 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <svg class="w-10 h-10 text-warmOrange-500 mx-auto mb-4 opacity-70" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      <blockquote class="text-xl sm:text-2xl font-serif italic text-slate-200 leading-relaxed mb-6">
        "Thời gian trôi qua, mái ngói xưa có thể đổi thay, nhưng tình thầy nghĩa bạn và những ký ức dưới mái trường THPT Xuân Lộc sẽ luôn là hành trang quý giá nhất theo ta suốt cuộc đời."
      </blockquote>
      <div class="text-sm font-semibold text-warmOrange-400 uppercase tracking-widest">
        Ban Liên Lạc Cựu Học Sinh Trường THPT Xuân Lộc
      </div>
    </div>
  </section>
</BaseLayout>
