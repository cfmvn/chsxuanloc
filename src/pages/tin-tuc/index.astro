---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Tin Tức & Hoạt Động Cựu Học Sinh THPT Xuân Lộc"
  description="Cập nhật các thông tin mới nhất về họp khóa, sự kiện kỷ niệm, các hoạt động tri ân thầy cô và chương trình học bổng tiếp sức của Cựu học sinh THPT Xuân Lộc."
>
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-3">
        Tin Tức & Sự Kiện Cựu Học Sinh
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base">
        Kế hoạch họp khóa, chương trình tri ân thầy cô, gương cựu học sinh tiêu biểu và các hoạt động cộng đồng.
      </p>
    </div>
  </section>

  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group">
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-semibold bg-navy-950/80 text-warmOrange-300 backdrop-blur-sm border border-navy-800">
                {post.data.category}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-400 block mb-2">
                  {post.data.pubDate.toLocaleDateString('vi-VN')}
                </time>
                
                <h2 class="text-lg font-bold text-navy-900 group-hover:text-warmOrange-600 transition mb-2">
                  <a href={`/tin-tuc/${post.slug}`}>{post.data.title}</a>
                </h2>

                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span class="font-medium text-slate-700">{post.data.author}</span>
                <a
                  href={`/tin-tuc/${post.slug}`}
                  class="font-bold text-warmOrange-600 hover:text-warmOrange-700 inline-flex items-center"
                >
                  Chi tiết &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
