---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Danh sách các chuyên mục thực tế có trong bài viết
const rawCategories = Array.from(new Set(posts.map(p => p.data.category))).filter(Boolean);
const categories = ['Tất cả', ...rawCategories];

// Icon minh họa cho từng chuyên mục
const categoryIcons: Record<string, string> = {
  'Tất cả': '📰',
  'Tin tức': '📢',
  'Sự kiện': '🎪',
  'Gương sáng': '🌟',
  'Bảng vàng': '🏆',
  'Cựu học sinh': '🎓',
  'Họp khóa': '🤝',
  'Học bổng': '🎁',
  'Tri ân': '💐',
  'Lịch sử': '🏛️'
};
---

<BaseLayout
  title="Tin Tức & Hoạt Động Cựu Học Sinh THPT Xuân Lộc"
  description="Cập nhật các thông tin mới nhất về họp khóa, sự kiện kỷ niệm, các hoạt động tri ân thầy cô và chương trình học bổng tiếp sức của Cựu học sinh THPT Xuân Lộc."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:20px_20px] opacity-10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Bản Tin Cựu Học Sinh • Kết Nối & Lan Tỏa</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-3 tracking-tight">
        Tin Tức & Hoạt Động Cựu Học Sinh
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
        Không gian cập nhật những câu chuyện truyền cảm hứng, phong trào học đường, thông tin sự kiện và các nhịp cầu nghĩa tình của thầy trò THPT Xuân Lộc.
      </p>
    </div>
  </section>

  <!-- News Content Section with Modern Filter -->
  <section class="py-12 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- BỘ LỌC HIỆN ĐẠI (Search & Categories & Count) -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/90 shadow-sm space-y-5">
        
        <!-- Hàng 1: Ô tìm kiếm và Bộ chọn sắp xếp -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Ô tìm kiếm -->
          <div class="relative flex-1">
            <input
              type="text"
              id="news-search-input"
              placeholder="Tìm kiếm bài viết theo tiêu đề, tác giả hoặc từ khóa..."
              class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-navy-950 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-warmOrange-500 focus:ring-2 focus:ring-warmOrange-200 transition"
            />
            <span class="absolute left-3.5 top-3.5 text-slate-400 text-sm">🔍</span>
          </div>

          <!-- Trạng thái kết quả & Sắp xếp -->
          <div class="flex items-center justify-between sm:justify-end gap-3 text-xs font-semibold text-slate-600">
            <span id="news-counter" class="bg-navy-50 text-navy-900 px-3 py-2 rounded-xl border border-navy-100/80 font-bold whitespace-nowrap">
              Đang hiển thị {posts.length} bài viết
            </span>
          </div>
        </div>

        <!-- Hàng 2: Bộ lọc Chuyên mục dạng Chips / Tabs Hiện Đại -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none" id="news-category-filters">
          {categories.map((cat) => {
            const isAll = cat === 'Tất cả';
            const count = isAll ? posts.length : posts.filter(p => p.data.category === cat).length;
            const icon = categoryIcons[cat] || '🏷️';
            
            return (
              <button
                class={`category-chip-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-2 shrink-0 ${
                  isAll 
                    ? 'bg-navy-950 text-white shadow-sm border border-navy-900' 
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-transparent'
                }`}
                data-category={cat}
              >
                <span>{icon}</span>
                <span>{cat}</span>
                <span class={`text-[10px] px-2 py-0.5 rounded-full font-bold ${
                  isAll ? 'bg-navy-800 text-warmOrange-300' : 'bg-white text-slate-600 border border-slate-200'
                }`}>
                  {count}
                </span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Danh sách bài viết (Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="news-grid">
        {posts.map((post) => (
          <article
            class="news-post-card bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl hover:border-warmOrange-300 transition-all duration-300 flex flex-col group justify-between"
            data-slug={post.slug}
            data-category={post.data.category}
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description.toLowerCase()}
            data-author={post.data.author.toLowerCase()}
          >
            <div>
              <!-- Hình ảnh bài viết -->
              <div class="h-52 overflow-hidden bg-slate-100 relative">
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/assets/images/default-post.jpg';"
                />
                
                <!-- Category Badge -->
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[11px] font-bold bg-navy-950/85 text-warmOrange-300 backdrop-blur-md border border-navy-700 shadow-sm flex items-center gap-1.5">
                  <span>{categoryIcons[post.data.category] || '🏷️'}</span>
                  <span>{post.data.category}</span>
                </span>

                {post.data.featured && (
                  <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500 text-navy-950 shadow-sm">
                    ⭐ Tiêu điểm
                  </span>
                )}
              </div>

              <!-- Nội dung tóm tắt -->
              <div class="p-6">
                <div class="flex items-center space-x-2 text-xs text-slate-400 mb-2.5 font-medium flex-wrap gap-y-1">
                  <span class="inline-flex items-center gap-1">
                    <span>📅</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('vi-VN')}
                    </time>
                  </span>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1 text-slate-400">
                    <span>👁️</span>
                    <span class="news-card-views" data-slug={post.slug}>0</span>
                  </span>
                </div>
                
                <h2 class="text-base sm:text-lg font-bold text-navy-900 group-hover:text-warmOrange-600 transition leading-snug mb-2.5 line-clamp-2">
                  <a href={`/tin-tuc/${post.slug}`} class="focus:outline-none">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </div>

            <!-- Footer Card with Like, Share, Read -->
            <div class="px-5 py-3.5 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between text-xs gap-2">
              <span class="text-slate-500 font-medium truncate flex items-center gap-1 text-[11px]" title={`Nguồn: ${post.data.author || 'THPT Xuân Lộc'}`}>
                <span class="text-slate-400">✍️</span>
                <span class="truncate">{post.data.author || 'THPT Xuân Lộc'}</span>
              </span>

              <div class="flex items-center gap-1.5 shrink-0">
                <!-- Like Button on News Card -->
                <button
                  type="button"
                  class="news-card-like-btn px-2 py-1 rounded-lg text-[11px] font-bold border transition flex items-center gap-1 bg-white border-slate-200 text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200"
                  data-slug={post.slug}
                  title="Yêu thích bài viết"
                >
                  <span>❤️</span>
                  <span class="news-card-like-count" data-slug={post.slug}>0</span>
                </button>

                <!-- Share Button on News Card -->
                <button
                  type="button"
                  class="news-card-share-btn p-1 px-1.5 rounded-lg text-[11px] font-bold bg-white text-slate-600 border border-slate-200 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 transition"
                  data-slug={post.slug}
                  data-title={post.data.title}
                  title="Chia sẻ bài viết"
                >
                  <span>🔗</span>
                </button>

                <a
                  href={`/tin-tuc/${post.slug}`}
                  class="text-warmOrange-600 font-bold hover:text-warmOrange-700 inline-flex items-center gap-0.5 text-[11px] group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Đọc</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Loading More / Infinite Scroll Sentinel -->
      <div id="infinite-scroll-sentinel" class="py-8 text-center space-y-3">
        <div id="loading-more-spinner" class="hidden inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 shadow-sm">
          <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-warmOrange-500 border-t-transparent"></div>
          <span>Đang tải thêm bài viết...</span>
        </div>
        <button
          id="btn-load-more"
          class="hidden px-6 py-2.5 rounded-2xl bg-white border border-slate-300 hover:border-warmOrange-500 hover:text-warmOrange-600 text-slate-700 text-xs sm:text-sm font-bold shadow-xs transition"
        >
          <span>Xem thêm bài viết khác &darr;</span>
        </button>
      </div>

      <!-- Khung thông báo khi không tìm thấy bài viết -->
      <div id="no-news-found" class="hidden text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300 p-8 shadow-xs">
        <span class="text-4xl block mb-3">🔍</span>
        <h3 class="text-base font-bold text-navy-900 mb-1">Không tìm thấy bài viết phù hợp</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto mb-4">
          Thử thay đổi từ khóa tìm kiếm hoặc chọn chuyên mục "Tất cả" để xem danh sách bài viết.
        </p>
        <button
          id="reset-filter-btn"
          class="px-4 py-2 rounded-xl bg-navy-950 text-white text-xs font-bold hover:bg-warmOrange-600 transition shadow-sm cursor-pointer"
        >
          Đặt lại bộ lọc
        </button>
      </div>

    </div>
  </section>

  <!-- Cross Linking Navigation Footer -->
  <CrossLinkingNav currentModule="tin-tuc" />
</BaseLayout>

<script>
  import { db } from '../../lib/firebase';
  import { doc, getDoc, updateDoc, increment, collection, getDocs } from 'firebase/firestore';

  function setupNewsFilter() {
    const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.category-chip-btn');
    const cards = Array.from(document.querySelectorAll<HTMLDivElement>('.news-post-card'));
    const searchInput = document.getElementById('news-search-input') as HTMLInputElement | null;
    const counterEl = document.getElementById('news-counter');
    const noNewsEl = document.getElementById('no-news-found');
    const resetBtn = document.getElementById('reset-filter-btn');
    const sentinel = document.getElementById('infinite-scroll-sentinel');
    const spinner = document.getElementById('loading-more-spinner');
    const loadMoreBtn = document.getElementById('btn-load-more');

    let currentCategory = 'Tất cả';
    let searchQuery = '';
    
    // Pagination state
    const INITIAL_LIMIT = 9;
    const LOAD_STEP = 6;
    let visibleLimit = INITIAL_LIMIT;
    let matchingCards: HTMLDivElement[] = [];

    // Check URL parameters for q or category
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    const initialCat = urlParams.get('cat');

    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      searchQuery = initialQuery.trim().toLowerCase();
    }

    function renderVisibleCards() {
      // Ẩn tất cả cards trước
      cards.forEach(card => card.style.display = 'none');

      // Lấy danh sách card match filter
      matchingCards = cards.filter((card) => {
        const itemCategory = card.getAttribute('data-category') || '';
        const itemTitle = card.getAttribute('data-title') || '';
        const itemDesc = card.getAttribute('data-desc') || '';
        const itemAuthor = card.getAttribute('data-author') || '';

        const matchesCat = currentCategory === 'Tất cả' || itemCategory === currentCategory;
        const matchesSearch = !searchQuery || 
                              itemTitle.includes(searchQuery) || 
                              itemDesc.includes(searchQuery) || 
                              itemAuthor.includes(searchQuery);

        return matchesCat && matchesSearch;
      });

      const totalMatches = matchingCards.length;
      const displayed = matchingCards.slice(0, visibleLimit);

      displayed.forEach(card => {
        card.style.display = '';
      });

      // Update counter
      if (counterEl) {
        counterEl.textContent = `Đang hiển thị ${displayed.length}/${totalMatches} bài viết`;
      }

      // No results box
      if (noNewsEl) {
        noNewsEl.style.display = totalMatches === 0 ? 'block' : 'none';
      }

      // Load more button / sentinel visibility
      if (displayed.length < totalMatches) {
        if (loadMoreBtn) loadMoreBtn.classList.remove('hidden');
        if (sentinel) sentinel.style.display = 'block';
      } else {
        if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
        if (spinner) spinner.classList.add('hidden');
        if (sentinel) sentinel.style.display = 'none';
      }
    }

    function loadMore() {
      if (visibleLimit >= matchingCards.length) return;
      if (spinner) spinner.classList.remove('hidden');
      if (loadMoreBtn) loadMoreBtn.classList.add('hidden');

      setTimeout(() => {
        visibleLimit += LOAD_STEP;
        renderVisibleCards();
        if (spinner) spinner.classList.add('hidden');
      }, 250);
    }

    // Manual load more click
    loadMoreBtn?.addEventListener('click', loadMore);

    // Automatic Infinite Scroll using IntersectionObserver
    if ('IntersectionObserver' in window && sentinel) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          if (visibleLimit < matchingCards.length) {
            loadMore();
          }
        }
      }, {
        rootMargin: '250px',
        threshold: 0.1,
      });

      observer.observe(sentinel);
    }

    // Category click handler
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'Tất cả';
        visibleLimit = INITIAL_LIMIT; // Reset limit khi đổi category

        categoryButtons.forEach((b) => {
          b.classList.remove('bg-navy-950', 'text-white', 'shadow-sm', 'border-navy-900');
          b.classList.add('bg-slate-100', 'text-slate-700', 'border-transparent');
          const badge = b.querySelector('span:last-child');
          if (badge) {
            badge.className = 'text-[10px] px-2 py-0.5 rounded-full font-bold bg-white text-slate-600 border border-slate-200';
          }
        });

        btn.classList.remove('bg-slate-100', 'text-slate-700', 'border-transparent');
        btn.classList.add('bg-navy-950', 'text-white', 'shadow-sm', 'border-navy-900');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.className = 'text-[10px] px-2 py-0.5 rounded-full font-bold bg-navy-800 text-warmOrange-300';
        }

        renderVisibleCards();
      });
    });

    if (initialCat) {
      const matchBtn = Array.from(categoryButtons).find(b => b.getAttribute('data-category') === initialCat);
      if (matchBtn) {
        matchBtn.click();
      }
    }

    // Search input handler
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        visibleLimit = INITIAL_LIMIT; // Reset limit khi search
        renderVisibleCards();
      });
    }

    // Reset button
    if (resetBtn && categoryButtons.length > 0) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        visibleLimit = INITIAL_LIMIT;
        categoryButtons[0].click();
      });
    }

    renderVisibleCards();
    loadAllNewsStats();
    setupCardActions();
  }

  // LocalStorage Like state
  function getLikedNews(): string[] {
    try {
      return JSON.parse(localStorage.getItem('chs_liked_news') || '[]');
    } catch {
      return [];
    }
  }

  function setLikedNews(slug: string) {
    const liked = getLikedNews();
    if (!liked.includes(slug)) {
      liked.push(slug);
      localStorage.setItem('chs_liked_news', JSON.stringify(liked));
    }
  }

  // Load news stats for cards
  async function loadAllNewsStats() {
    try {
      const snapshot = await getDocs(collection(db, 'news_stats'));
      const likedList = getLikedNews();

      snapshot.forEach((docSnap) => {
        const slug = docSnap.id;
        const data = docSnap.data();

        // Update Views
        const viewsSpans = document.querySelectorAll<HTMLSpanElement>(`.news-card-views[data-slug="${slug}"]`);
        viewsSpans.forEach(s => s.textContent = String(data.viewsCount || 0));

        // Update Likes
        const likeSpans = document.querySelectorAll<HTMLSpanElement>(`.news-card-like-count[data-slug="${slug}"]`);
        likeSpans.forEach(s => s.textContent = String(data.likesCount || 0));

        // Update Like Button style if liked
        if (likedList.includes(slug)) {
          const likeBtns = document.querySelectorAll<HTMLButtonElement>(`.news-card-like-btn[data-slug="${slug}"]`);
          likeBtns.forEach(btn => {
            btn.classList.add('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
          });
        }
      });
    } catch (err) {
      console.warn('Lỗi tải thống kê tin tức:', err);
    }
  }

  // Setup Like & Share on News Cards
  function setupCardActions() {
    // Like button click
    document.querySelectorAll<HTMLButtonElement>('.news-card-like-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        if (!slug) return;

        const liked = getLikedNews();
        const isLiked = liked.includes(slug);
        const statsRef = doc(db, 'news_stats', slug);

        const countSpan = btn.querySelector('.news-card-like-count');
        let currentCount = countSpan ? parseInt(countSpan.textContent || '0', 10) : 0;

        try {
          if (!isLiked) {
            setLikedNews(slug);
            currentCount++;
            if (countSpan) countSpan.textContent = String(currentCount);
            btn.classList.add('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
            await updateDoc(statsRef, { likesCount: increment(1) });
          } else {
            const filtered = liked.filter(id => id !== slug);
            localStorage.setItem('chs_liked_news', JSON.stringify(filtered));
            currentCount = Math.max(0, currentCount - 1);
            if (countSpan) countSpan.textContent = String(currentCount);
            btn.classList.remove('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
            await updateDoc(statsRef, { likesCount: increment(-1) });
          }
        } catch (err) {
          console.error(err);
        }
      });
    });

    // Share button click
    document.querySelectorAll<HTMLButtonElement>('.news-card-share-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title') || 'Tin tức THPT Xuân Lộc';
        const shareUrl = `${window.location.origin}/tin-tuc/${slug}`;

        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              text: `Đọc tin tức "${title}" trên Cổng thông tin THPT Xuân Lộc!`,
              url: shareUrl,
            });
            return;
          } catch {
            // ignore
          }
        }

        try {
          await navigator.clipboard.writeText(shareUrl);
          alert('Đã sao chép liên kết bài viết vào bộ nhớ tạm!');
        } catch {
          prompt('Sao chép liên kết bài viết:', shareUrl);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupNewsFilter);
</script>
