---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

const { post, allPosts: rawAllPosts } = Astro.props;
const allPosts = (rawAllPosts || await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const { Content } = await post.render();

// Lấy danh sách tin liên quan (ưu tiên cùng chuyên mục, trừ bài hiện tại)
const sameCategoryPosts = allPosts.filter(p => p.slug !== post.slug && p.data.category === post.data.category);
const otherPosts = allPosts.filter(p => p.slug !== post.slug && p.data.category !== post.data.category);
const relatedPosts = [...sameCategoryPosts, ...otherPosts].slice(0, 3);

// Danh sách chuyên mục và số lượng bài
const rawCategories = Array.from(new Set(allPosts.map(p => p.data.category))).filter(Boolean);
const categories = ['Tất cả', ...rawCategories];

const categoryIcons: Record<string, string> = {
  'Tất cả': '📰',
  'Tin tức': '📢',
  'Sự kiện': '🎪',
  'Gương sáng': '🌟',
  'Bảng vàng': '🏆',
  'Cựu học sinh': '🎓',
  'Họp khóa': '🤝',
  'Học bổng': '🎁',
  'Tri ân': '💐',
  'Lịch sử': '🏛️'
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  author={post.data.author}
  image={post.data.featuredImage}
>
  <!-- Hero / Header của bài viết -->
  <section class="bg-navy-950 text-white py-12 md:py-16 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="mb-5 flex items-center justify-between flex-wrap gap-3">
        <a href="/tin-tuc" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-warmOrange-400 hover:text-warmOrange-300 transition">
          <span>&larr;</span>
          <span>Tất cả tin tức & hoạt động</span>
        </a>
        <span class="text-xs text-slate-400">Cổng Thông Tin Cựu Học Sinh THPT Xuân Lộc</span>
      </div>

      <div class="flex items-center space-x-3 mb-4 text-xs">
        <span class="px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 font-bold flex items-center gap-1.5">
          <span>{categoryIcons[post.data.category] || '🏷️'}</span>
          <span>{post.data.category}</span>
        </span>
        <time datetime={post.data.pubDate.toISOString()} class="text-slate-300 font-medium">
          📅 {post.data.pubDate.toLocaleDateString('vi-VN')}
        </time>
        <span class="text-slate-400 hidden sm:inline">• Đăng bởi {post.data.author}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight tracking-tight">
        {post.data.title}
      </h1>
    </div>
  </section>

  <!-- Khung tìm kiếm & Bộ lọc nhanh chuyên mục -->
  <section class="bg-white border-b border-slate-200 py-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        <!-- Search bar chuyển hướng sang /tin-tuc -->
        <form action="/tin-tuc" method="GET" class="relative flex-1">
          <input
            type="text"
            name="q"
            id="detail-search-input"
            placeholder="Tìm kiếm tin tức, hoạt động trường, cựu học sinh..."
            class="w-full pl-10 pr-24 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-navy-950 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-warmOrange-500 focus:ring-2 focus:ring-warmOrange-200 transition"
          />
          <span class="absolute left-3.5 top-3 text-slate-400 text-sm">🔍</span>
          <button
            type="submit"
            class="absolute right-1.5 top-1.5 bottom-1.5 px-3 rounded-xl bg-navy-950 text-white text-xs font-bold hover:bg-warmOrange-600 transition"
          >
            Tìm kiếm
          </button>
        </form>

        <!-- Category list pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
          {categories.map((cat) => (
            <a
              href={cat === 'Tất cả' ? '/tin-tuc' : `/tin-tuc?cat=${encodeURIComponent(cat)}`}
              class={`px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition flex items-center gap-1 ${
                cat === post.data.category
                  ? 'bg-warmOrange-50 text-warmOrange-700 border border-warmOrange-300 font-bold'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
            >
              <span>{categoryIcons[cat] || '🏷️'}</span>
              <span>{cat}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Chi tiết bài viết -->
  <article class="py-10 sm:py-14 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden p-6 sm:p-10 md:p-12">
        
        {post.data.featuredImage && (
          <div class="mb-8 rounded-2xl overflow-hidden shadow-md max-h-[460px] bg-slate-100">
            <img
              src={post.data.featuredImage}
              alt={post.data.title}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <p class="lead font-medium text-slate-700 text-base sm:text-lg italic border-l-4 border-warmOrange-500 pl-4 py-1 my-6 bg-amber-50/40 rounded-r-xl">
          {post.data.description}
        </p>

        <div class="prose prose-school max-w-none text-slate-800 leading-relaxed text-sm sm:text-base space-y-4">
          <Content />
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-slate-200 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Từ khóa:</span>
            {post.data.tags.map((tag) => (
              <a
                href={`/tin-tuc?q=${encodeURIComponent(tag)}`}
                class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium hover:bg-warmOrange-50 hover:text-warmOrange-700 transition"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </article>

  <!-- Khối Tin Tức Liên Quan -->
  {relatedPosts.length > 0 && (
    <section class="py-12 bg-white border-t border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold text-warmOrange-600 uppercase tracking-wider mb-1">
              <span>📰 Tin Cùng Chuyên Mục & Hoạt Động Mới</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-navy-950">
              Bài Viết Liên Quan Khác
            </h2>
          </div>
          <a
            href="/tin-tuc"
            class="text-xs sm:text-sm font-bold text-warmOrange-600 hover:text-warmOrange-700 inline-flex items-center gap-1 group"
          >
            <span>Xem tất cả tin tức</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((item) => (
            <article class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-lg hover:border-warmOrange-300 transition-all duration-300 flex flex-col group justify-between">
              <div>
                <div class="h-44 overflow-hidden bg-slate-100 relative">
                  <img
                    src={item.data.featuredImage}
                    alt={item.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-navy-950/85 text-warmOrange-300 backdrop-blur-sm border border-navy-700">
                    {categoryIcons[item.data.category] || '🏷️'} {item.data.category}
                  </span>
                </div>

                <div class="p-4 sm:p-5">
                  <div class="flex items-center space-x-2 text-[11px] text-slate-400 mb-2">
                    <time datetime={item.data.pubDate.toISOString()}>
                      {item.data.pubDate.toLocaleDateString('vi-VN')}
                    </time>
                    <span>•</span>
                    <span class="truncate">{item.data.author}</span>
                  </div>

                  <h3 class="text-sm sm:text-base font-bold text-navy-950 group-hover:text-warmOrange-600 transition leading-snug line-clamp-2 mb-2">
                    <a href={`/tin-tuc/${item.slug}`}>
                      {item.data.title}
                    </a>
                  </h3>

                  <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                    {item.data.description}
                  </p>
                </div>
              </div>

              <div class="px-5 py-3 bg-white border-t border-slate-150 flex items-center justify-between text-xs">
                <span class="text-slate-400 text-[11px]">THPT Xuân Lộc</span>
                <a
                  href={`/tin-tuc/${item.slug}`}
                  class="font-bold text-warmOrange-600 hover:text-warmOrange-700 inline-flex items-center gap-1 text-[11px] group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Đọc tiếp</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CrossLinkingNav currentModule="tin-tuc" />
</BaseLayout>

