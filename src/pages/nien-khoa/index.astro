---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubmissionForm from '../../components/SubmissionForm.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { getCollection } from 'astro:content';

const batches = (await getCollection('batches')).sort((a, b) => b.data.startYear - a.data.startYear);
---

<BaseLayout
  title="Kỷ Yếu Niên Khóa Cựu Học Sinh THPT Xuân Lộc"
  description="Danh sách kỷ yếu các niên khóa từ năm 1990 đến nay của Trường THPT Xuân Lộc (Đồng Nai). Tìm lại bạn bè, thầy cô và cùng chia sẻ kỷ niệm thanh xuân."
>
  <!-- Header -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-3">
        Kỷ Yếu Các Niên Khóa (1990 - Nay)
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base">
        Nơi lưu giữ hành trình 30+ năm của các thế hệ học trò dưới mái trường THPT Xuân Lộc. Hãy chọn niên khóa của bạn để xem kỷ yếu và chia sẻ ký ức.
      </p>
    </div>
  </section>

  <!-- Batches Grid -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {batches.map((batch) => (
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group">
            <div class="p-6 bg-gradient-to-br from-navy-900 to-navy-950 text-white relative">
              <span class="inline-block px-3 py-1 rounded-full bg-warmOrange-500 text-white text-xs font-bold uppercase tracking-wider mb-2">
                Niên Khóa {batch.data.startYear} - {batch.data.endYear}
              </span>
              <h2 class="text-xl font-bold text-white group-hover:text-warmOrange-400 transition-colors">
                <a href={`/nien-khoa/${batch.slug}`}>{batch.data.title}</a>
              </h2>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-sm text-slate-600 mb-4 leading-relaxed line-clamp-3">
                  {batch.data.description}
                </p>

                {batch.data.motto && (
                  <div class="mb-4 p-3 rounded-lg bg-warmOrange-50 text-warmOrange-900 text-xs italic font-medium border border-warmOrange-200">
                    "{batch.data.motto}"
                  </div>
                )}

                {batch.data.classes && batch.data.classes.length > 0 && (
                  <div class="mb-4">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1.5">Các lớp:</span>
                    <div class="flex flex-wrap gap-1.5">
                      {batch.data.classes.map((cls) => (
                        <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-medium">
                          {cls}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">
                  {batch.data.studentCount ? `${batch.data.studentCount} học sinh` : 'Cựu học sinh'}
                </span>
                <a
                  href={`/nien-khoa/${batch.slug}`}
                  class="px-4 py-2 rounded-lg text-xs font-bold text-white bg-navy-900 hover:bg-warmOrange-600 transition"
                >
                  Xem Chi Tiết &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Submit form section -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SubmissionForm />
    </div>
  </section>

  <!-- Cross Linking Footer -->
  <CrossLinkingNav currentModule="nien-khoa" />
</BaseLayout>
