---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubmissionForm from '../../components/SubmissionForm.astro';
import ApprovedList from '../../components/ApprovedList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const batches = await getCollection('batches');
  return batches.map((batch) => ({
    params: { slug: batch.slug },
    props: { batch },
  }));
}

interface Props {
  batch: CollectionEntry<'batches'>;
}

const { batch } = Astro.props;
const { Content } = await batch.render();
---

<BaseLayout
  title={`Kỷ Yếu ${batch.data.batchName} - THPT Xuân Lộc`}
  description={batch.data.description}
  image={batch.data.featuredImage}
>
  <!-- Hero / Header -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href="/nien-khoa" class="inline-flex items-center text-xs font-semibold text-warmOrange-400 hover:text-warmOrange-300">
          &larr; Quay lại danh sách niên khóa
        </a>
      </div>
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        Niên Khóa {batch.data.startYear} - {batch.data.endYear}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        {batch.data.title}
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        {batch.data.description}
      </p>

      {batch.data.motto && (
        <div class="mt-6 inline-block p-4 rounded-xl bg-navy-900/90 border border-navy-700 text-warmOrange-300 text-sm font-medium italic">
          Khẩu hiệu niên khóa: "{batch.data.motto}"
        </div>
      )}
    </div>
  </section>

  <!-- Main Content & Details -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Key Information Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Classes -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center space-x-2 text-warmOrange-600 font-bold text-sm mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Danh Sách Lớp ({batch.data.classes?.length || 0})</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {batch.data.classes?.map((cls) => (
              <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-800 text-xs font-semibold">
                {cls}
              </span>
            ))}
          </div>
        </div>

        <!-- Teachers -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center space-x-2 text-warmOrange-600 font-bold text-sm mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span>Thầy Cô Dạy Khóa Này</span>
          </div>
          <ul class="space-y-1.5 text-xs text-slate-700">
            {batch.data.teachers?.map((teacher) => (
              <li class="flex items-center space-x-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-warmOrange-500"></span>
                <span>{teacher}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Representative -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center space-x-2 text-warmOrange-600 font-bold text-sm mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Ban Đại Diện Khóa</span>
          </div>
          {batch.data.representative ? (
            <div class="text-xs text-slate-700 space-y-1">
              <p class="font-bold text-navy-900 text-sm">{batch.data.representative.name}</p>
              <p class="text-slate-500">{batch.data.representative.role}</p>
              {batch.data.representative.contact && (
                <p class="text-warmOrange-600 font-medium">{batch.data.representative.contact}</p>
              )}
            </div>
          ) : (
            <p class="text-xs text-slate-400">Đang cập nhật ban đại diện</p>
          )}
        </div>
      </div>

      <!-- Markdown Article Content -->
      <article class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-10 prose prose-school max-w-none">
        <Content />
      </article>

      <!-- Dynamic Approved Submissions from Firestore -->
      <ApprovedList batchSlug={batch.slug} />

      <!-- Interactive Submission Form -->
      <SubmissionForm batchSlug={batch.slug} batchTitle={batch.data.batchName} />

    </div>
  </section>
</BaseLayout>
