---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubmissionForm from '../../components/SubmissionForm.astro';
import ApprovedList from '../../components/ApprovedList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const batches = await getCollection('batches');
  return batches.map((batch) => ({
    params: { slug: batch.slug },
    props: { batch },
  }));
}

interface Props {
  batch: CollectionEntry<'batches'>;
}

const { batch } = Astro.props;
const { Content } = await batch.render();
---

<BaseLayout
  title={`Kỷ Yếu ${batch.data.batchName} - THPT Xuân Lộc`}
  description={batch.data.description}
  image={batch.data.featuredImage}
>
  <!-- Hero / Header -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href="/nien-khoa" class="inline-flex items-center text-xs font-semibold text-warmOrange-400 hover:text-warmOrange-300">
          &larr; Quay lại danh sách niên khóa
        </a>
      </div>
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        Niên Khóa {batch.data.startYear} - {batch.data.endYear}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        {batch.data.title}
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        {batch.data.description}
      </p>

      {batch.data.motto && (
        <div class="mt-6 inline-block p-4 rounded-xl bg-navy-900/90 border border-navy-700 text-warmOrange-300 text-sm font-medium italic">
          Khẩu hiệu niên khóa: "{batch.data.motto}"
        </div>
      )}
    </div>
  </section>

  <!-- Main Content & Details -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Key Information Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Classes -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center space-x-2 text-warmOrange-600 font-bold text-sm mb-3">
            <span>🏫</span>
            <span>Danh Sách Lớp ({batch.data.classes?.length || 0})</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {batch.data.classes?.map((cls) => (
              <a
                href={`/tim-ban?year=${batch.data.endYear}&class=${cls}`}
                class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-warmOrange-100 hover:text-warmOrange-900 text-slate-800 text-xs font-semibold transition"
                title={`Xem danh sách lớp ${cls}`}
              >
                Lớp {cls}
              </a>
            ))}
          </div>
        </div>

        <!-- Student count & status -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center space-x-2 text-warmOrange-600 font-bold text-sm mb-3">
            <span>👥</span>
            <span>Quy Mô Niên Khóa</span>
          </div>
          <div class="space-y-2 text-xs text-slate-700">
            <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
              <span class="text-slate-500">Tổng cựu học sinh:</span>
              <strong class="text-warmOrange-600 font-extrabold text-sm">{batch.data.studentCount} bạn</strong>
            </div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
              <span class="text-slate-500">Năm tốt nghiệp:</span>
              <strong class="text-navy-950 font-bold">{batch.data.endYear}</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-500">Trạng thái hồ sơ:</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">100% Hồ sơ gốc</span>
            </div>
          </div>
        </div>

        <!-- Direct Alumni Search Action -->
        <div class="bg-gradient-to-br from-navy-900 to-navy-950 p-6 rounded-2xl text-white shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center space-x-2 text-warmOrange-400 font-bold text-sm mb-2">
              <span>🔍</span>
              <span>Tra Cứu Bạn Cùng Khóa</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Xem toàn bộ danh sách {batch.data.studentCount} bạn học của {batch.data.batchName} có ngày sinh, nơi sinh và lớp học.
            </p>
          </div>
          <a
            href={`/tim-ban?year=${batch.data.endYear}`}
            class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-center text-white bg-gradient-to-r from-warmOrange-500 to-amber-500 hover:from-warmOrange-600 hover:to-amber-600 transition shadow-md shadow-warmOrange-500/20 block"
          >
            Mở Danh Bạ Khóa {batch.data.endYear} &rarr;
          </a>
        </div>
      </div>

      <!-- Markdown Article Content -->
      <article class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-10 prose prose-school max-w-none">
        <Content />
      </article>

      <!-- Dynamic Approved Submissions from Firestore -->
      <ApprovedList batchSlug={batch.slug} />

      <!-- Interactive Submission Form -->
      <SubmissionForm batchSlug={batch.slug} batchTitle={batch.data.batchName} />

    </div>
  </section>
</BaseLayout>
