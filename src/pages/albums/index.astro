---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';

// Phân loại danh mục thông minh cho từng album
const enrichedAlbums = albumsData.map((album) => {
  const t = (album.title || '').toLowerCase();
  let cat = 'truong-xua';
  let catLabel = 'Trường Xưa';
  let catIcon = '🏛️';

  if (t.includes('khai giảng') || t.includes('tổng kết') || t.includes('sơ kết') || t.includes('chuẩn quốc gia') || t.includes('nhà trường')) {
    cat = 'nha-truong';
    catLabel = 'Nhà Trường';
    catIcon = '🏫';
  } else if (t.includes('20-11') || t.includes('20/11') || t.includes('nhà giáo') || t.includes('thầy cô') || t.includes('tri ân') || t.includes('giao ước')) {
    cat = 'tri-an';
    catLabel = 'Tri Ân';
    catIcon = '💐';
  } else if (t.includes('nguồn') || t.includes('núi') || t.includes('chứa chan') || t.includes('dã ngoại') || t.includes('hội trại') || t.includes('tham quan') || t.includes('bóng đá') || t.includes('thể thao') || t.includes('phù đổng') || t.includes('đoàn trường')) {
    cat = 'hoat-dong';
    catLabel = 'Hoạt Động';
    catIcon = '🏕️';
  } else if (t.includes('kỷ yếu') || t.includes('lưu bút') || t.includes('họp lớp') || t.includes('khóa') || t.includes('niên khóa') || t.includes('lớp')) {
    cat = 'ky-yeu';
    catLabel = 'Kỷ Yếu';
    catIcon = '📖';
  } else if (t.includes('lịch sử') || t.includes('xưa') || t.includes('tư liệu') || t.includes('thập niên')) {
    cat = 'truong-xua';
    catLabel = 'Trường Xưa';
    catIcon = '🏛️';
  } else {
    cat = 'khac';
    catLabel = 'Khác';
    catIcon = '✨';
  }

  return {
    ...album,
    category: cat,
    categoryLabel: catLabel,
    categoryIcon: catIcon,
    senderName: album.senderName || 'CHS Xuân Lộc',
    createdAtFormatted: album.createdAtFormatted || '01/01/2026'
  };
});
---

<BaseLayout
  title="Thư Viện Album Ảnh Kỷ Niệm - Trường THPT Xuân Lộc"
  description="Toàn bộ kho tư liệu hình ảnh kỷ niệm, đại lễ, cựu học sinh, hội trại, leo núi Chứa Chan và các thời kỳ phát triển của Trường THPT Xuân Lộc."
>
  <!-- Hero Section với hiệu ứng Glassmorphism & Gradient hiện đại -->
  <section class="relative bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white pt-14 pb-16 sm:pt-20 sm:pb-24 border-b border-navy-800/80 overflow-hidden">
    <!-- Hiệu ứng Glow nền mờ nghệ thuật -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-warmOrange-500/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-20 w-[400px] h-[300px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute top-1/2 -left-20 w-[400px] h-[300px] bg-sky-500/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-5">
      <!-- Tag Ký Ức -->
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-warmOrange-400 text-xs font-semibold uppercase tracking-wider backdrop-blur-md shadow-inner">
        <span class="w-2 h-2 rounded-full bg-warmOrange-400 animate-ping"></span>
        <span>Kho Lưu Trữ Ký Ức THPT Xuân Lộc</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight font-serif leading-tight">
        Thư Viện Album Ảnh <span class="text-transparent bg-clip-text bg-gradient-to-r from-warmOrange-400 via-amber-300 to-warmOrange-500">Kỷ Niệm</span>
      </h1>

      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed font-light">
        Nơi hội tụ hơn 23+ album tư liệu quý giá, những khoảnh khắc thanh xuân tươi đẹp, hoạt động dã ngoại và các thế hệ thầy cô, học sinh dưới mái trường THPT Xuân Lộc.
      </p>

      <!-- Thanh Tìm kiếm & Nút Đóng Góp Hiện Đại -->
      <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-2xl mx-auto">
        <!-- Ô Tìm Kiếm Real-time -->
        <div class="relative w-full sm:flex-1 group">
          <input
            type="text"
            id="album-search"
            placeholder="Tìm theo tên album, năm, sự kiện (VD: Nhà trường, Tri ân, Núi Chứa Chan...)"
            class="w-full px-4 py-3.5 pl-11 rounded-2xl bg-white/10 border border-white/15 text-white placeholder-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-warmOrange-400 focus:bg-navy-900/90 shadow-2xl backdrop-blur-md transition-all duration-300"
          />
          <svg class="w-4 h-4 text-slate-400 group-focus-within:text-warmOrange-400 absolute left-4 top-4 pointer-events-none transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button id="btn-clear-search" class="hidden absolute right-3.5 top-3.5 p-1 rounded-full text-slate-400 hover:text-white hover:bg-white/10 transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Nút Gửi Album Mới -->
        <button
          id="btn-open-submit-album"
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl font-bold text-white bg-gradient-to-r from-warmOrange-500 to-amber-500 hover:from-warmOrange-600 hover:to-amber-600 shadow-xl shadow-warmOrange-500/20 transition-all duration-300 transform hover:-translate-y-0.5 text-xs sm:text-sm flex items-center justify-center space-x-2 shrink-0 cursor-pointer active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Đóng Góp Album</span>
        </button>
      </div>

      <!-- Category Filter Chips Đẹp Mắt -->
      <div class="pt-4 flex items-center justify-center gap-2 overflow-x-auto pb-2 scrollbar-none flex-wrap" id="album-category-filters">
        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-gradient-to-r from-warmOrange-500 to-amber-500 text-white shadow-lg shadow-warmOrange-500/25 border border-warmOrange-400 cursor-pointer scale-105"
          data-filter="all"
        >
          <span>🌟</span>
          <span>Tất cả</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/25 text-white font-black ml-0.5">{enrichedAlbums.length}</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="nha-truong"
        >
          <span>🏫</span>
          <span>Nhà Trường</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="tri-an"
        >
          <span>💐</span>
          <span>Tri Ân</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="hoat-dong"
        >
          <span>🏕️</span>
          <span>Hoạt Động</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="truong-xua"
        >
          <span>🏛️</span>
          <span>Trường Xưa</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="ky-yeu"
        >
          <span>📖</span>
          <span>Kỷ Yếu</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20"
          data-filter="khac"
        >
          <span>✨</span>
          <span>Khác</span>
        </button>
      </div>

    </div>
  </section>

  <!-- Albums Showcase Section -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-slate-100 via-slate-50 to-slate-100 min-h-[75vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Stats / Filter Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-8 pb-4 border-b border-slate-200/80">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-warmOrange-500"></div>
          <p class="text-xs sm:text-sm font-bold text-navy-950">
            Đang hiển thị <span id="visible-count" class="text-warmOrange-600 font-extrabold text-base">0</span> / <span id="total-count" class="text-slate-500 font-bold">{enrichedAlbums.length}</span> album
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 shadow-xs font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>R2 CDN Siêu Tốc</span>
          </span>
          <span class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white border border-slate-200 shadow-xs font-medium">
            <span>⚡ Tự động tải thêm khi cuộn</span>
          </span>
        </div>
      </div>

      <!-- Albums Grid Container -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-7" id="albums-grid">
        <!-- Album Cards are dynamically rendered & managed by JS for seamless Infinite Scroll & Filter -->
      </div>

      <!-- Infinite Scroll Trigger Sentinel & Loading Spinner -->
      <div id="infinite-scroll-sentinel" class="py-10 flex flex-col items-center justify-center space-y-3">
        <div id="loading-spinner" class="flex items-center space-x-2 text-slate-500 text-xs font-bold bg-white px-5 py-2.5 rounded-full border border-slate-200 shadow-sm animate-pulse">
          <svg class="animate-spin h-4 w-4 text-warmOrange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Đang tải thêm album ảnh...</span>
        </div>
        <p id="all-loaded-text" class="hidden text-xs font-semibold text-slate-400 uppercase tracking-wider">
          🎉 Bạn đã xem toàn bộ album ảnh kỷ niệm!
        </p>
      </div>

      <!-- No result state -->
      <div id="no-results" class="hidden py-16 px-4 text-center text-slate-500 bg-white rounded-3xl border border-slate-200/90 shadow-sm max-w-lg mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-500 border border-amber-200 flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner">
          🔍
        </div>
        <h3 class="text-base font-bold text-navy-900 mb-1">Không tìm thấy album phù hợp</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Không có album nào khớp với từ khóa tìm kiếm hoặc danh mục đang chọn. Hãy thử tìm từ khóa khác hoặc xóa bộ lọc.
        </p>
        <button
          id="btn-reset-filters"
          class="mt-4 px-4 py-2 rounded-xl text-xs font-bold text-warmOrange-600 bg-warmOrange-50 hover:bg-warmOrange-100 transition cursor-pointer"
        >
          Xóa bộ lọc & xem tất cả
        </button>
      </div>

    </div>
  </section>

  <!-- Dữ liệu Album JSON ẩn để Script Client truy xuất tức thì mà không cần thêm API network request -->
  <script id="raw-albums-data" type="application/json" set:html={JSON.stringify(enrichedAlbums)}></script>

  <!-- Modern Modal Đóng Góp / Gửi Album Ảnh Mới -->
  <div
    id="modal-submit-album"
    class="fixed inset-0 z-50 bg-navy-950/80 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-6 overflow-y-auto"
  >
    <div class="relative bg-white rounded-3xl max-w-2xl w-full border border-slate-200 shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="bg-gradient-to-r from-navy-950 via-navy-900 to-navy-950 text-white p-5 sm:p-6 flex items-center justify-between border-b border-navy-800">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-2xl bg-warmOrange-500/20 text-warmOrange-400 border border-warmOrange-500/30 flex items-center justify-center font-bold text-lg">
            📸
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">Đóng Góp Album Ảnh Kỷ Niệm</h3>
            <p class="text-xs text-slate-300">Gửi ảnh hoặc link Google Drive lưu giữ ký ức trường xưa</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-submit-modal"
          class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <form id="album-submission-form" class="p-5 sm:p-7 space-y-4">
        
        <!-- Google Login Alert if not signed in -->
        <div id="modal-auth-alert" class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 text-amber-900">
            <span>🛡️</span>
            <span>Đăng nhập Google để gắn tên tác giả đóng góp</span>
          </div>
          <button
            type="button"
            id="btn-modal-google-auth"
            class="px-3 py-1.5 rounded-xl font-bold bg-white text-navy-950 border border-slate-300 hover:bg-slate-50 transition cursor-pointer shadow-xs shrink-0 flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Đăng nhập Google</span>
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Tên Album / Tiêu đề sự kiện <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="sub-album-title"
              required
              placeholder="VD: Họp lớp 12A1 khóa 2005-2008, Hội trại 26/3..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white font-medium"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Chủ đề / Chuyên mục <span class="text-rose-500">*</span>
            </label>
            <select
              id="sub-album-category"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white font-medium"
            >
              <option value="nha-truong">🏫 Nhà Trường</option>
              <option value="tri-an">💐 Tri Ân</option>
              <option value="hoat-dong">🏕️ Hoạt Động</option>
              <option value="truong-xua">🏛️ Trường Xưa</option>
              <option value="ky-yeu">📖 Kỷ Yếu</option>
              <option value="khac">✨ Khác</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Họ tên người gửi / Cựu học sinh <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="sub-sender-name"
              required
              placeholder="VD: Nguyễn Văn An - K05"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Niên khóa / Năm chụp
            </label>
            <input
              type="text"
              id="sub-album-year"
              placeholder="VD: Khóa 2005 - 2008 hoặc Năm 2011"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <!-- Phương thức gửi ảnh -->
        <div class="pt-2 border-t border-slate-100">
          <label class="block text-xs font-bold text-navy-950 mb-2">
            Cách thức gửi ảnh (Chọn 1 trong 2 cách thuận tiện nhất):
          </label>
          
          <div class="space-y-3">
            <!-- Cách 1: Link Google Drive / Dropbox / OneDrive -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold text-navy-900 block mb-1">
                🔗 Cách 1: Dán Link Google Drive / OneDrive (Khuyên dùng cho nhiều ảnh)
              </span>
              <input
                type="url"
                id="sub-drive-url"
                placeholder="https://drive.google.com/drive/folders/... hoặc link chia sẻ"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white font-mono"
              />
              <p class="text-[11px] text-slate-400 mt-1">
                * Hãy đảm bảo thư mục Google Drive đã bật quyền <em>"Bất kỳ ai có liên kết đều xem được"</em>.
              </p>
            </div>

            <!-- Cách 2: Chọn chùm ảnh trực tiếp từ máy -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold text-navy-900 block mb-1">
                📁 Cách 2: Hoặc chọn tải lên từ máy tính / điện thoại (Tối đa 10 ảnh / lần gửi trực tiếp)
              </span>
              <input
                type="file"
                id="sub-file-input"
                multiple
                accept="image/*"
                class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-navy-950 file:text-white hover:file:bg-warmOrange-600 file:cursor-pointer cursor-pointer"
              />
              <div id="sub-image-preview-grid" class="mt-2.5 grid grid-cols-5 gap-2 hidden"></div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-navy-950 mb-1">
            Ghi chú / Lời nhắn gửi Ban Quản Trị
          </label>
          <textarea
            id="sub-album-note"
            rows="2"
            placeholder="Lời nhắn thêm về bối cảnh, câu chuyện đằng sau các bức ảnh..."
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white resize-none"
          ></textarea>
        </div>

        <!-- Modal Submit Actions -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
          <button
            type="button"
            id="btn-cancel-submission"
            class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
          >
            Hủy Bỏ
          </button>
          <button
            type="submit"
            id="btn-submit-album-final"
            class="px-6 py-2.5 rounded-xl text-xs font-bold text-white bg-navy-950 hover:bg-warmOrange-600 transition shadow-sm flex items-center gap-2 cursor-pointer active:scale-95"
          >
            <span id="sub-btn-spinner" class="hidden inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
            <span id="sub-btn-text">Gửi Album Cho BQT Duyệt 🚀</span>
          </button>
        </div>

      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { auth, googleProvider, db } from '../../lib/firebase';
  import { signInWithPopup, onAuthStateChanged, type User } from 'firebase/auth';
  import { collection, getDocs, doc, addDoc, updateDoc, increment, serverTimestamp } from 'firebase/firestore';

  // --- DỮ LIỆU & CẤU HÌNH INFINITE SCROLL ---
  const rawAlbumsDataEl = document.getElementById('raw-albums-data');
  const allAlbums: any[] = rawAlbumsDataEl ? JSON.parse(rawAlbumsDataEl.textContent || '[]') : [];

  const PAGE_SIZE = 8; // Số album mỗi lần tải
  let currentPage = 1;
  let activeCategory = 'all';
  let searchQuery = '';
  let filteredAlbums: any[] = [...allAlbums];
  let isLoadingMore = false;

  // DOM Elements
  const albumsGrid = document.getElementById('albums-grid');
  const visibleCountEl = document.getElementById('visible-count');
  const totalCountEl = document.getElementById('total-count');
  const searchInput = document.getElementById('album-search') as HTMLInputElement | null;
  const btnClearSearch = document.getElementById('btn-clear-search');
  const filterBtns = document.querySelectorAll('.album-filter-btn') as NodeListOf<HTMLButtonElement>;
  const noResultsEl = document.getElementById('no-results');
  const btnResetFilters = document.getElementById('btn-reset-filters');
  const loadingSpinner = document.getElementById('loading-spinner');
  const allLoadedText = document.getElementById('all-loaded-text');
  const sentinel = document.getElementById('infinite-scroll-sentinel');

  // Bộ nhớ đệm thống kê (Views, Likes, Comments) từ Firestore
  let globalAlbumStats: Record<string, { viewsCount?: number; likesCount?: number; commentsCount?: number }> = {};

  // Render 1 Album Card HTML hiện đại
  function createAlbumCardHTML(album: any): string {
    const slug = album.slug;
    const title = album.title;
    const cover = album.coverImage || 'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800&auto=format&fit=crop&q=80';
    const photoCount = album.photoCount || (album.photos ? album.photos.length : 0);
    const categoryLabel = album.categoryLabel || 'Trường Xưa';
    const categoryIcon = album.categoryIcon || '🏛️';

    const stats = globalAlbumStats[slug] || {};
    const views = stats.viewsCount || 0;
    const comments = stats.commentsCount || 0;
    const likes = stats.likesCount || 0;

    const likedList = getLikedAlbums();
    const isLiked = likedList.includes(slug);
    const likeBtnClass = isLiked
      ? 'bg-rose-50 text-rose-600 border-rose-200'
      : 'bg-white text-slate-600 border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200';

    return `
      <article
        class="album-card group relative bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-warmOrange-500/10 transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between"
        data-slug="${slug}"
      >
        <!-- Top Cover Frame -->
        <div class="relative">
          <a href="/albums/${slug}" class="block h-52 sm:h-56 overflow-hidden bg-navy-950 relative">
            <img
              src="${cover}"
              alt="${title}"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/20 to-transparent opacity-70 group-hover:opacity-50 transition-opacity"></div>
            
            <!-- Category Chip Badge on Top Left -->
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-xl text-[11px] font-bold bg-navy-950/70 text-white backdrop-blur-md border border-white/15 flex items-center space-x-1 shadow-md">
              <span>${categoryIcon}</span>
              <span>${categoryLabel}</span>
            </span>

            <!-- Photo Count Badge on Bottom Right -->
            <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-xl text-xs font-extrabold bg-navy-950/80 text-warmOrange-300 backdrop-blur-md border border-warmOrange-500/30 flex items-center space-x-1.5 shadow-md">
              <svg class="w-3.5 h-3.5 text-warmOrange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>${photoCount} ảnh</span>
            </span>
          </a>

          <!-- Main Info -->
          <div class="p-5">
            <!-- Stats Indicators -->
            <div class="flex items-center space-x-2 text-[11px] text-slate-400 mb-2 font-medium">
              <span class="inline-flex items-center gap-1 text-slate-500">
                <span>👁️</span>
                <span class="album-card-views font-semibold" data-slug="${slug}">${views}</span>
              </span>
              <span>•</span>
              <span class="inline-flex items-center gap-1 text-slate-500">
                <span>💬</span>
                <span class="album-card-comments font-semibold" data-slug="${slug}">${comments}</span>
              </span>
              <span>•</span>
              <span class="text-slate-400 font-mono">${album.createdAtFormatted || '01/01/2026'}</span>
            </div>

            <!-- Title -->
            <h2 class="text-base font-bold text-navy-950 group-hover:text-warmOrange-600 transition-colors line-clamp-2 leading-snug">
              <a href="/albums/${slug}">${title}</a>
            </h2>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="px-5 py-3.5 bg-slate-50/80 border-t border-slate-100 flex items-center justify-between text-xs gap-2">
          <span class="text-[11px] text-slate-400 font-medium truncate max-w-[110px]" title="${album.senderName || 'CHS Xuân Lộc'}">
            👤 ${album.senderName || 'CHS Xuân Lộc'}
          </span>

          <div class="flex items-center gap-1.5 shrink-0">
            <!-- Like Button -->
            <button
              type="button"
              class="album-card-like-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold border transition flex items-center gap-1 cursor-pointer active:scale-90 ${likeBtnClass}"
              data-slug="${slug}"
              title="Yêu thích album"
            >
              <span>❤️</span>
              <span class="album-card-like-count" data-slug="${slug}">${likes}</span>
            </button>

            <!-- Share Button -->
            <button
              type="button"
              class="album-card-share-btn p-1.5 px-2 rounded-xl text-[11px] font-bold bg-white text-slate-600 border border-slate-200 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 transition cursor-pointer active:scale-90"
              data-slug="${slug}"
              data-title="${title.replace(/"/g, '&quot;')}"
              title="Chia sẻ album"
            >
              <span>🔗</span>
            </button>

            <!-- View Action Link -->
            <a
              href="/albums/${slug}"
              class="px-2.5 py-1.5 rounded-xl text-xs font-bold text-white bg-navy-950 group-hover:bg-warmOrange-600 transition-colors inline-flex items-center space-x-1"
            >
              <span>Xem</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </article>
    `;
  }

  // Render danh sách Album theo phân trang (Infinite Scroll)
  function renderAlbums(append = false) {
    if (!albumsGrid) return;

    if (!append) {
      albumsGrid.innerHTML = '';
      currentPage = 1;
    }

    const startIdx = 0;
    const endIdx = currentPage * PAGE_SIZE;
    const pageItems = filteredAlbums.slice(startIdx, endIdx);

    if (pageItems.length === 0) {
      albumsGrid.innerHTML = '';
      if (noResultsEl) noResultsEl.classList.remove('hidden');
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (allLoadedText) allLoadedText.classList.add('hidden');
      if (visibleCountEl) visibleCountEl.textContent = '0';
      return;
    }

    if (noResultsEl) noResultsEl.classList.add('hidden');

    if (!append) {
      albumsGrid.innerHTML = pageItems.map(createAlbumCardHTML).join('');
    } else {
      const newItems = filteredAlbums.slice((currentPage - 1) * PAGE_SIZE, endIdx);
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = newItems.map(createAlbumCardHTML).join('');
      while (tempDiv.firstChild) {
        albumsGrid.appendChild(tempDiv.firstChild);
      }
    }

    if (visibleCountEl) visibleCountEl.textContent = Math.min(endIdx, filteredAlbums.length).toString();

    // Cập nhật trạng thái loading spinner & thông báo hết dữ liệu
    if (endIdx >= filteredAlbums.length) {
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (allLoadedText) allLoadedText.classList.remove('hidden');
    } else {
      if (loadingSpinner) loadingSpinner.classList.remove('hidden');
      if (allLoadedText) allLoadedText.classList.add('hidden');
    }

    setupAlbumCardActions();
  }

  // Lọc dữ liệu theo Search Query & Category
  function applyFilters() {
    filteredAlbums = allAlbums.filter((album) => {
      const t = (album.title || '').toLowerCase();
      const s = (album.senderName || '').toLowerCase();
      const matchesSearch = !searchQuery || t.includes(searchQuery) || s.includes(searchQuery);
      const matchesCategory = activeCategory === 'all' || album.category === activeCategory;
      return matchesSearch && matchesCategory;
    });

    currentPage = 1;
    renderAlbums(false);
  }

  // Tải thêm album khi cuộn xuống đáy
  function loadMoreAlbums() {
    if (isLoadingMore) return;
    const maxPages = Math.ceil(filteredAlbums.length / PAGE_SIZE);
    if (currentPage >= maxPages) {
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (allLoadedText) allLoadedText.classList.remove('hidden');
      return;
    }

    isLoadingMore = true;
    if (loadingSpinner) loadingSpinner.classList.remove('hidden');

    setTimeout(() => {
      currentPage++;
      renderAlbums(true);
      isLoadingMore = false;
    }, 250); // Delay nhẹ tạo cảm giác mượt mà
  }

  // Khởi tạo Intersection Observer cho Infinite Scroll Tự Động
  function setupInfiniteScroll() {
    if (!sentinel) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !isLoadingMore) {
          loadMoreAlbums();
        }
      });
    }, {
      rootMargin: '250px', // Kích hoạt tải trước khi người dùng chạm đáy 250px
      threshold: 0.1,
    });

    observer.observe(sentinel);
  }

  // Gắn sự kiện ô tìm kiếm
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    if (btnClearSearch) {
      if (searchQuery) btnClearSearch.classList.remove('hidden');
      else btnClearSearch.classList.add('hidden');
    }
    applyFilters();
  });

  btnClearSearch?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    btnClearSearch.classList.add('hidden');
    applyFilters();
  });

  // Gắn sự kiện Category Filter Buttons
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20';
      });

      btn.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-gradient-to-r from-warmOrange-500 to-amber-500 text-white shadow-lg shadow-warmOrange-500/25 border border-warmOrange-400 cursor-pointer scale-105';

      activeCategory = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // Nút Xóa Bộ Lọc khi không có kết quả
  btnResetFilters?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'all';
    if (btnClearSearch) btnClearSearch.classList.add('hidden');

    filterBtns.forEach((b) => {
      if (b.getAttribute('data-filter') === 'all') {
        b.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-gradient-to-r from-warmOrange-500 to-amber-500 text-white shadow-lg shadow-warmOrange-500/25 border border-warmOrange-400 cursor-pointer scale-105';
      } else {
        b.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 cursor-pointer hover:border-white/20';
      }
    });

    applyFilters();
  });

  // --- CONTRIBUTE / SUBMIT ALBUM MODAL LOGIC ---
  const modalSubmitAlbum = document.getElementById('modal-submit-album');
  const btnOpenSubmit = document.getElementById('btn-open-submit-album');
  const btnCloseSubmit = document.getElementById('btn-close-submit-modal');
  const btnCancelSubmit = document.getElementById('btn-cancel-submission');
  const btnModalGoogleAuth = document.getElementById('btn-modal-google-auth');
  const authAlert = document.getElementById('modal-auth-alert');
  const submissionForm = document.getElementById('album-submission-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('sub-file-input') as HTMLInputElement | null;
  const previewGrid = document.getElementById('sub-image-preview-grid');
  const btnSubmitFinal = document.getElementById('btn-submit-album-final') as HTMLButtonElement | null;
  const subBtnSpinner = document.getElementById('sub-btn-spinner');
  const subBtnText = document.getElementById('sub-btn-text');

  let currentUser: User | null = null;
  let selectedFiles: File[] = [];

  function openSubmitModal() {
    if (modalSubmitAlbum) modalSubmitAlbum.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeSubmitModal() {
    if (modalSubmitAlbum) modalSubmitAlbum.classList.add('hidden');
    document.body.style.overflow = 'auto';
    if (submissionForm) submissionForm.reset();
    selectedFiles = [];
    if (previewGrid) {
      previewGrid.innerHTML = '';
      previewGrid.classList.add('hidden');
    }
  }

  btnOpenSubmit?.addEventListener('click', openSubmitModal);
  btnCloseSubmit?.addEventListener('click', closeSubmitModal);
  btnCancelSubmit?.addEventListener('click', closeSubmitModal);

  // Auth Listener in Modal
  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (currentUser) {
      if (authAlert) {
        authAlert.className = 'p-3 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-between gap-3 text-xs';
        authAlert.innerHTML = `
          <div class="flex items-center gap-2 text-emerald-900 font-bold truncate">
            <span>✅</span>
            <span>Đã đăng nhập: ${currentUser.displayName || currentUser.email}</span>
          </div>
        `;
      }
      const senderNameInput = document.getElementById('sub-sender-name') as HTMLInputElement | null;
      if (senderNameInput && !senderNameInput.value) {
        senderNameInput.value = currentUser.displayName || '';
      }
    }
  });

  btnModalGoogleAuth?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập thất bại: ' + (err.message || err));
    }
  });

  // Client-side Preview for files
  fileInput?.addEventListener('change', (e) => {
    const files = Array.from((e.target as HTMLInputElement).files || []);
    selectedFiles = files.slice(0, 10);

    if (previewGrid) {
      previewGrid.innerHTML = '';
      if (selectedFiles.length > 0) {
        previewGrid.classList.remove('hidden');
        selectedFiles.forEach((file) => {
          const url = URL.createObjectURL(file);
          const div = document.createElement('div');
          div.className = 'aspect-square rounded-lg overflow-hidden border border-slate-300 relative bg-slate-100';
          div.innerHTML = `<img src="${url}" class="w-full h-full object-cover" />`;
          previewGrid.appendChild(div);
        });
      } else {
        previewGrid.classList.add('hidden');
      }
    }
  });

  // Submit Album Form to Firestore (Pending)
  submissionForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = (document.getElementById('sub-album-title') as HTMLInputElement)?.value.trim();
    const category = (document.getElementById('sub-album-category') as HTMLSelectElement)?.value;
    const senderName = (document.getElementById('sub-sender-name') as HTMLInputElement)?.value.trim();
    const year = (document.getElementById('sub-album-year') as HTMLInputElement)?.value.trim();
    const driveUrl = (document.getElementById('sub-drive-url') as HTMLInputElement)?.value.trim();
    const note = (document.getElementById('sub-album-note') as HTMLTextAreaElement)?.value.trim();

    if (!title || !category || !senderName) {
      alert('Vui lòng điền đầy đủ các thông tin bắt buộc (*)!');
      return;
    }

    if (!driveUrl && selectedFiles.length === 0) {
      alert('Vui lòng cung cấp Link Google Drive chứa ảnh hoặc chọn ít nhất 1 ảnh tải lên!');
      return;
    }

    if (btnSubmitFinal) btnSubmitFinal.disabled = true;
    if (subBtnSpinner) subBtnSpinner.classList.remove('hidden');
    if (subBtnText) subBtnText.textContent = 'Đang gửi phê duyệt...';

    try {
      const previews: string[] = [];
      for (const file of selectedFiles.slice(0, 5)) {
        const b64 = await fileToBase64(file);
        if (b64) previews.push(b64);
      }

      await addDoc(collection(db, 'album_submissions'), {
        title,
        category,
        senderName,
        year: year || '',
        driveUrl: driveUrl || '',
        photoCount: selectedFiles.length,
        previews: previews,
        note: note || '',
        status: 'pending',
        userEmail: currentUser?.email || '',
        userId: currentUser?.uid || '',
        createdAt: serverTimestamp()
      });

      alert('🎉 Gửi Album thành công! Ban Quản Trị sẽ kiểm tra và xuất bản album lên website sớm nhất.');
      closeSubmitModal();
    } catch (err: any) {
      console.error(err);
      alert('Lỗi khi gửi album: ' + (err.message || 'Lỗi kết nối Firestore'));
    } finally {
      if (btnSubmitFinal) btnSubmitFinal.disabled = false;
      if (subBtnSpinner) subBtnSpinner.classList.add('hidden');
      if (subBtnText) subBtnText.textContent = 'Gửi Album Cho BQT Duyệt 🚀';
    }
  });

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const maxDim = 300;
          let w = img.width;
          let h = img.height;
          if (w > maxDim) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          }
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/jpeg', 0.6));
        };
        img.src = reader.result as string;
      };
      reader.onerror = () => resolve('');
      reader.readAsDataURL(file);
    });
  }

  // --- STATS & LIKE/SHARE ---
  function getLikedAlbums(): string[] {
    try {
      return JSON.parse(localStorage.getItem('chs_liked_albums') || '[]');
    } catch {
      return [];
    }
  }

  function setLikedAlbum(slug: string) {
    const liked = getLikedAlbums();
    if (!liked.includes(slug)) {
      liked.push(slug);
      localStorage.setItem('chs_liked_albums', JSON.stringify(liked));
    }
  }

  async function loadAllAlbumStats() {
    try {
      const colRef = collection(db, 'album_stats');
      const snap = await getDocs(colRef);
      globalAlbumStats = {};

      snap.forEach((d) => {
        globalAlbumStats[d.id] = d.data();
      });

      // Cập nhật lên các card đã render
      document.querySelectorAll('.album-card').forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;
        const data = globalAlbumStats[slug] || {};
        const viewsEl = card.querySelector('.album-card-views');
        const commentsEl = card.querySelector('.album-card-comments');
        const likeCountEl = card.querySelector('.album-card-like-count');

        if (viewsEl) viewsEl.textContent = String(data.viewsCount || 0);
        if (commentsEl) commentsEl.textContent = String(data.commentsCount || 0);
        if (likeCountEl) likeCountEl.textContent = String(data.likesCount || 0);
      });
    } catch (err) {
      console.warn('Lỗi tải thống kê album:', err);
    }
  }

  function setupAlbumCardActions() {
    document.querySelectorAll<HTMLButtonElement>('.album-card-like-btn').forEach((btn) => {
      // Remove old listener clone
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = newBtn.getAttribute('data-slug');
        if (!slug) return;

        const liked = getLikedAlbums();
        const isLiked = liked.includes(slug);
        const statsRef = doc(db, 'album_stats', slug);

        const countSpan = newBtn.querySelector('.album-card-like-count');
        let currentCount = countSpan ? parseInt(countSpan.textContent || '0', 10) : 0;

        try {
          if (!isLiked) {
            setLikedAlbum(slug);
            currentCount++;
            if (countSpan) countSpan.textContent = String(currentCount);
            newBtn.className = 'album-card-like-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold border transition flex items-center gap-1 cursor-pointer active:scale-90 bg-rose-50 text-rose-600 border-rose-200';
            await updateDoc(statsRef, { likesCount: increment(1) });
          } else {
            const filtered = liked.filter((id) => id !== slug);
            localStorage.setItem('chs_liked_albums', JSON.stringify(filtered));
            currentCount = Math.max(0, currentCount - 1);
            if (countSpan) countSpan.textContent = String(currentCount);
            newBtn.className = 'album-card-like-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold border transition flex items-center gap-1 cursor-pointer active:scale-90 bg-white text-slate-600 border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200';
            await updateDoc(statsRef, { likesCount: increment(-1) });
          }
        } catch (err) {
          console.error(err);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.album-card-share-btn').forEach((btn) => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = newBtn.getAttribute('data-slug');
        const title = newBtn.getAttribute('data-title') || 'Album kỷ niệm THPT Xuân Lộc';
        const shareUrl = `${window.location.origin}/albums/${slug}`;

        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              text: `Xem album ảnh "${title}" trên Cổng thông tin THPT Xuân Lộc!`,
              url: shareUrl,
            });
            return;
          } catch {}
        }

        try {
          await navigator.clipboard.writeText(shareUrl);
          alert('Đã sao chép liên kết album ảnh vào bộ nhớ tạm!');
        } catch {
          prompt('Sao chép liên kết album:', shareUrl);
        }
      });
    });
  }

  // Initial Load
  document.addEventListener('DOMContentLoaded', async () => {
    renderAlbums(false);
    setupInfiniteScroll();
    await loadAllAlbumStats();
  });
</script>
