---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';
---

<BaseLayout
  title="Thư Viện Album Ảnh Kỷ Niệm - Trường THPT Xuân Lộc"
  description="Toàn bộ kho tư liệu hình ảnh kỷ niệm, đại lễ, cựu học sinh, hội trại, leo núi Chứa Chan và các thời kỳ phát triển của Trường THPT Xuân Lộc."
>
  <!-- Hero Section with Modern Filters & Actions -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 text-white py-14 sm:py-18 border-b border-navy-800 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(221,107,32,0.18),transparent_50%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-2 shadow-sm backdrop-blur-md">
        <svg class="w-4 h-4 text-warmOrange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Kho Tư Liệu Ký Ức THPT Xuân Lộc</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight font-serif">
        Thư Viện Album Ảnh Kỷ Niệm
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
        Lưu giữ trọn vẹn những khoảnh khắc thanh xuân thiêng liêng, họp mặt cựu học sinh, tri ân thầy cô và các chặng đường phát triển rực rỡ của mái trường.
      </p>

      <!-- Action Buttons & Search Filter -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-2xl mx-auto">
        <!-- Search Input -->
        <div class="relative w-full sm:flex-1">
          <input
            type="text"
            id="album-search"
            placeholder="Tìm kiếm album (VD: Khai giảng, 20/11, Hội trại, 2012...)"
            class="w-full px-4 py-3 pl-10 rounded-2xl bg-navy-900/90 border border-navy-700/80 text-white placeholder-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-warmOrange-500 shadow-xl backdrop-blur-sm transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Open Contribute Album Modal Button -->
        <button
          id="btn-open-submit-album"
          class="w-full sm:w-auto px-5 py-3 rounded-2xl font-bold text-white bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-lg shadow-warmOrange-500/25 transition transform hover:-translate-y-0.5 text-xs sm:text-sm flex items-center justify-center space-x-2 shrink-0 cursor-pointer active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Đóng Góp Album Mới</span>
        </button>
      </div>

      <!-- Modern Category Filter Chips -->
      <div class="pt-4 flex items-center justify-center gap-2 overflow-x-auto pb-1 scrollbar-none flex-wrap" id="album-category-filters">
        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-warmOrange-500 text-white shadow-md border border-warmOrange-400 cursor-pointer"
          data-filter="all"
        >
          <span>🌟</span>
          <span>Tất cả</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/20 text-white font-bold ml-0.5">{albumsData.length}</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer"
          data-filter="khai-giang"
        >
          <span>🎓</span>
          <span>Khai Giảng & Tổng Kết</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer"
          data-filter="thay-co"
        >
          <span>💐</span>
          <span>20/11 & Tri Ân Thầy Cô</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer"
          data-filter="hoi-trai"
        >
          <span>🏕️</span>
          <span>Hội Trại & Dã Ngoại</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer"
          data-filter="the-thao"
        >
          <span>⚽</span>
          <span>Thể Thao & Phong Trào</span>
        </button>

        <button
          class="album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer"
          data-filter="truong-xua"
        >
          <span>🏫</span>
          <span>Lịch Sử & Tư Liệu Trường</span>
        </button>
      </div>

    </div>
  </section>

  <!-- Albums Grid Section -->
  <section class="py-12 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Stats Count Bar -->
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
        <p class="text-xs sm:text-sm font-semibold text-navy-900">
          Hiển thị <span id="visible-count" class="text-warmOrange-600 font-bold">{albumsData.length}</span> album tư liệu
        </p>
        <span class="text-xs text-slate-500 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-xs flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Kho ảnh gốc độ phân giải cao</span>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7" id="albums-grid">
        {albumsData.map((album) => {
          // Gán tag phân loại thông minh dựa trên title
          const t = album.title.toLowerCase();
          let cat = 'truong-xua';
          if (t.includes('khai giảng') || t.includes('tổng kết') || t.includes('sơ kết') || t.includes('chuẩn quốc gia')) {
            cat = 'khai-giang';
          } else if (t.includes('20-11') || t.includes('20/11') || t.includes('nhà giáo') || t.includes('thầy cô') || t.includes('giao ước')) {
            cat = 'thay-co';
          } else if (t.includes('nguồn') || t.includes('núi') || t.includes('chứa chan') || t.includes('dã ngoại') || t.includes('hội trại') || t.includes('tham quan')) {
            cat = 'hoi-trai';
          } else if (t.includes('bóng đá') || t.includes('phù đổng') || t.includes('đoàn trường') || t.includes('thể thao')) {
            cat = 'the-thao';
          }

          return (
            <article
              class="album-card bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 flex flex-col group justify-between"
              data-slug={album.slug}
              data-title={album.title.toLowerCase()}
              data-category={cat}
            >
              <!-- Top Part -->
              <div>
                <!-- Image Frame -->
                <a href={`/albums/${album.slug}`} class="block h-52 overflow-hidden bg-slate-900 relative">
                  <img
                    src={album.coverImage}
                    alt={album.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-navy-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                  
                  <!-- Badge photo count -->
                  <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-lg text-xs font-bold bg-navy-950/80 text-warmOrange-300 backdrop-blur-md border border-navy-700/80 flex items-center space-x-1.5 shadow-md">
                    <svg class="w-3.5 h-3.5 text-warmOrange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>{album.photoCount} ảnh</span>
                  </span>
                </a>

                <!-- Card Content -->
                <div class="p-5">
                  <div class="flex items-center space-x-2 text-xs text-slate-400 mb-2 font-medium">
                    <span class="inline-flex items-center gap-1 text-slate-500">
                      <span>👁️</span>
                      <span class="album-card-views" data-slug={album.slug}>0</span> lượt xem
                    </span>
                    <span>•</span>
                    <span class="inline-flex items-center gap-1 text-slate-500">
                      <span>💬</span>
                      <span class="album-card-comments" data-slug={album.slug}>0</span>
                    </span>
                  </div>

                  <h2 class="text-base font-bold text-navy-900 group-hover:text-warmOrange-600 transition-colors line-clamp-2 leading-snug mb-2">
                    <a href={`/albums/${album.slug}`} set:html={album.title}></a>
                  </h2>
                </div>
              </div>

              <!-- Bottom Actions -->
              <div class="px-5 py-3.5 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between text-xs gap-2">
                <span class="text-slate-400 font-medium">THPT Xuân Lộc</span>

                <div class="flex items-center gap-1.5 shrink-0">
                  <!-- Like Button -->
                  <button
                    type="button"
                    class="album-card-like-btn px-2 py-1 rounded-lg text-[11px] font-bold border transition flex items-center gap-1 bg-white border-slate-200 text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 cursor-pointer"
                    data-slug={album.slug}
                    title="Yêu thích album"
                  >
                    <span>❤️</span>
                    <span class="album-card-like-count" data-slug={album.slug}>0</span>
                  </button>

                  <!-- Share Button -->
                  <button
                    type="button"
                    class="album-card-share-btn p-1 px-1.5 rounded-lg text-[11px] font-bold bg-white text-slate-600 border border-slate-200 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 transition cursor-pointer"
                    data-slug={album.slug}
                    data-title={album.title}
                    title="Chia sẻ album"
                  >
                    <span>🔗</span>
                  </button>

                  <a
                    href={`/albums/${album.slug}`}
                    class="font-bold text-warmOrange-600 hover:text-warmOrange-700 inline-flex items-center space-x-1 group-hover:translate-x-1 transition-transform ml-1"
                  >
                    <span>Xem</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- No result state -->
      <div id="no-results" class="hidden py-16 text-center text-slate-500 bg-white rounded-2xl border border-slate-200">
        <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <p class="font-medium text-navy-900">Không tìm thấy album phù hợp</p>
        <p class="text-xs text-slate-400 mt-1">Hãy thử tìm với từ khóa khác như "cựu học sinh", "khai giảng", "tổng kết"...</p>
      </div>

    </div>
  </section>

  <!-- Modern Modal Đóng Góp / Gửi Album Ảnh Mới -->
  <div
    id="modal-submit-album"
    class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-6 overflow-y-auto"
  >
    <div class="relative bg-white rounded-3xl max-w-2xl w-full border border-slate-200 shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="bg-gradient-to-r from-navy-950 via-navy-900 to-navy-950 text-white p-5 sm:p-6 flex items-center justify-between border-b border-navy-800">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-2xl bg-warmOrange-500/20 text-warmOrange-400 border border-warmOrange-500/30 flex items-center justify-center font-bold text-lg">
            📸
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">Đóng Góp Album Ảnh Kỷ Niệm</h3>
            <p class="text-xs text-slate-300">Gửi ảnh hoặc link Google Drive lưu giữ ký ức trường xưa</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-submit-modal"
          class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <form id="album-submission-form" class="p-5 sm:p-7 space-y-4">
        
        <!-- Google Login Alert if not signed in -->
        <div id="modal-auth-alert" class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 text-amber-900">
            <span>🛡️</span>
            <span>Đăng nhập Google để gắn tên tác giả đóng góp</span>
          </div>
          <button
            type="button"
            id="btn-modal-google-auth"
            class="px-3 py-1.5 rounded-xl font-bold bg-white text-navy-950 border border-slate-300 hover:bg-slate-50 transition cursor-pointer shadow-xs shrink-0 flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Đăng nhập Google</span>
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Tên Album / Tiêu đề sự kiện <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="sub-album-title"
              required
              placeholder="VD: Họp lớp 12A1 khóa 2005-2008, Hội trại 26/3..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Chủ đề / Chuyên mục <span class="text-rose-500">*</span>
            </label>
            <select
              id="sub-album-category"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            >
              <option value="khai-giang">🎓 Lễ Khai Giảng & Tổng Kết</option>
              <option value="thay-co">💐 20/11 & Tri Ân Thầy Cô</option>
              <option value="hoi-trai">🏕️ Hội Trại & Dã Ngoại (Chứa Chan...)</option>
              <option value="the-thao">⚽ Thể Thao & Phong Trào</option>
              <option value="truong-xua">🏫 Lịch Sử & Tư Liệu Trường</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Họ tên người gửi / Cựu học sinh <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="sub-sender-name"
              required
              placeholder="VD: Nguyễn Văn An - K05"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-navy-950 mb-1">
              Niên khóa / Năm chụp
            </label>
            <input
              type="text"
              id="sub-album-year"
              placeholder="VD: Khóa 2005 - 2008 hoặc Năm 2011"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <!-- Phương thức gửi ảnh -->
        <div class="pt-2 border-t border-slate-100">
          <label class="block text-xs font-bold text-navy-950 mb-2">
            Cách thức gửi ảnh (Chọn 1 trong 2 cách thuận tiện nhất):
          </label>
          
          <div class="space-y-3">
            <!-- Cách 1: Link Google Drive / Dropbox / OneDrive -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold text-navy-900 block mb-1">
                🔗 Cách 1: Dán Link Google Drive / OneDrive (Khuyên dùng cho nhiều ảnh)
              </span>
              <input
                type="url"
                id="sub-drive-url"
                placeholder="https://drive.google.com/drive/folders/... hoặc link chia sẻ"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white font-mono"
              />
              <p class="text-[11px] text-slate-400 mt-1">
                * Hãy đảm bảo thư mục Google Drive đã bật quyền <em>"Bất kỳ ai có liên kết đều xem được"</em>.
              </p>
            </div>

            <!-- Cách 2: Chọn chùm ảnh trực tiếp từ máy -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold text-navy-900 block mb-1">
                📁 Cách 2: Hoặc chọn tải lên từ máy tính / điện thoại (Tối đa 10 ảnh / lần gửi trực tiếp)
              </span>
              <input
                type="file"
                id="sub-file-input"
                multiple
                accept="image/*"
                class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-navy-950 file:text-white hover:file:bg-warmOrange-600 file:cursor-pointer cursor-pointer"
              />
              <div id="sub-image-preview-grid" class="mt-2.5 grid grid-cols-5 gap-2 hidden"></div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-navy-950 mb-1">
            Ghi chú / Lời nhắn gửi Ban Quản Trị
          </label>
          <textarea
            id="sub-album-note"
            rows="2"
            placeholder="Lời nhắn thêm về bối cảnh, câu chuyện đằng sau các bức ảnh..."
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white resize-none"
          ></textarea>
        </div>

        <!-- Modal Submit Actions -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
          <button
            type="button"
            id="btn-cancel-submission"
            class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
          >
            Hủy Bỏ
          </button>
          <button
            type="submit"
            id="btn-submit-album-final"
            class="px-6 py-2.5 rounded-xl text-xs font-bold text-white bg-navy-950 hover:bg-warmOrange-600 transition shadow-sm flex items-center gap-2 cursor-pointer active:scale-95"
          >
            <span id="sub-btn-spinner" class="hidden inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
            <span id="sub-btn-text">Gửi Album Cho BQT Duyệt 🚀</span>
          </button>
        </div>

      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { auth, googleProvider, db } from '../../lib/firebase';
  import { signInWithPopup, onAuthStateChanged, type User } from 'firebase/auth';
  import { collection, getDocs, doc, setDoc, addDoc, updateDoc, increment, serverTimestamp } from 'firebase/firestore';

  const searchInput = document.getElementById('album-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.album-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results');
  const visibleCount = document.getElementById('visible-count');
  const filterBtns = document.querySelectorAll('.album-filter-btn') as NodeListOf<HTMLButtonElement>;

  let activeCategory = 'all';
  let searchQuery = '';

  // Filter functionality by Category & Search query
  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const title = (card.getAttribute('data-title') || '').toLowerCase();
      const cat = card.getAttribute('data-category') || '';

      const matchesSearch = title.includes(searchQuery);
      const matchesCat = activeCategory === 'all' || cat === activeCategory;

      if (matchesSearch && matchesCat) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount) visibleCount.textContent = visible.toString();

    if (visible === 0 && noResults) {
      noResults.classList.remove('hidden');
    } else if (noResults) {
      noResults.classList.add('hidden');
    }
  }

  // Bind Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  // Bind Category Filter Chips
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-navy-900/80 hover:bg-navy-800 text-slate-300 border border-navy-700/80 cursor-pointer';
      });

      btn.className = 'album-filter-btn px-4 py-2 rounded-2xl text-xs font-bold transition flex items-center gap-1.5 bg-warmOrange-500 text-white shadow-md border border-warmOrange-400 cursor-pointer';

      activeCategory = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // --- CONTRIBUTE / SUBMIT ALBUM MODAL LOGIC ---
  const modalSubmitAlbum = document.getElementById('modal-submit-album');
  const btnOpenSubmit = document.getElementById('btn-open-submit-album');
  const btnCloseSubmit = document.getElementById('btn-close-submit-modal');
  const btnCancelSubmit = document.getElementById('btn-cancel-submission');
  const btnModalGoogleAuth = document.getElementById('btn-modal-google-auth');
  const authAlert = document.getElementById('modal-auth-alert');
  const submissionForm = document.getElementById('album-submission-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('sub-file-input') as HTMLInputElement | null;
  const previewGrid = document.getElementById('sub-image-preview-grid');
  const btnSubmitFinal = document.getElementById('btn-submit-album-final') as HTMLButtonElement | null;
  const subBtnSpinner = document.getElementById('sub-btn-spinner');
  const subBtnText = document.getElementById('sub-btn-text');

  let currentUser: User | null = null;
  let selectedFiles: File[] = [];

  function openSubmitModal() {
    if (modalSubmitAlbum) modalSubmitAlbum.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeSubmitModal() {
    if (modalSubmitAlbum) modalSubmitAlbum.classList.add('hidden');
    document.body.style.overflow = 'auto';
    if (submissionForm) submissionForm.reset();
    selectedFiles = [];
    if (previewGrid) {
      previewGrid.innerHTML = '';
      previewGrid.classList.add('hidden');
    }
  }

  btnOpenSubmit?.addEventListener('click', openSubmitModal);
  btnCloseSubmit?.addEventListener('click', closeSubmitModal);
  btnCancelSubmit?.addEventListener('click', closeSubmitModal);

  // Auth Listener in Modal
  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (currentUser) {
      if (authAlert) {
        authAlert.className = 'p-3 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-between gap-3 text-xs';
        authAlert.innerHTML = `
          <div class="flex items-center gap-2 text-emerald-900 font-bold truncate">
            <span>✅</span>
            <span>Đã đăng nhập: ${currentUser.displayName || currentUser.email}</span>
          </div>
        `;
      }
      const senderNameInput = document.getElementById('sub-sender-name') as HTMLInputElement | null;
      if (senderNameInput && !senderNameInput.value) {
        senderNameInput.value = currentUser.displayName || '';
      }
    }
  });

  btnModalGoogleAuth?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập thất bại: ' + (err.message || err));
    }
  });

  // Client-side Preview for files
  fileInput?.addEventListener('change', (e) => {
    const files = Array.from((e.target as HTMLInputElement).files || []);
    selectedFiles = files.slice(0, 10); // Max 10 direct files

    if (previewGrid) {
      previewGrid.innerHTML = '';
      if (selectedFiles.length > 0) {
        previewGrid.classList.remove('hidden');
        selectedFiles.forEach((file) => {
          const url = URL.createObjectURL(file);
          const div = document.createElement('div');
          div.className = 'aspect-square rounded-lg overflow-hidden border border-slate-300 relative bg-slate-100';
          div.innerHTML = `<img src="${url}" class="w-full h-full object-cover" />`;
          previewGrid.appendChild(div);
        });
      } else {
        previewGrid.classList.add('hidden');
      }
    }
  });

  // Submit Album Form to Firestore (Pending)
  submissionForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = (document.getElementById('sub-album-title') as HTMLInputElement)?.value.trim();
    const category = (document.getElementById('sub-album-category') as HTMLSelectElement)?.value;
    const senderName = (document.getElementById('sub-sender-name') as HTMLInputElement)?.value.trim();
    const year = (document.getElementById('sub-album-year') as HTMLInputElement)?.value.trim();
    const driveUrl = (document.getElementById('sub-drive-url') as HTMLInputElement)?.value.trim();
    const note = (document.getElementById('sub-album-note') as HTMLTextAreaElement)?.value.trim();

    if (!title || !category || !senderName) {
      alert('Vui lòng điền đầy đủ các thông tin bắt buộc (*)!');
      return;
    }

    if (!driveUrl && selectedFiles.length === 0) {
      alert('Vui lòng cung cấp Link Google Drive chứa ảnh hoặc chọn ít nhất 1 ảnh tải lên!');
      return;
    }

    if (btnSubmitFinal) btnSubmitFinal.disabled = true;
    if (subBtnSpinner) subBtnSpinner.classList.remove('hidden');
    if (subBtnText) subBtnText.textContent = 'Đang gửi phê duyệt...';

    try {
      // 1. Convert client files to base64 preview thumbnails if any
      const previews: string[] = [];
      for (const file of selectedFiles.slice(0, 5)) {
        const b64 = await fileToBase64(file);
        if (b64) previews.push(b64);
      }

      // 2. Add document to Firestore album_submissions
      await addDoc(collection(db, 'album_submissions'), {
        title,
        category,
        senderName,
        year: year || '',
        driveUrl: driveUrl || '',
        photoCount: selectedFiles.length,
        previews: previews, // Tiny previews for Admin
        note: note || '',
        status: 'pending',
        userEmail: currentUser?.email || '',
        userId: currentUser?.uid || '',
        createdAt: serverTimestamp()
      });

      alert('🎉 Gửi Album thành công! Ban Quản Trị sẽ kiểm tra và xuất bản album lên website sớm nhất.');
      closeSubmitModal();
    } catch (err: any) {
      console.error(err);
      alert('Lỗi khi gửi album: ' + (err.message || 'Lỗi kết nối Firestore'));
    } finally {
      if (btnSubmitFinal) btnSubmitFinal.disabled = false;
      if (subBtnSpinner) subBtnSpinner.classList.add('hidden');
      if (subBtnText) subBtnText.textContent = 'Gửi Album Cho BQT Duyệt 🚀';
    }
  });

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = () => {
        // Resize down to 200px width thumbnail
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const maxDim = 300;
          let w = img.width;
          let h = img.height;
          if (w > maxDim) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          }
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/jpeg', 0.6));
        };
        img.src = reader.result as string;
      };
      reader.onerror = () => resolve('');
      reader.readAsDataURL(file);
    });
  }

  // --- STATS & LIKE/SHARE ---
  function getLikedAlbums(): string[] {
    try {
      return JSON.parse(localStorage.getItem('chs_liked_albums') || '[]');
    } catch {
      return [];
    }
  }

  function setLikedAlbum(slug: string) {
    const liked = getLikedAlbums();
    if (!liked.includes(slug)) {
      liked.push(slug);
      localStorage.setItem('chs_liked_albums', JSON.stringify(liked));
    }
  }

  async function loadAllAlbumStats() {
    try {
      const colRef = collection(db, 'album_stats');
      const snap = await getDocs(colRef);
      const statsMap: Record<string, { viewsCount?: number; likesCount?: number; commentsCount?: number }> = {};

      snap.forEach((d) => {
        statsMap[d.id] = d.data();
      });

      const likedList = getLikedAlbums();

      cards.forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;

        const data = statsMap[slug] || {};
        const viewsEl = card.querySelector<HTMLElement>('.album-card-views');
        const commentsEl = card.querySelector<HTMLElement>('.album-card-comments');
        const likeCountEl = card.querySelector<HTMLElement>('.album-card-like-count');

        if (viewsEl) viewsEl.textContent = String(data.viewsCount || 0);
        if (commentsEl) commentsEl.textContent = String(data.commentsCount || 0);
        if (likeCountEl) likeCountEl.textContent = String(data.likesCount || 0);

        if (likedList.includes(slug)) {
          const likeBtns = card.querySelectorAll<HTMLButtonElement>(`.album-card-like-btn[data-slug="${slug}"]`);
          likeBtns.forEach(btn => {
            btn.classList.add('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
          });
        }
      });
    } catch (err) {
      console.warn('Lỗi tải thống kê album:', err);
    }
  }

  function setupAlbumCardActions() {
    document.querySelectorAll<HTMLButtonElement>('.album-card-like-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        if (!slug) return;

        const liked = getLikedAlbums();
        const isLiked = liked.includes(slug);
        const statsRef = doc(db, 'album_stats', slug);

        const countSpan = btn.querySelector('.album-card-like-count');
        let currentCount = countSpan ? parseInt(countSpan.textContent || '0', 10) : 0;

        try {
          if (!isLiked) {
            setLikedAlbum(slug);
            currentCount++;
            if (countSpan) countSpan.textContent = String(currentCount);
            btn.classList.add('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
            await updateDoc(statsRef, { likesCount: increment(1) });
          } else {
            const filtered = liked.filter(id => id !== slug);
            localStorage.setItem('chs_liked_albums', JSON.stringify(filtered));
            currentCount = Math.max(0, currentCount - 1);
            if (countSpan) countSpan.textContent = String(currentCount);
            btn.classList.remove('bg-rose-50', 'text-rose-600', 'border-rose-200');
            btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
            await updateDoc(statsRef, { likesCount: increment(-1) });
          }
        } catch (err) {
          console.error(err);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.album-card-share-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title') || 'Album kỷ niệm THPT Xuân Lộc';
        const shareUrl = `${window.location.origin}/albums/${slug}`;

        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              text: `Xem album ảnh "${title}" trên Cổng thông tin THPT Xuân Lộc!`,
              url: shareUrl,
            });
            return;
          } catch {}
        }

        try {
          await navigator.clipboard.writeText(shareUrl);
          alert('Đã sao chép liên kết album ảnh vào bộ nhớ tạm!');
        } catch {
          prompt('Sao chép liên kết album:', shareUrl);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadAllAlbumStats();
    setupAlbumCardActions();
  });
</script>
