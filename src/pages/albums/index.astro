---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';
---

<BaseLayout
  title="Thư Viện Album Ảnh Kỷ Niệm - Trường THPT Xuân Lộc"
  description="Toàn bộ kho tư liệu hình ảnh kỷ niệm, đại lễ, cựu học sinh, hội trại, leo núi Chứa Chan và các thời kỳ phát triển của Trường THPT Xuân Lộc."
>
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Kho Tư Liệu Ký Ức THPT Xuân Lộc</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Thư Viện Album Ảnh Kỷ Niệm
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base">
        Tổng hợp 25+ bộ album ảnh lịch sử, họp mặt cựu học sinh, hội khóa, lễ tốt nghiệp và các phong trào truyền thống qua các năm học.
      </p>
    </div>
  </section>

  <section class="py-12 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {albumsData.map((album) => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img
                src={album.coverImage}
                alt={album.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-lg text-xs font-bold bg-navy-900/90 text-warmOrange-300 backdrop-blur-sm border border-navy-700 flex items-center space-x-1">
                <svg class="w-3.5 h-3.5 text-warmOrange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{album.photoCount} ảnh</span>
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-base font-bold text-navy-900 group-hover:text-warmOrange-600 transition leading-snug mb-2" set:html={album.title}>
                </h2>
              </div>

              <div class="pt-3 mt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-400 font-medium">THPT Xuân Lộc</span>
                <a
                  href={`/albums/${album.slug}`}
                  class="font-bold text-warmOrange-600 hover:text-warmOrange-700 inline-flex items-center space-x-1 group-hover:translate-x-1 transition-transform"
                >
                  <span>Xem Album</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
