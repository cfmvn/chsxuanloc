---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';

export async function getStaticPaths() {
  return albumsData.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
---

<BaseLayout
  title={`${album.title} - Thư Viện Album Ảnh THPT Xuân Lộc`}
  description={`Xem trọn bộ album ảnh ${album.title} gồm ${album.photoCount} bức ảnh lưu niệm của Trường THPT Xuân Lộc.`}
  image={album.coverImage}
>
  <!-- Header -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href="/albums" class="inline-flex items-center text-xs font-semibold text-warmOrange-400 hover:text-warmOrange-300">
          &larr; Quay lại Thư Viện Album
        </a>
      </div>
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        Kho Tư Liệu • {album.photoCount} Bức Ảnh
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white mb-2" set:html={album.title}>
      </h1>
      <p class="text-slate-300 text-sm max-w-3xl">
        Kỷ niệm quý giá được lưu giữ tại cổng thông tin Cựu Học Sinh Trường THPT Xuân Lộc.
      </p>
    </div>
  </section>

  <!-- Photo Gallery Grid -->
  <section class="py-12 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {album.photos.map((photo, index) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
            <div class="h-64 overflow-hidden bg-slate-100 relative cursor-pointer" onclick={`window.open('${photo.src}', '_blank')`}>
              <img
                src={photo.src}
                alt={photo.caption}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-navy-900/90 text-white text-xs px-3 py-1.5 rounded-lg shadow font-medium">
                  Xem ảnh gốc ↗
                </span>
              </div>
            </div>
            <div class="p-3 text-center border-t border-slate-100 bg-white">
              <span class="text-xs text-slate-500 font-medium">Ảnh {index + 1} / {album.photoCount}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
