---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';

export async function getStaticPaths() {
  return albumsData.map((album) => ({
    params: { slug: album.slug },
    props: {
      album,
      relatedAlbums: albumsData.filter((a) => a.slug !== album.slug).slice(0, 4),
    },
  }));
}

interface Props {
  album: typeof albumsData[0];
  relatedAlbums: typeof albumsData;
}

const { album, relatedAlbums } = Astro.props;
---

<BaseLayout
  title={`${album.title} - Thư Viện Album Ảnh THPT Xuân Lộc`}
  description={`Xem trọn bộ album ảnh ${album.title} gồm ${album.photoCount} bức ảnh lưu niệm của Trường THPT Xuân Lộc.`}
  image={album.coverImage}
>
  <!-- Header Banner -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 text-white py-12 lg:py-16 border-b border-navy-800 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(221,107,32,0.15),transparent_50%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs font-medium text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-warmOrange-400 transition-colors">Trang Chủ</a>
        <span>/</span>
        <a href="/albums" class="hover:text-warmOrange-400 transition-colors">Thư Viện Ảnh</a>
        <span>/</span>
        <span class="text-warmOrange-400 truncate max-w-xs">{album.title}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-bold uppercase tracking-wider mb-3">
            <span>Bộ Sưu Tập Tư Liệu</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight" set:html={album.title}>
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 flex items-center space-x-3 flex-wrap gap-y-1">
            <span>Trường THPT Xuân Lộc</span>
            <span>•</span>
            <span class="font-semibold text-warmOrange-400">{album.photoCount} bức ảnh gốc độ nét cao</span>
            <span>•</span>
            <span class="inline-flex items-center gap-1 text-slate-300 bg-white/10 px-2.5 py-0.5 rounded-full text-xs font-semibold backdrop-blur-xs">
              <span>👁️</span>
              <span id="album-views-count">...</span> lượt xem
            </span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <a
            href="/albums"
            class="px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-200 bg-navy-900/80 hover:bg-navy-800 border border-navy-700 transition flex items-center space-x-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Tất Cả Album</span>
          </a>

          <!-- Quick Slideshow Start Button -->
          <button
            id="btn-slideshow-start"
            class="px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-lg shadow-warmOrange-500/25 transition flex items-center space-x-2 transform active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Chạy Trình Chiếu Tự Động</span>
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Photo Gallery Grid -->
  <section class="py-12 bg-slate-50 min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-6">
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          Nhấp vào từng ảnh để mở chế độ xem toàn màn hình hoặc bấm <strong>"Chạy Trình Chiếu"</strong> để tự động chuyển ảnh với hiệu ứng mượt mà.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="gallery-container">
        {album.photos.map((photo, index) => (
          <div
            class="gallery-item group relative bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-2xl transition-all duration-300 cursor-pointer aspect-[4/3]"
            data-index={index}
            data-src={photo.src}
            data-caption={photo.caption}
          >
            <img
              src={photo.src}
              alt={photo.caption}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            
            <!-- Hover Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-3.5">
              <div class="flex justify-end">
                <span class="p-1.5 rounded-lg bg-white/20 backdrop-blur-md text-white text-xs">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </span>
              </div>
              <div class="text-white">
                <span class="text-xs font-semibold block text-warmOrange-300">Ảnh {index + 1} / {album.photoCount}</span>
                <span class="text-xs text-slate-200 line-clamp-1">{photo.caption}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Social Interaction Bar for Album (Like, Share, Comment Count) -->
      <div class="mt-10 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <!-- Nút Thích Album -->
          <button
            id="btn-album-like"
            class="flex-1 sm:flex-initial px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition flex items-center justify-center gap-2 cursor-pointer bg-white border-rose-200 text-rose-600 hover:bg-rose-50 shadow-xs"
            data-slug={album.slug}
          >
            <span id="album-like-icon" class="text-base">❤️</span>
            <span id="album-like-text">Yêu thích</span>
            <span id="album-like-count" class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 text-xs font-extrabold">0</span>
          </button>

          <!-- Nút Chia sẻ Album -->
          <button
            id="btn-album-share"
            class="flex-1 sm:flex-initial px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition flex items-center justify-center gap-2 cursor-pointer bg-white border-blue-200 text-blue-600 hover:bg-blue-50 shadow-xs"
            data-title={album.title}
          >
            <span>🔗</span>
            <span>Chia sẻ album</span>
          </button>
        </div>

        <div class="text-xs sm:text-sm font-semibold text-slate-600 flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
            <span>👁️</span>
            <span id="album-footer-views">... lượt xem</span>
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
            <span>💬</span>
            <span id="album-comments-badge">0 bình luận</span>
          </span>
        </div>
      </div>

      <!-- Share Toast Feedback -->
      <div id="album-share-toast" class="hidden mt-3 p-3 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-medium flex items-center gap-2">
        <span>✅</span>
        <span>Đã sao chép liên kết album ảnh vào bộ nhớ tạm!</span>
      </div>

      <!-- Real-time Comments Section for Album -->
      <div class="mt-8 bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-10 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <h3 class="text-lg sm:text-xl font-bold text-navy-950 flex items-center gap-2">
            <span>💬</span>
            <span>Bình Luận & Kỷ Niệm Về Album</span>
          </h3>
          <span class="text-xs text-slate-400 font-medium">Kho Kỷ Niệm THPT Xuân Lộc</span>
        </div>

        <!-- Login Prompt if Not Logged In -->
        <div id="album-comment-login-box" class="bg-slate-50 border border-slate-200 rounded-2xl p-6 text-center space-y-3">
          <p class="text-xs sm:text-sm text-slate-700">
            Đăng nhập bằng tài khoản <strong>Google</strong> để để lại lời nhắn, cảm xúc và kỷ niệm cho album ảnh này.
          </p>
          <button
            id="btn-google-login-album"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-white border border-slate-300 text-slate-800 text-xs sm:text-sm font-bold hover:bg-slate-50 shadow-xs transition transform hover:-translate-y-0.5 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Đăng nhập với Google để bình luận</span>
          </button>
        </div>

        <!-- Logged In User Comment Form -->
        <div id="album-comment-form-box" class="hidden space-y-3 bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200">
          <div class="flex items-center justify-between text-xs text-slate-600">
            <div class="flex items-center gap-2 min-w-0">
              <img id="album-user-avatar" src="#" alt="User" class="w-6 h-6 rounded-full border border-slate-200" />
              <span class="font-bold text-navy-950 truncate" id="album-user-name"></span>
            </div>
            <button id="btn-logout-album" class="text-slate-400 hover:text-red-600 transition underline cursor-pointer">
              Đăng xuất
            </button>
          </div>

          <form id="album-comment-form" class="space-y-2.5">
            <textarea
              id="album-comment-input"
              rows="3"
              required
              placeholder="Chia sẻ cảm xúc, kỷ niệm gắn liền với các bức ảnh trong album này..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white resize-none"
            ></textarea>
            <div class="flex justify-end">
              <button
                type="submit"
                id="btn-submit-album-comment"
                class="px-5 py-2 rounded-xl font-bold text-white bg-navy-950 hover:bg-warmOrange-600 transition text-xs shadow-xs flex items-center gap-1.5 cursor-pointer"
              >
                <span id="album-comment-spinner" class="hidden inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                <span id="album-comment-btn-text">Gửi bình luận ✍️</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Comments Stream List -->
        <div class="space-y-4 pt-2" id="album-comments-list">
          <div class="text-center py-6 text-slate-400 text-xs italic" id="album-no-comments-msg">
            Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm xúc về album này!
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Related Albums Section -->
  <section class="py-14 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-warmOrange-600 mb-1">Ký ức đồng hành</div>
          <h2 class="text-2xl font-bold text-navy-900">Các Bộ Album Khác Bạn Sẽ Thích</h2>
        </div>
        <a href="/albums" class="text-sm font-semibold text-warmOrange-600 hover:text-warmOrange-700 flex items-center space-x-1">
          <span>Xem tất cả album</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedAlbums.map((rel) => (
          <div class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all duration-300 group flex flex-col justify-between">
            <a href={`/albums/${rel.slug}`} class="block h-44 overflow-hidden bg-slate-900 relative">
              <img
                src={rel.coverImage}
                alt={rel.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-navy-950/80 text-warmOrange-300 backdrop-blur-md">
                {rel.photoCount} ảnh
              </span>
            </a>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <h3 class="text-sm font-bold text-navy-900 group-hover:text-warmOrange-600 line-clamp-2 leading-snug mb-2">
                <a href={`/albums/${rel.slug}`} set:html={rel.title}></a>
              </h3>
              <div class="pt-2 border-t border-slate-200/60 flex items-center justify-end">
                <a href={`/albums/${rel.slug}`} class="text-xs font-bold text-warmOrange-600 hover:underline">
                  Xem ngay &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fullscreen Lightbox & Slideshow Modal with Pro Cross-Fade & Ken Burns Effects -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex flex-col justify-between select-none"
    tabindex="-1"
    role="dialog"
  >
    <!-- Top Control Bar -->
    <div class="flex flex-wrap items-center justify-between p-3 sm:px-6 border-b border-white/10 text-white z-30 gap-3 bg-black/70 backdrop-blur-md">
      
      <!-- Counter & Title -->
      <div class="flex items-center space-x-3 min-w-0">
        <span id="lightbox-counter" class="text-xs sm:text-sm font-bold text-warmOrange-400 bg-white/10 px-2.5 py-1 rounded-lg shrink-0 border border-white/10">1 / 10</span>
        <span id="lightbox-title" class="text-xs text-slate-200 hidden md:inline truncate max-w-sm font-medium">{album.title}</span>
      </div>

      <!-- Center: Slideshow & Transition Controls -->
      <div class="flex items-center space-x-2 flex-wrap gap-y-1">
        
        <!-- Play / Pause Slideshow Button -->
        <button
          id="btn-toggle-slideshow"
          class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-warmOrange-500 hover:bg-warmOrange-600 text-white transition shadow-sm cursor-pointer"
          title="Bật/Tắt tự động chạy slide (Phím Space)"
        >
          <span id="icon-play-state">▶</span>
          <span id="label-play-state">Chạy Slide</span>
        </button>

        <!-- Toggle Effect Checkbox -->
        <label class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-medium text-slate-200 cursor-pointer transition select-none border border-white/10">
          <input
            type="checkbox"
            id="toggle-effect-checkbox"
            checked
            class="rounded text-warmOrange-500 focus:ring-warmOrange-500 w-3.5 h-3.5 accent-warmOrange-500"
          />
          <span>Hiệu Ứng Điện Ảnh</span>
        </label>

        <!-- Effect Style Selector -->
        <select
          id="select-effect-style"
          class="px-2.5 py-1.5 rounded-xl bg-navy-950 border border-white/20 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-warmOrange-500 cursor-pointer"
        >
          <option value="fade">Mờ Dần Điện Ảnh (Cross Fade)</option>
          <option value="zoom">Thu Phóng Điện Ảnh (Ken Burns)</option>
          <option value="slide">Trượt Ngang (Slide Smooth)</option>
          <option value="rotate">Xoay Lật 3D (3D Dynamic)</option>
        </select>
      </div>

      <!-- Right: Tools (Thumbnails Toggle, Zoom, Download, Close) -->
      <div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0">
        <!-- Toggle Thumbnails Button -->
        <button
          id="btn-toggle-thumbs"
          class="p-2 px-2.5 rounded-xl bg-white/10 hover:bg-warmOrange-600 text-white transition text-xs font-semibold border border-white/10 flex items-center gap-1.5 cursor-pointer"
          title="Hiện / Ẩn dải ảnh thu nhỏ (Thumbnails)"
        >
          <span>🖼️</span>
          <span class="hidden lg:inline text-xs">Dải ảnh</span>
        </button>

        <!-- Download Original Image -->
        <a
          id="lightbox-download"
          href="#"
          target="_blank"
          download
          class="p-2 px-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white transition text-xs font-semibold border border-white/10 flex items-center gap-1 cursor-pointer"
          title="Tải ảnh gốc về máy"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>

        <!-- Zoom Button -->
        <button
          id="lightbox-zoom"
          class="p-2 px-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white transition text-xs font-semibold border border-white/10 flex items-center gap-1 cursor-pointer"
          title="Phóng to / Thu nhỏ ảnh"
        >
          <span id="lightbox-zoom-icon">🔍</span>
        </button>

        <!-- Close Button -->
        <button
          id="lightbox-close"
          class="p-2 rounded-xl bg-rose-600/80 hover:bg-rose-600 text-white transition cursor-pointer border border-rose-500/50"
          title="Đóng (Phím Esc)"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main View Stage (Dual Layer for Seamless Transitions) -->
    <div class="flex-1 relative flex items-center justify-center p-2 sm:p-4 overflow-hidden perspective-1000 min-h-0">
      
      <!-- Previous Button -->
      <button
        id="lightbox-prev"
        class="absolute left-2 sm:left-6 z-30 p-3 sm:p-4 rounded-full bg-black/60 hover:bg-warmOrange-600 text-white backdrop-blur-md transition shadow-2xl border border-white/20 active:scale-90 cursor-pointer"
        aria-label="Ảnh trước"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Stage Layers Container -->
      <div id="image-stage" class="relative w-full h-full flex items-center justify-center overflow-hidden">
        
        <!-- Back Layer (Old Image for Cross-fade) -->
        <img
          id="lightbox-img-back"
          src=""
          alt=""
          class="absolute max-h-[70vh] sm:max-h-[75vh] max-w-[92vw] object-contain rounded-xl shadow-2xl opacity-0 pointer-events-none transition-all duration-300"
        />

        <!-- Front Layer (Active Image) -->
        <img
          id="lightbox-img-front"
          src=""
          alt=""
          class="relative max-h-[70vh] sm:max-h-[75vh] max-w-[92vw] object-contain rounded-xl shadow-2xl cursor-zoom-in select-none z-10 transition-transform duration-300"
        />
      </div>

      <!-- Next Button -->
      <button
        id="lightbox-next"
        class="absolute right-2 sm:right-6 z-30 p-3 sm:p-4 rounded-full bg-black/60 hover:bg-warmOrange-600 text-white backdrop-blur-md transition shadow-2xl border border-white/20 active:scale-90 cursor-pointer"
        aria-label="Ảnh kế tiếp"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Bottom Thumbnail Strip & Caption Container -->
    <div class="z-30 bg-black/80 backdrop-blur-md border-t border-white/10 flex flex-col justify-end">
      
      <!-- Caption & Hint Bar -->
      <div class="p-2 sm:px-6 text-center text-slate-300 text-xs flex items-center justify-between border-b border-white/5">
        <span class="text-[11px] text-slate-400 hidden sm:inline">Phím: ⬅ ➡ (Chuyển ảnh), Space (Chạy slide), Esc (Đóng)</span>
        <span id="lightbox-caption" class="text-xs text-warmOrange-300 font-semibold truncate mx-auto px-4"></span>
        <span class="text-[11px] text-slate-400 hidden sm:inline" id="slideshow-status-tag">Tự động: Tắt</span>
      </div>

      <!-- Thumbnail Carousel Strip (Filmstrip - Centered) -->
      <div id="lightbox-thumbs-container" class="py-2.5 px-3 sm:px-6 overflow-x-auto scrollbar-thin scrollbar-thumb-white/20 flex items-center justify-start sm:justify-center transition-all duration-300">
        <div class="flex items-center justify-center gap-2 sm:gap-3 mx-auto">
          {album.photos.map((photo, index) => (
            <button
              type="button"
              class="lightbox-thumb-btn shrink-0 w-14 h-14 sm:w-16 sm:h-16 rounded-xl overflow-hidden border-2 border-transparent opacity-50 hover:opacity-100 hover:scale-105 transition-all duration-200 cursor-pointer relative focus:outline-none"
              data-index={index}
              title={photo.caption || `Ảnh ${index + 1}`}
            >
              <img
                src={photo.src}
                alt={photo.caption || `Ảnh ${index + 1}`}
                loading="lazy"
                class="w-full h-full object-cover"
              />
              <span class="absolute bottom-0 right-0 bg-black/70 text-[9px] text-white px-1 rounded-tl-md font-mono">
                {index + 1}
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .perspective-1000 {
    perspective: 1200px;
  }

  /* CSS Keyframe Animations for Image Transitions */
  @keyframes anim-fade-in {
    0% { opacity: 0; transform: scale(0.96); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes anim-ken-burns {
    0% { opacity: 0; transform: scale(1.18); }
    30% { opacity: 1; }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes anim-slide-in {
    0% { opacity: 0; transform: translateX(80px); }
    100% { opacity: 1; transform: translateX(0); }
  }

  @keyframes anim-rotate-3d {
    0% { opacity: 0; transform: rotateY(50deg) scale(0.85); }
    100% { opacity: 1; transform: rotateY(0deg) scale(1); }
  }

  .trans-fade {
    animation: anim-fade-in 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .trans-zoom {
    animation: anim-ken-burns 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .trans-slide {
    animation: anim-slide-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .trans-rotate {
    animation: anim-rotate-3d 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }
</style>

<script>
  // Lightbox & Dual-Layer Pro Slideshow Logic
  const items = document.querySelectorAll('.gallery-item');
  const modal = document.getElementById('lightbox-modal');
  const frontImg = document.getElementById('lightbox-img-front') as HTMLImageElement;
  const backImg = document.getElementById('lightbox-img-back') as HTMLImageElement;
  const counter = document.getElementById('lightbox-counter');
  const caption = document.getElementById('lightbox-caption');
  const btnClose = document.getElementById('lightbox-close');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');
  const btnZoom = document.getElementById('lightbox-zoom');
  const btnStartSlideshow = document.getElementById('btn-slideshow-start');
  const btnToggleSlideshow = document.getElementById('btn-toggle-slideshow');
  const iconPlayState = document.getElementById('icon-play-state');
  const labelPlayState = document.getElementById('label-play-state');
  const toggleEffectCheckbox = document.getElementById('toggle-effect-checkbox') as HTMLInputElement | null;
  const selectEffectStyle = document.getElementById('select-effect-style') as HTMLSelectElement | null;
  const slideshowStatusTag = document.getElementById('slideshow-status-tag');

  const btnDownload = document.getElementById('lightbox-download') as HTMLAnchorElement | null;
  const btnToggleThumbs = document.getElementById('btn-toggle-thumbs');
  const thumbsContainer = document.getElementById('lightbox-thumbs-container');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.lightbox-thumb-btn');
  const zoomIcon = document.getElementById('lightbox-zoom-icon');

  let currentIndex = 0;
  let isZoomed = false;
  let isSlideshowPlaying = false;
  let slideshowTimer: any = null;
  const SLIDESHOW_INTERVAL = 3500; // 3.5 seconds per slide

  const photos: { src: string; caption: string }[] = [];

  items.forEach((item, idx) => {
    const src = item.getAttribute('data-src') || '';
    const cap = item.getAttribute('data-caption') || '';
    photos.push({ src, caption: cap });

    item.addEventListener('click', () => {
      openLightbox(idx, false);
    });
  });

  // Handle Thumbnail clicks
  thumbBtns.forEach((thumbBtn) => {
    thumbBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idxStr = thumbBtn.getAttribute('data-index');
      if (idxStr !== null) {
        const idx = parseInt(idxStr, 10);
        if (!isNaN(idx) && idx !== currentIndex) {
          currentIndex = idx;
          updateModalImage(true);
        }
      }
    });
  });

  // Toggle Thumbnail Strip
  btnToggleThumbs?.addEventListener('click', () => {
    if (thumbsContainer) {
      if (thumbsContainer.classList.contains('hidden')) {
        thumbsContainer.classList.remove('hidden');
        btnToggleThumbs.classList.add('bg-warmOrange-600');
        btnToggleThumbs.classList.remove('bg-white/10');
      } else {
        thumbsContainer.classList.add('hidden');
        btnToggleThumbs.classList.remove('bg-warmOrange-600');
        btnToggleThumbs.classList.add('bg-white/10');
      }
    }
  });

  function openLightbox(index: number, autoPlay: boolean = false) {
    if (!modal || !frontImg) return;
    currentIndex = index;
    updateModalImage(false); // First open without back layer
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    if (autoPlay) {
      startSlideshow();
    } else {
      stopSlideshow();
    }
  }

  function closeLightbox() {
    if (!modal) return;
    stopSlideshow();
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    resetZoom();
  }

  function updateModalImage(withTransition: boolean = true) {
    if (!frontImg || !photos[currentIndex]) return;
    
    const nextPhoto = photos[currentIndex];
    const hasEffects = toggleEffectCheckbox?.checked ?? true;
    const effectStyle = selectEffectStyle?.value || 'fade';

    // Update text metadata & download link
    if (counter) counter.textContent = `${currentIndex + 1} / ${photos.length}`;
    if (caption) caption.textContent = nextPhoto.caption;
    if (btnDownload) {
      btnDownload.href = nextPhoto.src;
      btnDownload.download = `xuan-loc-photo-${currentIndex + 1}.jpg`;
    }

    // Highlight active thumbnail and scroll into view smoothly
    thumbBtns.forEach((btn, i) => {
      if (i === currentIndex) {
        btn.classList.add('border-warmOrange-500', 'opacity-100', 'scale-110', 'shadow-lg', 'ring-2', 'ring-warmOrange-400');
        btn.classList.remove('border-transparent', 'opacity-50');
        btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      } else {
        btn.classList.remove('border-warmOrange-500', 'opacity-100', 'scale-110', 'shadow-lg', 'ring-2', 'ring-warmOrange-400');
        btn.classList.add('border-transparent', 'opacity-50');
      }
    });

    if (withTransition && hasEffects && backImg) {
      // Set back layer to current image
      backImg.src = frontImg.src;
      backImg.style.opacity = '1';

      // Reset animations on front image
      frontImg.classList.remove('trans-fade', 'trans-zoom', 'trans-slide', 'trans-rotate');
      void frontImg.offsetWidth; // Trigger DOM reflow

      // Load new source and trigger animation
      frontImg.src = nextPhoto.src;
      
      const animClass = `trans-${effectStyle}`;
      frontImg.classList.add(animClass);

      // Fade out back layer smoothly
      setTimeout(() => {
        if (backImg) backImg.style.opacity = '0';
      }, 300);
    } else {
      frontImg.classList.remove('trans-fade', 'trans-zoom', 'trans-slide', 'trans-rotate');
      frontImg.src = nextPhoto.src;
    }

    resetZoom();
  }

  function prevPhoto() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    updateModalImage(true);
  }

  function nextPhoto() {
    currentIndex = (currentIndex + 1) % photos.length;
    updateModalImage(true);
  }

  function startSlideshow() {
    isSlideshowPlaying = true;
    if (iconPlayState) iconPlayState.textContent = '⏸';
    if (labelPlayState) labelPlayState.textContent = 'Tạm Dừng';
    if (slideshowStatusTag) slideshowStatusTag.textContent = 'Tự động: Đang chạy (3.5s)';
    if (btnToggleSlideshow) {
      btnToggleSlideshow.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition shadow-sm cursor-pointer';
    }

    clearInterval(slideshowTimer);
    slideshowTimer = setInterval(() => {
      nextPhoto();
    }, SLIDESHOW_INTERVAL);
  }

  function stopSlideshow() {
    isSlideshowPlaying = false;
    clearInterval(slideshowTimer);
    slideshowTimer = null;
    if (iconPlayState) iconPlayState.textContent = '▶';
    if (labelPlayState) labelPlayState.textContent = 'Chạy Slide';
    if (slideshowStatusTag) slideshowStatusTag.textContent = 'Tự động: Tắt';
    if (btnToggleSlideshow) {
      btnToggleSlideshow.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-warmOrange-500 hover:bg-warmOrange-600 text-white transition shadow-sm cursor-pointer';
    }
  }

  function toggleSlideshow() {
    if (isSlideshowPlaying) {
      stopSlideshow();
    } else {
      startSlideshow();
    }
  }

  function toggleZoom() {
    if (!frontImg) return;
    if (isZoomed) {
      resetZoom();
    } else {
      frontImg.style.transform = 'scale(1.6)';
      frontImg.classList.remove('cursor-zoom-in');
      frontImg.classList.add('cursor-zoom-out');
      if (zoomIcon) zoomIcon.textContent = '➖';
      isZoomed = true;
      stopSlideshow();
    }
  }

  function resetZoom() {
    if (!frontImg) return;
    frontImg.style.transform = 'scale(1)';
    frontImg.classList.remove('cursor-zoom-out');
    frontImg.classList.add('cursor-zoom-in');
    if (zoomIcon) zoomIcon.textContent = '🔍';
    isZoomed = false;
  }

  // Event Listeners
  btnClose?.addEventListener('click', closeLightbox);
  btnPrev?.addEventListener('click', (e) => { 
    e.stopPropagation(); 
    prevPhoto(); 
    if (isSlideshowPlaying) startSlideshow();
  });
  btnNext?.addEventListener('click', (e) => { 
    e.stopPropagation(); 
    nextPhoto(); 
    if (isSlideshowPlaying) startSlideshow();
  });
  btnZoom?.addEventListener('click', toggleZoom);
  frontImg?.addEventListener('click', toggleZoom);
  
  btnStartSlideshow?.addEventListener('click', () => openLightbox(0, true));
  btnToggleSlideshow?.addEventListener('click', toggleSlideshow);

  toggleEffectCheckbox?.addEventListener('change', () => {
    if (selectEffectStyle) {
      selectEffectStyle.disabled = !toggleEffectCheckbox.checked;
      selectEffectStyle.style.opacity = toggleEffectCheckbox.checked ? '1' : '0.4';
    }
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === ' ') {
      e.preventDefault();
      toggleSlideshow();
    }
  });

  // --- SOCIAL INTERACTION & REAL-TIME COMMENTS LOGIC (Firebase) ---
  import { auth, googleProvider, db } from '../../lib/firebase';
  import { signInWithPopup, signOut, onAuthStateChanged, type User } from 'firebase/auth';
  import { 
    doc, 
    getDoc, 
    setDoc, 
    updateDoc, 
    increment, 
    collection, 
    addDoc, 
    query, 
    orderBy, 
    onSnapshot, 
    serverTimestamp 
  } from 'firebase/firestore';

  const btnLike = document.getElementById('btn-album-like') as HTMLButtonElement | null;
  const albumSlug = btnLike?.getAttribute('data-slug') || window.location.pathname.split('/').filter(Boolean).pop() || '';
  const viewsHeader = document.getElementById('album-views-count');
  const viewsFooter = document.getElementById('album-footer-views');
  const likeIcon = document.getElementById('album-like-icon');
  const likeText = document.getElementById('album-like-text');
  const likeCount = document.getElementById('album-like-count');
  const btnShare = document.getElementById('btn-album-share');
  const shareToast = document.getElementById('album-share-toast');
  const commentsBadge = document.getElementById('album-comments-badge');

  const loginBox = document.getElementById('album-comment-login-box');
  const formBox = document.getElementById('album-comment-form-box');
  const btnGoogleLogin = document.getElementById('btn-google-login-album');
  const btnLogout = document.getElementById('btn-logout-album');
  const userAvatar = document.getElementById('album-user-avatar') as HTMLImageElement | null;
  const userName = document.getElementById('album-user-name');
  const commentForm = document.getElementById('album-comment-form') as HTMLFormElement | null;
  const commentInput = document.getElementById('album-comment-input') as HTMLTextAreaElement | null;
  const btnSubmitComment = document.getElementById('btn-submit-album-comment') as HTMLButtonElement | null;
  const commentSpinner = document.getElementById('album-comment-spinner');
  const commentBtnText = document.getElementById('album-comment-btn-text');
  const commentsList = document.getElementById('album-comments-list');

  let currentUser: User | null = null;
  let currentLikes = 0;

  // Track Liked albums in LocalStorage
  function getLikedAlbums(): string[] {
    try {
      return JSON.parse(localStorage.getItem('chs_liked_albums') || '[]');
    } catch {
      return [];
    }
  }

  function setLikedAlbum(slug: string) {
    const liked = getLikedAlbums();
    if (!liked.includes(slug)) {
      liked.push(slug);
      localStorage.setItem('chs_liked_albums', JSON.stringify(liked));
    }
  }

  // Auth Listener
  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (currentUser) {
      if (loginBox) loginBox.classList.add('hidden');
      if (formBox) formBox.classList.remove('hidden');
      if (userAvatar) userAvatar.src = currentUser.photoURL || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + currentUser.uid;
      if (userName) userName.textContent = currentUser.displayName || currentUser.email || 'Thành viên';
    } else {
      if (loginBox) loginBox.classList.remove('hidden');
      if (formBox) formBox.classList.add('hidden');
    }
  });

  btnGoogleLogin?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập Google thất bại: ' + (err.message || 'Lỗi kết nối'));
    }
  });

  btnLogout?.addEventListener('click', async () => {
    try {
      await signOut(auth);
    } catch (err) {
      console.error(err);
    }
  });

  // Initialize Album Meta Stats (Views, Likes & Comments)
  async function initAlbumStats() {
    if (!albumSlug) return;
    const statsRef = doc(db, 'album_stats', albumSlug);

    try {
      // 1. Ghi nhận lượt xem (Views) một lần mỗi session
      const viewedKey = 'chs_viewed_albums';
      const viewed: string[] = JSON.parse(sessionStorage.getItem(viewedKey) || '[]');
      let isNewView = false;
      if (!viewed.includes(albumSlug)) {
        viewed.push(albumSlug);
        sessionStorage.setItem(viewedKey, JSON.stringify(viewed));
        isNewView = true;
      }

      const snap = await getDoc(statsRef);
      if (!snap.exists()) {
        const initialViews = isNewView ? 1 : 0;
        await setDoc(statsRef, { viewsCount: initialViews, likesCount: 0, commentsCount: 0 });
        if (viewsHeader) viewsHeader.textContent = String(initialViews);
        if (viewsFooter) viewsFooter.textContent = `${initialViews} lượt xem`;
        currentLikes = 0;
      } else {
        const data = snap.data();
        let views = data.viewsCount || 0;
        if (isNewView) {
          views++;
          updateDoc(statsRef, { viewsCount: increment(1) }).catch(() => {});
        }
        if (viewsHeader) viewsHeader.textContent = String(views);
        if (viewsFooter) viewsFooter.textContent = `${views} lượt xem`;
        currentLikes = data.likesCount || 0;
      }

      // Update Like UI
      const isLiked = getLikedAlbums().includes(albumSlug);
      updateLikeUI(currentLikes, isLiked);

      // 2. Lắng nghe bình luận thời gian thực
      loadAlbumComments();

    } catch (err) {
      console.warn('Lỗi khởi tạo thống kê album:', err);
    }
  }

  function updateLikeUI(count: number, isLiked: boolean) {
    if (likeCount) likeCount.textContent = String(count);
    if (btnLike) {
      if (isLiked) {
        btnLike.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition flex items-center justify-center gap-2 cursor-pointer bg-rose-600 border-rose-600 text-white shadow-md active:scale-95';
        if (likeIcon) likeIcon.textContent = '❤️';
        if (likeText) likeText.textContent = 'Đã thích';
        if (likeCount) likeCount.className = 'px-2 py-0.5 rounded-full bg-rose-700 text-white text-xs font-extrabold';
      } else {
        btnLike.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition flex items-center justify-center gap-2 cursor-pointer bg-white border-rose-200 text-rose-600 hover:bg-rose-50 shadow-xs active:scale-95';
        if (likeIcon) likeIcon.textContent = '🤍';
        if (likeText) likeText.textContent = 'Yêu thích';
        if (likeCount) likeCount.className = 'px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 text-xs font-extrabold';
      }
    }
  }

  btnLike?.addEventListener('click', async () => {
    const statsRef = doc(db, 'album_stats', albumSlug);
    const liked = getLikedAlbums();
    const isLiked = liked.includes(albumSlug);

    try {
      if (!isLiked) {
        setLikedAlbum(albumSlug);
        currentLikes++;
        updateLikeUI(currentLikes, true);
        await updateDoc(statsRef, { likesCount: increment(1) });
      } else {
        const filtered = liked.filter(id => id !== albumSlug);
        localStorage.setItem('chs_liked_albums', JSON.stringify(filtered));
        currentLikes = Math.max(0, currentLikes - 1);
        updateLikeUI(currentLikes, false);
        await updateDoc(statsRef, { likesCount: increment(-1) });
      }
    } catch (err) {
      console.error(err);
    }
  });

  // Share Album handler
  btnShare?.addEventListener('click', async () => {
    const title = btnShare.getAttribute('data-title') || document.title;
    const shareUrl = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({
          title: title,
          text: `Xem album ảnh "${title}" trên Cổng thông tin THPT Xuân Lộc!`,
          url: shareUrl,
        });
        return;
      } catch {
        // Fallback to clipboard
      }
    }

    try {
      await navigator.clipboard.writeText(shareUrl);
      if (shareToast) {
        shareToast.classList.remove('hidden');
        setTimeout(() => shareToast.classList.add('hidden'), 3500);
      } else {
        alert('Đã sao chép liên kết album ảnh vào bộ nhớ tạm!');
      }
    } catch {
      prompt('Sao chép liên kết album ảnh:', shareUrl);
    }
  });

  // Comments Real-time Listener
  function loadAlbumComments() {
    if (!commentsList || !albumSlug) return;
    const commentsRef = collection(db, 'album_stats', albumSlug, 'comments');
    const q = query(commentsRef, orderBy('createdAt', 'desc'));

    onSnapshot(q, (snapshot) => {
      const count = snapshot.size;
      if (commentsBadge) commentsBadge.textContent = `${count} bình luận`;

      // Cập nhật commentsCount vào stats doc
      const statsRef = doc(db, 'album_stats', albumSlug);
      updateDoc(statsRef, { commentsCount: count }).catch(() => {});

      if (snapshot.empty) {
        commentsList.innerHTML = `
          <div class="text-center py-6 text-slate-400 text-xs italic" id="album-no-comments-msg">
            Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm xúc về album này!
          </div>
        `;
        return;
      }

      let html = '';
      snapshot.forEach((docSnap) => {
        const data = docSnap.data();
        let timeStr = 'Vừa xong';
        if (data.createdAt && data.createdAt.toDate) {
          const date = data.createdAt.toDate();
          timeStr = date.toLocaleDateString('vi-VN', {
            hour: '2-digit',
            minute: '2-digit',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
          });
        }

        const safeContent = (data.content || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\n/g, '<br/>');

        const userImg = data.userPhoto || `https://api.dicebear.com/7.x/bottts/svg?seed=${data.userId || 'chs'}`;

        html += `
          <div class="flex items-start gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-200/80 transition hover:bg-slate-100/50">
            <img src="${userImg}" alt="${data.userName || 'Cựu học sinh'}" class="w-8 h-8 rounded-full border border-slate-300 shrink-0 mt-0.5 object-cover" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
                <span class="font-bold text-navy-950 text-xs sm:text-sm truncate">${data.userName || 'Cựu học sinh'}</span>
                <span class="text-[11px] text-slate-400 font-medium">${timeStr}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed break-words">${safeContent}</p>
            </div>
          </div>
        `;
      });

      commentsList.innerHTML = html;
    });
  }

  // Submit Comment Form
  commentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentUser) {
      alert('Vui lòng đăng nhập Google để gửi bình luận!');
      return;
    }

    const text = commentInput?.value.trim();
    if (!text || !albumSlug) return;

    if (btnSubmitComment) btnSubmitComment.disabled = true;
    if (commentSpinner) commentSpinner.classList.remove('hidden');
    if (commentBtnText) commentBtnText.textContent = 'Đang gửi...';

    try {
      const commentsRef = collection(db, 'album_stats', albumSlug, 'comments');
      await addDoc(commentsRef, {
        userId: currentUser.uid,
        userName: currentUser.displayName || 'Cựu học sinh',
        userPhoto: currentUser.photoURL || '',
        content: text,
        createdAt: serverTimestamp()
      });

      if (commentInput) commentInput.value = '';
    } catch (err: any) {
      console.error(err);
      alert('Gửi bình luận thất bại: ' + (err.message || 'Lỗi kết nối Firestore'));
    } finally {
      if (btnSubmitComment) btnSubmitComment.disabled = false;
      if (commentSpinner) commentSpinner.classList.add('hidden');
      if (commentBtnText) commentBtnText.textContent = 'Gửi bình luận ✍️';
    }
  });

  // Khởi động load thống kê
  initAlbumStats();
</script>
