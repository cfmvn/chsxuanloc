---
import BaseLayout from '../../layouts/BaseLayout.astro';
import albumsData from '../../data/albums.json';

export async function getStaticPaths() {
  return albumsData.map((album) => ({
    params: { slug: album.slug },
    props: {
      album,
      relatedAlbums: albumsData.filter((a) => a.slug !== album.slug).slice(0, 4),
    },
  }));
}

interface Props {
  album: typeof albumsData[0];
  relatedAlbums: typeof albumsData;
}

const { album, relatedAlbums } = Astro.props;
---

<BaseLayout
  title={`${album.title} - Thư Viện Album Ảnh THPT Xuân Lộc`}
  description={`Xem trọn bộ album ảnh ${album.title} gồm ${album.photoCount} bức ảnh lưu niệm của Trường THPT Xuân Lộc.`}
  image={album.coverImage}
>
  <!-- Header Banner -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 text-white py-12 lg:py-16 border-b border-navy-800 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(221,107,32,0.15),transparent_50%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs font-medium text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-warmOrange-400 transition-colors">Trang Chủ</a>
        <span>/</span>
        <a href="/albums" class="hover:text-warmOrange-400 transition-colors">Thư Viện Ảnh</a>
        <span>/</span>
        <span class="text-warmOrange-400 truncate max-w-xs">{album.title}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-bold uppercase tracking-wider mb-3">
            <span>Bộ Sưu Tập Tư Liệu</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight" set:html={album.title}>
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 flex items-center space-x-3">
            <span>Trường THPT Xuân Lộc</span>
            <span>•</span>
            <span class="font-semibold text-warmOrange-400">{album.photoCount} bức ảnh gốc độ nét cao</span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <a
            href="/albums"
            class="px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-200 bg-navy-900/80 hover:bg-navy-800 border border-navy-700 transition flex items-center space-x-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Tất Cả Album</span>
          </a>

          <!-- Quick Slideshow Start Button -->
          <button
            id="btn-slideshow-start"
            class="px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-lg shadow-warmOrange-500/25 transition flex items-center space-x-2 transform active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Chạy Trình Chiếu Tự Động</span>
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Photo Gallery Grid -->
  <section class="py-12 bg-slate-50 min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-6">
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          Nhấp vào từng ảnh để mở chế độ xem toàn màn hình hoặc bấm <strong>"Chạy Trình Chiếu"</strong> để tự động chuyển ảnh với hiệu ứng mượt mà.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="gallery-container">
        {album.photos.map((photo, index) => (
          <div
            class="gallery-item group relative bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-2xl transition-all duration-300 cursor-pointer aspect-[4/3]"
            data-index={index}
            data-src={photo.src}
            data-caption={photo.caption}
          >
            <img
              src={photo.src}
              alt={photo.caption}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            
            <!-- Hover Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-3.5">
              <div class="flex justify-end">
                <span class="p-1.5 rounded-lg bg-white/20 backdrop-blur-md text-white text-xs">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </span>
              </div>
              <div class="text-white">
                <span class="text-xs font-semibold block text-warmOrange-300">Ảnh {index + 1} / {album.photoCount}</span>
                <span class="text-xs text-slate-200 line-clamp-1">{photo.caption}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Related Albums Section -->
  <section class="py-14 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-warmOrange-600 mb-1">Ký ức đồng hành</div>
          <h2 class="text-2xl font-bold text-navy-900">Các Bộ Album Khác Bạn Sẽ Thích</h2>
        </div>
        <a href="/albums" class="text-sm font-semibold text-warmOrange-600 hover:text-warmOrange-700 flex items-center space-x-1">
          <span>Xem tất cả album</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedAlbums.map((rel) => (
          <div class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all duration-300 group flex flex-col justify-between">
            <a href={`/albums/${rel.slug}`} class="block h-44 overflow-hidden bg-slate-900 relative">
              <img
                src={rel.coverImage}
                alt={rel.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-navy-950/80 text-warmOrange-300 backdrop-blur-md">
                {rel.photoCount} ảnh
              </span>
            </a>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <h3 class="text-sm font-bold text-navy-900 group-hover:text-warmOrange-600 line-clamp-2 leading-snug mb-2">
                <a href={`/albums/${rel.slug}`} set:html={rel.title}></a>
              </h3>
              <div class="pt-2 border-t border-slate-200/60 flex items-center justify-end">
                <a href={`/albums/${rel.slug}`} class="text-xs font-bold text-warmOrange-600 hover:underline">
                  Xem ngay &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fullscreen Lightbox & Slideshow Modal with Pro Transition Effects -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex flex-col justify-between select-none"
    tabindex="-1"
    role="dialog"
  >
    <!-- Top Control Bar -->
    <div class="flex flex-wrap items-center justify-between p-3 sm:px-6 border-b border-white/10 text-white z-20 gap-3 bg-black/40">
      
      <!-- Counter & Title -->
      <div class="flex items-center space-x-3">
        <span id="lightbox-counter" class="text-xs sm:text-sm font-bold text-warmOrange-400 bg-white/10 px-2.5 py-1 rounded-md">1 / 10</span>
        <span id="lightbox-title" class="text-xs text-slate-300 hidden md:inline truncate max-w-xs">{album.title}</span>
      </div>

      <!-- Center: Slideshow & Transition Controls -->
      <div class="flex items-center space-x-2">
        
        <!-- Play / Pause Slideshow Button -->
        <button
          id="btn-toggle-slideshow"
          class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-warmOrange-500 hover:bg-warmOrange-600 text-white transition shadow-sm"
          title="Bật/Tắt tự động chạy slide"
        >
          <span id="icon-play-state">▶</span>
          <span id="label-play-state">Chạy Slide</span>
        </button>

        <!-- Toggle Effect Checkbox (Mặc định là BẬT) -->
        <label class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-medium text-slate-200 cursor-pointer transition select-none">
          <input
            type="checkbox"
            id="toggle-effect-checkbox"
            checked
            class="rounded text-warmOrange-500 focus:ring-warmOrange-500 w-3.5 h-3.5 accent-warmOrange-500"
          />
          <span class="hidden sm:inline">Hiệu Ứng Chuyển Động</span>
          <span class="sm:hidden">Hiệu ứng</span>
        </label>

        <!-- Effect Style Selector (Chỉ hiện khi Effect bật) -->
        <select
          id="select-effect-style"
          class="px-2.5 py-1.5 rounded-lg bg-navy-900 border border-white/20 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-warmOrange-500"
        >
          <option value="fade">Hiệu ứng Mờ Dần (Smooth Fade)</option>
          <option value="zoom">Hiệu ứng Thu Phóng (Ken Burns)</option>
          <option value="slide">Hiệu ứng Trượt Ngang (Slide X)</option>
          <option value="flip">Hiệu ứng Lật 3D (Flip 3D)</option>
        </select>
      </div>

      <!-- Right: Zoom & Close -->
      <div class="flex items-center space-x-2">
        <button id="lightbox-zoom" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition text-xs font-semibold" title="Phóng to">
          🔍 <span class="hidden sm:inline">Phóng to</span>
        </button>
        <button id="lightbox-close" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition" title="Đóng (Esc)">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main View Stage -->
    <div class="flex-1 relative flex items-center justify-center p-2 sm:p-6 overflow-hidden perspective-1000">
      
      <!-- Previous Button -->
      <button
        id="lightbox-prev"
        class="absolute left-2 sm:left-6 z-30 p-3 rounded-full bg-black/50 hover:bg-warmOrange-600 text-white backdrop-blur-md transition shadow-lg border border-white/10 active:scale-90"
        aria-label="Ảnh trước"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Active Image Container with Transitions -->
      <div id="image-stage" class="relative max-h-[80vh] max-w-[92vw] flex items-center justify-center overflow-hidden">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[80vh] max-w-[92vw] object-contain rounded-lg shadow-2xl transition-all duration-700 ease-out cursor-zoom-in select-none"
        />
      </div>

      <!-- Next Button -->
      <button
        id="lightbox-next"
        class="absolute right-2 sm:right-6 z-30 p-3 rounded-full bg-black/50 hover:bg-warmOrange-600 text-white backdrop-blur-md transition shadow-lg border border-white/10 active:scale-90"
        aria-label="Ảnh kế tiếp"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Bottom Caption Bar -->
    <div class="p-3 text-center border-t border-white/10 text-slate-300 text-xs z-20 bg-black/50 flex items-center justify-between px-4 sm:px-8">
      <span class="text-[11px] text-slate-400 hidden sm:inline">Phím tắt: ⬅ ➡ (Chuyển ảnh), Space (Chạy/Dừng slide), Esc (Thoát)</span>
      <span id="lightbox-caption" class="text-xs text-warmOrange-200 font-medium truncate mx-auto"></span>
      <span class="text-[11px] text-slate-400 hidden sm:inline" id="slideshow-status-tag">Tự động: Tắt</span>
    </div>
  </div>
</BaseLayout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }

  /* Transition Classes */
  .effect-fade-enter {
    opacity: 0;
    transform: scale(0.98);
  }
  .effect-fade-active {
    opacity: 1;
    transform: scale(1);
  }

  .effect-zoom-enter {
    opacity: 0;
    transform: scale(1.15);
  }
  .effect-zoom-active {
    opacity: 1;
    transform: scale(1);
  }

  .effect-slide-enter {
    opacity: 0;
    transform: translateX(60px);
  }
  .effect-slide-active {
    opacity: 1;
    transform: translateX(0);
  }

  .effect-flip-enter {
    opacity: 0;
    transform: rotateY(90deg) scale(0.9);
  }
  .effect-flip-active {
    opacity: 1;
    transform: rotateY(0deg) scale(1);
  }
</style>

<script>
  // Lightbox & Pro Slideshow Logic
  const items = document.querySelectorAll('.gallery-item');
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const counter = document.getElementById('lightbox-counter');
  const caption = document.getElementById('lightbox-caption');
  const btnClose = document.getElementById('lightbox-close');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');
  const btnZoom = document.getElementById('lightbox-zoom');
  const btnStartSlideshow = document.getElementById('btn-slideshow-start');
  const btnToggleSlideshow = document.getElementById('btn-toggle-slideshow');
  const iconPlayState = document.getElementById('icon-play-state');
  const labelPlayState = document.getElementById('label-play-state');
  const toggleEffectCheckbox = document.getElementById('toggle-effect-checkbox') as HTMLInputElement | null;
  const selectEffectStyle = document.getElementById('select-effect-style') as HTMLSelectElement | null;
  const slideshowStatusTag = document.getElementById('slideshow-status-tag');

  let currentIndex = 0;
  let isZoomed = false;
  let isSlideshowPlaying = false;
  let slideshowTimer: any = null;
  const SLIDESHOW_INTERVAL = 3200; // 3.2s per slide

  const photos: { src: string; caption: string }[] = [];

  items.forEach((item, idx) => {
    const src = item.getAttribute('data-src') || '';
    const cap = item.getAttribute('data-caption') || '';
    photos.push({ src, caption: cap });

    item.addEventListener('click', () => {
      openLightbox(idx);
    });
  });

  function openLightbox(index: number, autoPlay: boolean = false) {
    if (!modal || !modalImg) return;
    currentIndex = index;
    updateModalImage();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    if (autoPlay) {
      startSlideshow();
    } else {
      stopSlideshow();
    }
  }

  function closeLightbox() {
    if (!modal) return;
    stopSlideshow();
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    resetZoom();
  }

  function applyImageTransition() {
    if (!modalImg) return;
    const hasEffects = toggleEffectCheckbox?.checked ?? true;
    const effectStyle = selectEffectStyle?.value || 'fade';

    if (!hasEffects) {
      modalImg.className = 'max-h-[80vh] max-w-[92vw] object-contain rounded-lg shadow-2xl cursor-zoom-in select-none';
      return;
    }

    // Reset base classes with transition
    modalImg.className = `max-h-[80vh] max-w-[92vw] object-contain rounded-lg shadow-2xl transition-all duration-700 ease-out cursor-zoom-in select-none effect-${effectStyle}-enter`;

    // Trigger reflow & animate in
    requestAnimationFrame(() => {
      modalImg.classList.remove(`effect-${effectStyle}-enter`);
      modalImg.classList.add(`effect-${effectStyle}-active`);
    });
  }

  function updateModalImage() {
    if (!modalImg || !photos[currentIndex]) return;
    
    modalImg.src = photos[currentIndex].src;
    if (counter) counter.textContent = `${currentIndex + 1} / ${photos.length}`;
    if (caption) caption.textContent = photos[currentIndex].caption;
    
    resetZoom();
    applyImageTransition();
  }

  function prevPhoto() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    updateModalImage();
  }

  function nextPhoto() {
    currentIndex = (currentIndex + 1) % photos.length;
    updateModalImage();
  }

  function startSlideshow() {
    isSlideshowPlaying = true;
    if (iconPlayState) iconPlayState.textContent = '⏸';
    if (labelPlayState) labelPlayState.textContent = 'Tạm Dừng';
    if (slideshowStatusTag) slideshowStatusTag.textContent = 'Tự động: Đang chạy (3s)';
    if (btnToggleSlideshow) {
      btnToggleSlideshow.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition shadow-sm';
    }

    clearInterval(slideshowTimer);
    slideshowTimer = setInterval(() => {
      nextPhoto();
    }, SLIDESHOW_INTERVAL);
  }

  function stopSlideshow() {
    isSlideshowPlaying = false;
    clearInterval(slideshowTimer);
    slideshowTimer = null;
    if (iconPlayState) iconPlayState.textContent = '▶';
    if (labelPlayState) labelPlayState.textContent = 'Chạy Slide';
    if (slideshowStatusTag) slideshowStatusTag.textContent = 'Tự động: Tắt';
    if (btnToggleSlideshow) {
      btnToggleSlideshow.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-warmOrange-500 hover:bg-warmOrange-600 text-white transition shadow-sm';
    }
  }

  function toggleSlideshow() {
    if (isSlideshowPlaying) {
      stopSlideshow();
    } else {
      startSlideshow();
    }
  }

  function toggleZoom() {
    if (!modalImg) return;
    if (isZoomed) {
      resetZoom();
    } else {
      modalImg.style.transform = 'scale(1.5)';
      modalImg.classList.remove('cursor-zoom-in');
      modalImg.classList.add('cursor-zoom-out');
      isZoomed = true;
      stopSlideshow(); // Pause slideshow when user is inspecting details
    }
  }

  function resetZoom() {
    if (!modalImg) return;
    modalImg.style.transform = 'scale(1)';
    modalImg.classList.remove('cursor-zoom-out');
    modalImg.classList.add('cursor-zoom-in');
    isZoomed = false;
  }

  // Event Listeners
  btnClose?.addEventListener('click', closeLightbox);
  btnPrev?.addEventListener('click', (e) => { 
    e.stopPropagation(); 
    prevPhoto(); 
    if (isSlideshowPlaying) startSlideshow(); // Reset interval
  });
  btnNext?.addEventListener('click', (e) => { 
    e.stopPropagation(); 
    nextPhoto(); 
    if (isSlideshowPlaying) startSlideshow(); // Reset interval
  });
  btnZoom?.addEventListener('click', toggleZoom);
  modalImg?.addEventListener('click', toggleZoom);
  
  btnStartSlideshow?.addEventListener('click', () => openLightbox(0, true));
  btnToggleSlideshow?.addEventListener('click', toggleSlideshow);

  toggleEffectCheckbox?.addEventListener('change', () => {
    if (selectEffectStyle) {
      selectEffectStyle.disabled = !toggleEffectCheckbox.checked;
      selectEffectStyle.style.opacity = toggleEffectCheckbox.checked ? '1' : '0.5';
    }
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === ' ') {
      e.preventDefault();
      toggleSlideshow();
    }
  });
</script>
