---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { GRADUATION_YEARS_SUMMARY, TOTAL_OFFICIAL_ALUMNI } from '../../data/officialAlumniSummary';
import { getCollection } from 'astro:content';

const batches = (await getCollection('batches')).sort((a, b) => b.data.startYear - a.data.startYear);
---

<BaseLayout
  title="Tra Cứu Danh Sách Cựu Học Sinh THPT Xuân Lộc (1986 – 2011)"
  description="Cơ sở dữ liệu chính thức gần 12.000 cựu học sinh Trường THPT Xuân Lộc tốt nghiệp qua 25 niên khóa từ năm 1986 đến năm 2011."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_70%_at_50%_-10%,rgba(221,107,32,0.18),rgba(255,255,255,0))]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Dữ Liệu Hồ Sơ Lưu Trữ Nhà Trường • 1986 – 2011</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Danh Bạ & Tra Cứu Cựu Học Sinh THPT Xuân Lộc
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed mb-6">
        Hệ thống tra cứu thông tin chính thức của <strong class="text-warmOrange-400 font-bold">{TOTAL_OFFICIAL_ALUMNI.toLocaleString()}</strong> cựu học sinh tốt nghiệp qua 25 khóa học (1986 – 2011).
      </p>

      <!-- Quick stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto pt-2 text-left">
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Tổng cựu học sinh</span>
          <span class="text-xl font-extrabold text-warmOrange-400">{TOTAL_OFFICIAL_ALUMNI.toLocaleString()}</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Số niên khóa lưu trữ</span>
          <span class="text-xl font-extrabold text-white">{GRADUATION_YEARS_SUMMARY.length} Khóa</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Giai đoạn lưu trữ</span>
          <span class="text-xl font-extrabold text-white">1986 – 2011</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Trạng thái hồ sơ</span>
          <span class="text-xl font-extrabold text-emerald-400">100% Chính thức</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Search & Explorer App -->
  <section class="py-10 bg-slate-50 min-h-[70vh]" id="app-tra-cuu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Toolbar: Select Year, Select Class & Search Name -->
      <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-navy-950 flex items-center gap-2">
              <span>🔍</span>
              <span>Bộ Lọc & Tra Cứu Danh Sách Học Sinh</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Chọn năm tốt nghiệp, lớp hoặc gõ tên để tra cứu danh sách bạn bè cùng khóa.</p>
          </div>

          <div class="flex items-center gap-3">
            <button
              id="open-wizard-btn"
              type="button"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-gradient-to-r from-warmOrange-500 to-amber-500 text-white text-xs font-bold shadow-md shadow-warmOrange-500/20 hover:from-warmOrange-600 hover:to-amber-600 transition transform active:scale-95"
            >
              <span>🧭</span>
              <span>Trợ Lý Tìm Lớp Của Bạn</span>
            </button>
            <span class="text-xs font-semibold text-slate-500 hidden sm:inline" id="status-loading-text">Đang tải dữ liệu hồ sơ...</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
          <!-- Select Year -->
          <div class="sm:col-span-4">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Năm Tốt Nghiệp / Niên Khóa</label>
            <select
              id="select-year"
              class="w-full px-3.5 py-2.5 rounded-2xl border border-slate-300 text-xs font-semibold text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
            >
              <option value="ALL">Tất cả các năm (1986 – 2011)</option>
              {GRADUATION_YEARS_SUMMARY.map(y => (
                <option value={y.year}>Năm {y.year} ({y.batch} • {y.totalStudents} HS)</option>
              ))}
            </select>
          </div>

          <!-- Select Class -->
          <div class="sm:col-span-3">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Lớp Học</label>
            <select
              id="select-class"
              class="w-full px-3.5 py-2.5 rounded-2xl border border-slate-300 text-xs font-semibold text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
            >
              <option value="ALL">Tất cả các lớp</option>
            </select>
          </div>

          <!-- Search Name -->
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Tìm Họ và Tên</label>
            <div class="relative">
              <input
                type="text"
                id="search-name"
                placeholder="Gõ họ tên cựu học sinh cần tìm..."
                class="w-full pl-9 pr-4 py-2.5 rounded-2xl border border-slate-300 text-xs font-medium text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
              />
              <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Year Badges Grid (Interactive Navigation) -->
      <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-navy-950 uppercase tracking-wider">Chọn Nhanh Niên Khóa:</span>
          <span class="text-[11px] text-slate-500">Bấm vào năm để xem toàn bộ danh sách</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="year-pills-container">
          <button
            class="year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs"
            data-year="ALL"
          >
            Tất Cả ({TOTAL_OFFICIAL_ALUMNI.toLocaleString()})
          </button>
          {GRADUATION_YEARS_SUMMARY.map(y => (
            <button
              class="year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80"
              data-year={y.year}
            >
              {y.year} <span class="text-[10px] text-slate-500">({y.totalStudents})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Results Table -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden space-y-0">
        <!-- Results header count & pagination summary -->
        <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h3 class="font-bold text-navy-950 text-sm" id="results-summary-title">
              Danh sách cựu học sinh
            </h3>
          </div>
          <div class="text-xs text-slate-500" id="pagination-info">
            Hiển thị 0 / 0 học sinh
          </div>
        </div>

        <!-- Table View -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 text-navy-900 font-bold uppercase tracking-wider text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3.5 px-4 sm:px-6 w-14 text-center">STT</th>
                <th class="py-3.5 px-4 sm:px-6">Họ và Tên Học Sinh</th>
                <th class="py-3.5 px-3 sm:px-4">Lớp</th>
                <th class="py-3.5 px-3 sm:px-4">Niên Khóa</th>
                <th class="py-3.5 px-3 sm:px-4">Ngày Sinh</th>
                <th class="py-3.5 px-3 sm:px-4">Giới Tính</th>
                <th class="py-3.5 px-4 sm:px-6">Nơi Sinh / Quê Quán</th>
                <th class="py-3.5 px-4 sm:px-6 text-center">Trạng Thái</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700" id="alumni-table-body">
              <tr>
                <td colspan="8" class="text-center py-12 text-slate-400">
                  Đang tải cơ sở dữ liệu cựu học sinh...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination Controls -->
        <div class="p-4 bg-slate-50/80 border-t border-slate-200 flex items-center justify-between gap-4">
          <button
            id="prev-page-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            &larr; Trang Trước
          </button>
          <span class="text-xs font-semibold text-slate-600" id="page-indicator">
            Trang 1 / 1
          </span>
          <button
            id="next-page-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Trang Sau &rarr;
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION: Card Kỷ Yếu Các Khóa -->
  <section class="py-10 bg-slate-50 border-t border-slate-200" id="ky-yeu-nien-khoa">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-navy-950 via-navy-900 to-navy-950 border border-navy-800 p-8 sm:p-10 shadow-xl text-white">
        <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:20px_20px] opacity-15 pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider">
              <span>🎓 Kỷ Yếu & Lưu Bút Các Niên Khóa (1986 – Hiện Nay)</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              Khám Phá Kỷ Yếu Các Khóa Đã Tốt Nghiệp
            </h2>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              Truy cập trang kỷ yếu tổng hợp để xem danh sách chi tiết các lớp học, hình ảnh kỷ niệm, lưu bút và thông điệp của từng niên khóa dưới mái trường THPT Xuân Lộc.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href="/nien-khoa"
              class="px-6 py-3.5 rounded-2xl font-bold text-white bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-lg shadow-warmOrange-500/25 transition transform hover:-translate-y-0.5 text-xs sm:text-sm flex items-center gap-2 group"
            >
              <span>Xem Kỷ Yếu Các Khóa</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
            <a
              href="/tam-su"
              class="px-5 py-3.5 rounded-2xl font-semibold text-slate-200 bg-navy-800/80 border border-navy-700 hover:bg-navy-700 hover:text-white transition text-xs sm:text-sm"
            >
              ✍️ Gửi Tâm Sự CHS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Submit Info Section for New/Unregistered Alumni -->
  <section class="py-16 bg-white border-t border-slate-200" id="dang-ky-thong-tin">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-2 mb-8">
        <div class="inline-flex items-center space-x-1 text-warmOrange-600 text-xs font-bold uppercase tracking-wider">
          <span>Bổ Sung & Cập Nhật Hồ Sơ</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Bạn Thuộc Khóa Sau 2011 Hoặc Muốn Cập Nhật?</h2>
        <p class="text-slate-500 text-xs sm:text-sm">
          Nếu bạn tốt nghiệp các khóa từ 2012 đến nay hoặc muốn bổ sung thông tin liên lạc (Nghề nghiệp, SĐT, Facebook), vui lòng gửi biểu mẫu dưới đây.
        </p>
      </div>

      <form id="alumni-register-form" class="bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Họ và Tên *</label>
            <input
              type="text"
              name="fullName"
              required
              placeholder="VD: Nguyễn Văn Nam"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Năm Tốt Nghiệp / Niên Khóa *</label>
            <input
              type="text"
              name="batch"
              required
              placeholder="VD: 2015 hoặc Khóa 2012 - 2015"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Lớp Học (VD: 12A1) *</label>
            <input
              type="text"
              name="className"
              required
              placeholder="VD: 12A1"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Thầy/Cô Giáo Viên Chủ Nhiệm</label>
            <input
              type="text"
              name="teacher"
              placeholder="VD: Thầy Luân / Cô Thủy..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Nghề Nghiệp / Đơn Vị Công Tác</label>
            <input
              type="text"
              name="job"
              placeholder="VD: Kỹ sư phần mềm / Bác sĩ / Doanh nhân..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Tỉnh Thành / Nơi Đang Sinh Sống *</label>
            <input
              type="text"
              name="location"
              required
              placeholder="VD: TP. Hồ Chí Minh / Đồng Nai..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Số Điện Thoại / Zalo (Tùy chọn)</label>
            <input
              type="tel"
              name="phone"
              placeholder="09xx xxx xxx"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email / Facebook (Tùy chọn)</label>
            <input
              type="text"
              name="facebook"
              placeholder="Email hoặc link Facebook..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div id="alumni-form-notice" class="hidden p-4 rounded-xl text-xs font-medium"></div>

        <button
          type="submit"
          id="alumni-submit-btn"
          class="w-full py-3.5 rounded-xl text-white font-bold text-sm bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-md shadow-warmOrange-500/20 transition transform active:scale-[0.99]"
        >
          Gửi Thông Tin Cập Nhật Danh Bạ
        </button>
      </form>
    </div>
  </section>

  <!-- Guided Wizard Modal -->
  <div
    id="guided-wizard-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-transform duration-300" id="wizard-modal-box">
      <!-- Header -->
      <div class="bg-gradient-to-r from-navy-900 to-navy-950 text-white p-6 relative">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <span class="w-10 h-10 rounded-2xl bg-warmOrange-500/20 border border-warmOrange-500/30 flex items-center justify-center text-xl">
              🎓
            </span>
            <div>
              <h3 class="text-base sm:text-lg font-bold">Hướng Dẫn Tìm Niên Khóa & Bạn Cùng Lớp</h3>
              <p class="text-xs text-slate-300">Trợ lý 3 bước giúp bạn tìm chính xác danh bạ học sinh</p>
            </div>
          </div>
          <button
            id="close-wizard-modal-btn"
            type="button"
            class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-white/10 transition text-lg leading-none"
            aria-label="Đóng"
          >
            ✕
          </button>
        </div>

        <!-- Progress Steps Indicator -->
        <div class="grid grid-cols-3 gap-2 mt-5">
          <div id="step-pill-1" class="h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300"></div>
          <div id="step-pill-2" class="h-1.5 rounded-full bg-navy-800 transition-all duration-300"></div>
          <div id="step-pill-3" class="h-1.5 rounded-full bg-navy-800 transition-all duration-300"></div>
        </div>
      </div>

      <!-- Step Contents -->
      <div class="p-6 sm:p-8 space-y-6">
        <!-- STEP 1: Chọn Năm Tốt Nghiệp Trực Quan -->
        <div id="wizard-step-1" class="space-y-4">
          <div class="space-y-1">
            <span class="text-xs font-bold text-warmOrange-600 uppercase tracking-wider">Bước 1 trên 2</span>
            <h4 class="text-lg font-bold text-navy-950">Chọn Năm Bạn Tốt Nghiệp THPT (Lớp 12):</h4>
            <p class="text-xs text-slate-500">Chỉ cần bấm trực tiếp vào năm tốt nghiệp của bạn dưới đây:</p>
          </div>

          <!-- Direct Grid of Year Buttons (Sorted Descending: 2011 -> 1986) -->
          <div class="grid grid-cols-4 sm:grid-cols-5 gap-2 max-h-64 overflow-y-auto p-1.5 bg-slate-50 rounded-2xl border border-slate-200/80" id="wizard-years-grid">
            {[...GRADUATION_YEARS_SUMMARY].reverse().map(y => (
              <button
                type="button"
                data-year={y.year}
                class="wizard-year-btn p-2.5 rounded-xl border border-slate-200 bg-white hover:border-warmOrange-400 hover:bg-warmOrange-50 text-navy-950 hover:text-warmOrange-900 transition text-center shadow-xs group"
              >
                <span class="block text-sm font-extrabold text-navy-900 group-hover:text-warmOrange-600">{y.year}</span>
                <span class="block text-[10px] text-slate-400 font-medium">{y.totalStudents} HS</span>
              </button>
            ))}
          </div>

          <!-- Quick helper for Birth Years -->
          <div class="p-3 bg-amber-50/60 rounded-2xl border border-amber-200/60 text-xs text-slate-600 flex items-start gap-2">
            <span class="text-base">💡</span>
            <div>
              <strong class="text-slate-800">Không nhớ năm tốt nghiệp?</strong>
              <p class="text-[11px] text-slate-500 mt-0.5">Quy tắc thông thường: <em>Năm Tốt Nghiệp = Năm Sinh + 18</em> (VD: Sinh năm 1989 &rarr; Tốt nghiệp 2007).</p>
            </div>
          </div>
        </div>

        <!-- STEP 2: Chọn Lớp Học -->
        <div id="wizard-step-2" class="space-y-4 hidden">
          <div class="space-y-1">
            <span class="text-xs font-bold text-warmOrange-600 uppercase tracking-wider">Bước 2 trên 3</span>
            <h4 class="text-lg font-bold text-navy-950">Bạn học lớp nào ở niên khóa <span id="wizard-selected-year-text" class="text-warmOrange-600 font-extrabold"></span>?</h4>
            <p class="text-xs text-slate-500">Bấm chọn một lớp cụ thể hoặc chọn xem tất cả các lớp của khóa này.</p>
          </div>

          <div class="space-y-3">
            <div id="wizard-classes-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-48 overflow-y-auto p-1">
              <!-- Rendered via JS -->
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <button
              id="wizard-step2-back-btn"
              type="button"
              class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-bold text-xs transition"
            >
              &larr; Chọn Lại Năm
            </button>
            <button
              id="wizard-step2-next-btn"
              type="button"
              class="px-6 py-2.5 rounded-xl bg-warmOrange-500 text-white font-bold text-xs hover:bg-warmOrange-600 transition shadow-sm"
            >
              Xem Danh Sách &rarr;
            </button>
          </div>
        </div>

        <!-- STEP 3: Xem Kết Quả & Tìm Bạn Cùng Lớp -->
        <div id="wizard-step-3" class="space-y-4 hidden text-center py-2">
          <div class="w-16 h-16 rounded-3xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-3xl shadow-inner">
            ✨
          </div>
          <div class="space-y-1">
            <h4 class="text-xl font-bold text-navy-950">Đã Sẵn Sàng Danh Sách Của Bạn!</h4>
            <p class="text-xs sm:text-sm text-slate-600 max-w-sm mx-auto">
              Hệ thống đã lọc sẵn danh sách: <br/>
              <strong id="wizard-summary-result" class="text-warmOrange-600 text-sm"></strong>
            </p>
          </div>

          <div class="pt-3 space-y-2">
            <button
              id="wizard-finish-btn"
              type="button"
              class="w-full py-3 rounded-2xl bg-gradient-to-r from-warmOrange-500 to-amber-600 text-white font-bold text-sm shadow-md shadow-warmOrange-500/20 hover:from-warmOrange-600 hover:to-amber-700 transition"
            >
              Mở Danh Sách Học Sinh Ngay
            </button>
            <button
              id="wizard-reset-btn"
              type="button"
              class="text-xs text-slate-500 hover:text-slate-700 font-medium py-1"
            >
              Bắt đầu lại từ đầu
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Cross Linking Footer -->
  <CrossLinkingNav currentModule="tim-ban" />
</BaseLayout>

<script>
  interface Alumnus {
    id: string;
    fullName: string;
    gradYear: number;
    batch: string;
    className: string;
    dob?: string;
    gender?: string;
    pob?: string;
  }

  let allAlumniData: Alumnus[] = [];
  let filteredList: Alumnus[] = [];
  let currentPage = 1;
  const pageSize = 50;

  const selectYear = document.getElementById('select-year') as HTMLSelectElement | null;
  const selectClass = document.getElementById('select-class') as HTMLSelectElement | null;
  const searchName = document.getElementById('search-name') as HTMLInputElement | null;
  const tableBody = document.getElementById('alumni-table-body');
  const summaryTitle = document.getElementById('results-summary-title');
  const paginationInfo = document.getElementById('pagination-info');
  const pageIndicator = document.getElementById('page-indicator');
  const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
  const statusLoading = document.getElementById('status-loading-text');
  const yearPillButtons = document.querySelectorAll<HTMLButtonElement>('.year-pill-btn');

  // Load JSON database asynchronously
  async function loadDatabase() {
    try {
      const res = await fetch('/data/official_alumni_all.json');
      if (!res.ok) throw new Error('Failed to load JSON');
      allAlumniData = await res.json();
      filteredList = allAlumniData;

      if (statusLoading) {
        statusLoading.textContent = `Đã tải ${allAlumniData.length.toLocaleString()} hồ sơ`;
        statusLoading.className = 'text-xs font-semibold text-emerald-600';
      }

      updateClassDropdown();
      restoreSavedPreferences();
      renderTable();
    } catch (err) {
      console.error(err);
      if (statusLoading) {
        statusLoading.textContent = 'Lỗi tải dữ liệu';
        statusLoading.className = 'text-xs font-semibold text-rose-600';
      }
    }
  }

  // Khôi phục tùy chọn đã lưu từ LocalStorage
  function restoreSavedPreferences() {
    try {
      const saved = localStorage.getItem('chs_saved_alumni_pref');
      if (saved) {
        const { year, className } = JSON.parse(saved);
        if (year && selectYear) {
          selectYear.value = year;
          updateClassDropdown();
          if (className && selectClass) {
            selectClass.value = className;
          }
          // Cập nhật pill năm
          yearPillButtons.forEach(b => {
            if (b.getAttribute('data-year') === year) {
              b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
            } else {
              b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
            }
          });
          applyFilters();
          return true;
        }
      }
    } catch (e) {
      console.error('Error reading saved preferences', e);
    }
    return false;
  }

  // Hàm sắp xếp tên lớp tự nhiên: A1 -> A2 -> A10 -> B1 -> C1 -> C13
  function naturalSortClasses(arr: string[]): string[] {
    return arr.sort((a, b) => {
      return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
    });
  }

  function updateClassDropdown() {
    if (!selectClass) return;
    const selectedYear = selectYear?.value || 'ALL';
    
    let classes: string[] = [];
    if (selectedYear === 'ALL') {
      classes = naturalSortClasses(Array.from(new Set(allAlumniData.map(a => a.className))).filter(Boolean));
    } else {
      const yr = parseInt(selectedYear, 10);
      classes = naturalSortClasses(Array.from(new Set(allAlumniData.filter(a => a.gradYear === yr).map(a => a.className))).filter(Boolean));
    }

    selectClass.innerHTML = '<option value="ALL">Tất cả các lớp</option>' + 
      classes.map(c => `<option value="${c}">Lớp ${c}</option>`).join('');
  }

  function applyFilters() {
    const selectedYear = selectYear?.value || 'ALL';
    const selectedClass = selectClass?.value || 'ALL';
    const query = searchName?.value.toLowerCase().trim() || '';

    filteredList = allAlumniData.filter(a => {
      const matchYear = selectedYear === 'ALL' || a.gradYear.toString() === selectedYear;
      const matchClass = selectedClass === 'ALL' || a.className.toLowerCase() === selectedClass.toLowerCase();
      const matchName = query === '' || a.fullName.toLowerCase().includes(query) || (a.pob && a.pob.toLowerCase().includes(query));
      return matchYear && matchClass && matchName;
    });

    currentPage = 1;
    renderTable();
  }

  function renderTable() {
    if (!tableBody) return;

    const total = filteredList.length;
    const totalPages = Math.ceil(total / pageSize) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, total);
    const pageItems = filteredList.slice(startIndex, endIndex);

    // Update summaries
    if (summaryTitle) {
      const yr = selectYear?.value;
      summaryTitle.textContent = yr && yr !== 'ALL'
        ? `Danh sách cựu học sinh tốt nghiệp năm ${yr} (${total.toLocaleString()} học sinh)`
        : `Toàn bộ danh sách cựu học sinh (${total.toLocaleString()} học sinh)`;
    }

    if (paginationInfo) {
      paginationInfo.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên tổng số ${total.toLocaleString()} học sinh`;
    }

    if (pageIndicator) {
      pageIndicator.textContent = `Trang ${currentPage} / ${totalPages}`;
    }

    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

    if (pageItems.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-12 text-slate-500">
            <span class="text-2xl block mb-2">🔍</span>
            <strong>Không tìm thấy cựu học sinh phù hợp với bộ lọc.</strong>
            <p class="text-xs text-slate-400 mt-1">Hãy thử xóa bớt từ khóa hoặc chọn năm tốt nghiệp khác.</p>
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = pageItems.map((item, idx) => `
      <tr class="hover:bg-slate-50/80 transition">
        <td class="py-3 px-4 sm:px-6 font-semibold text-slate-400 text-center">${startIndex + idx + 1}</td>
        <td class="py-3 px-4 sm:px-6 font-bold text-navy-950 whitespace-nowrap">${item.fullName}</td>
        <td class="py-3 px-3 sm:px-4 whitespace-nowrap">
          <span class="px-2 py-0.5 rounded-md bg-navy-50 text-navy-800 text-xs font-bold border border-navy-100">
            ${item.className}
          </span>
        </td>
        <td class="py-3 px-3 sm:px-4 text-xs font-semibold text-warmOrange-600 whitespace-nowrap">${item.batch}</td>
        <td class="py-3 px-3 sm:px-4 text-xs text-slate-600 whitespace-nowrap">${item.dob || '-'}</td>
        <td class="py-3 px-3 sm:px-4 text-xs text-slate-600 whitespace-nowrap">${item.gender || '-'}</td>
        <td class="py-3 px-4 sm:px-6 text-xs text-slate-600">${item.pob || '-'}</td>
        <td class="py-3 px-4 sm:px-6 text-center whitespace-nowrap">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
            Hồ sơ gốc
          </span>
        </td>
      </tr>
    `).join('');
  }

  // Event Listeners
  selectYear?.addEventListener('change', () => {
    updateClassDropdown();
    // Update pill styles
    const val = selectYear.value;
    yearPillButtons.forEach(btn => {
      if (btn.getAttribute('data-year') === val) {
        btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
      } else {
        btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
      }
    });
    applyFilters();
  });

  selectClass?.addEventListener('change', applyFilters);
  searchName?.addEventListener('input', applyFilters);

  yearPillButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const year = btn.getAttribute('data-year') || 'ALL';
      if (selectYear) selectYear.value = year;
      updateClassDropdown();
      yearPillButtons.forEach(b => {
        b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
      });
      btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
      applyFilters();
    });
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderTable();
      document.getElementById('app-tra-cuu')?.scrollIntoView({ behavior: 'smooth' });
    }
  });

  nextBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredList.length / pageSize) || 1;
    if (currentPage < totalPages) {
      currentPage++;
      renderTable();
      document.getElementById('app-tra-cuu')?.scrollIntoView({ behavior: 'smooth' });
    }
  });

  // Load database on DOM ready
  document.addEventListener('DOMContentLoaded', loadDatabase);

  // Form submission
  const form = document.getElementById('alumni-register-form') as HTMLFormElement | null;
  const notice = document.getElementById('alumni-form-notice');
  const submitBtn = document.getElementById('alumni-submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!submitBtn || !notice) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Đang lưu danh bạ...';

    setTimeout(() => {
      notice.className = 'p-4 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
      notice.innerHTML = '🎉 <strong>Gửi thông tin thành công!</strong> Cảm ơn bạn. Thông tin cập nhật của bạn đã được ghi nhận vào hệ thống Danh bạ Cựu học sinh THPT Xuân Lộc.';
      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Gửi Thông Tin Cập Nhật Danh Bạ';
    }, 700);
  });

  // ==========================================
  // WIZARD MODAL INTERACTION LOGIC
  // ==========================================
  const wizardModal = document.getElementById('guided-wizard-modal');
  const wizardBox = document.getElementById('wizard-modal-box');
  const openWizardBtn = document.getElementById('open-wizard-btn');
  const closeWizardBtn = document.getElementById('close-wizard-modal-btn');

  const stepPill1 = document.getElementById('step-pill-1');
  const stepPill2 = document.getElementById('step-pill-2');
  const stepPill3 = document.getElementById('step-pill-3');

  const step1 = document.getElementById('wizard-step-1');
  const step2 = document.getElementById('wizard-step-2');
  const step3 = document.getElementById('wizard-step-3');

  const wizardYearSelect = document.getElementById('wizard-year-select') as HTMLSelectElement | null;
  const wizardStep1NextBtn = document.getElementById('wizard-step1-next-btn') as HTMLButtonElement | null;
  const wizardSelectedYearText = document.getElementById('wizard-selected-year-text');
  const wizardClassesGrid = document.getElementById('wizard-classes-grid');
  const wizardStep2BackBtn = document.getElementById('wizard-step2-back-btn');
  const wizardStep2NextBtn = document.getElementById('wizard-step2-next-btn');
  const wizardSummaryResult = document.getElementById('wizard-summary-result');
  const wizardFinishBtn = document.getElementById('wizard-finish-btn');
  const wizardResetBtn = document.getElementById('wizard-reset-btn');
  const wizardYearBtns = document.querySelectorAll<HTMLButtonElement>('.wizard-year-btn');

  let wizardSelectedYear = '';
  let wizardSelectedClass = 'ALL';

  function openWizard() {
    if (!wizardModal || !wizardBox) return;
    wizardModal.classList.remove('hidden');
    setTimeout(() => {
      wizardModal.classList.remove('opacity-0');
      wizardBox.classList.remove('scale-95');
      wizardBox.classList.add('scale-100');
    }, 10);
  }

  function closeWizard() {
    if (!wizardModal || !wizardBox) return;
    wizardModal.classList.add('opacity-0');
    wizardBox.classList.remove('scale-100');
    wizardBox.classList.add('scale-95');
    setTimeout(() => {
      wizardModal.classList.add('hidden');
    }, 300);
  }

  function goToStep(stepNum: number) {
    if (!step1 || !step2 || !step3 || !stepPill1 || !stepPill2 || !stepPill3) return;
    
    // Hide all steps
    step1.classList.add('hidden');
    step2.classList.add('hidden');
    step3.classList.add('hidden');

    // Reset indicator colors
    stepPill1.className = 'h-1.5 rounded-full bg-navy-800 transition-all duration-300';
    stepPill2.className = 'h-1.5 rounded-full bg-navy-800 transition-all duration-300';
    stepPill3.className = 'h-1.5 rounded-full bg-navy-800 transition-all duration-300';

    if (stepNum === 1) {
      step1.classList.remove('hidden');
      stepPill1.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';
    } else if (stepNum === 2) {
      step2.classList.remove('hidden');
      stepPill1.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';
      stepPill2.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';
      populateWizardClasses();
    } else if (stepNum === 3) {
      step3.classList.remove('hidden');
      stepPill1.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';
      stepPill2.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';
      stepPill3.className = 'h-1.5 rounded-full bg-warmOrange-500 transition-all duration-300';

      if (wizardSummaryResult) {
        const classLabel = wizardSelectedClass === 'ALL' ? 'Tất cả các lớp' : `Lớp ${wizardSelectedClass}`;
        wizardSummaryResult.textContent = `Năm Tốt Nghiệp ${wizardSelectedYear} • ${classLabel}`;
      }
    }
  }

  function populateWizardClasses() {
    if (!wizardClassesGrid || !wizardSelectedYear) return;
    if (wizardSelectedYearText) wizardSelectedYearText.textContent = wizardSelectedYear;

    const yr = parseInt(wizardSelectedYear, 10);
    const classes = naturalSortClasses(Array.from(new Set(allAlumniData.filter(a => a.gradYear === yr).map(a => a.className))).filter(Boolean));

    wizardClassesGrid.innerHTML = `
      <button
        type="button"
        data-class="ALL"
        class="wizard-class-btn p-3 rounded-2xl border text-xs font-bold text-center transition ${wizardSelectedClass === 'ALL' ? 'border-warmOrange-500 bg-warmOrange-50 text-warmOrange-900 shadow-sm ring-2 ring-warmOrange-400' : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-700'}"
      >
        🌟 Tất cả các lớp (${allAlumniData.filter(a => a.gradYear === yr).length} HS)
      </button>
      ${classes.map(c => {
        const count = allAlumniData.filter(a => a.gradYear === yr && a.className === c).length;
        const isSelected = wizardSelectedClass === c;
        return `
          <button
            type="button"
            data-class="${c}"
            class="wizard-class-btn p-3 rounded-2xl border text-xs font-bold text-center transition ${isSelected ? 'border-warmOrange-500 bg-warmOrange-50 text-warmOrange-900 shadow-sm ring-2 ring-warmOrange-400' : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-700'}"
          >
            Lớp ${c}
            <span class="block text-[10px] font-medium text-slate-400 mt-0.5">${count} bạn</span>
          </button>
        `;
      }).join('')}
    `;

    wizardClassesGrid.querySelectorAll<HTMLButtonElement>('.wizard-class-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        wizardSelectedClass = btn.getAttribute('data-class') || 'ALL';
        // Tự động chuyển thẳng sang màn hình kết quả bước 3
        goToStep(3);
      });
    });
  }

  // Event Listeners for Wizard
  openWizardBtn?.addEventListener('click', () => {
    goToStep(1);
    openWizard();
  });

  closeWizardBtn?.addEventListener('click', closeWizard);

  wizardModal?.addEventListener('click', (e) => {
    if (e.target === wizardModal) closeWizard();
  });

  // Bấm vào 1 năm trong grid -> tự động chọn năm và chuyển sang bước 2 (chọn lớp) ngay lập tức!
  wizardYearBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const yr = btn.getAttribute('data-year') || '';
      if (!yr) return;
      wizardSelectedYear = yr;
      wizardSelectedClass = 'ALL';
      goToStep(2);
    });
  });

  wizardStep2BackBtn?.addEventListener('click', () => {
    goToStep(1);
  });

  wizardStep2NextBtn?.addEventListener('click', () => {
    goToStep(3);
  });

  wizardResetBtn?.addEventListener('click', () => {
    wizardSelectedYear = '';
    wizardSelectedClass = 'ALL';
    goToStep(1);
  });

  wizardFinishBtn?.addEventListener('click', () => {
    closeWizard();
    if (selectYear && wizardSelectedYear) {
      selectYear.value = wizardSelectedYear;
      updateClassDropdown();
      if (selectClass) selectClass.value = wizardSelectedClass;
      
      // Lưu vào LocalStorage của thiết bị
      try {
        localStorage.setItem('chs_saved_alumni_pref', JSON.stringify({
          year: wizardSelectedYear,
          className: wizardSelectedClass
        }));
      } catch (e) {
        console.error('Failed to save preferences', e);
      }

      // Update pill highlight
      yearPillButtons.forEach(b => {
        if (b.getAttribute('data-year') === wizardSelectedYear) {
          b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
        } else {
          b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
        }
      });

      applyFilters();
      setTimeout(() => {
        document.getElementById('app-tra-cuu')?.scrollIntoView({ behavior: 'smooth' });
      }, 350);
    }
  });

  // Tự động lưu nếu người dùng tự thay đổi bộ lọc trên giao diện
  selectYear?.addEventListener('change', () => {
    try {
      localStorage.setItem('chs_saved_alumni_pref', JSON.stringify({
        year: selectYear.value,
        className: selectClass?.value || 'ALL'
      }));
    } catch (e) {}
  });

  selectClass?.addEventListener('change', () => {
    try {
      localStorage.setItem('chs_saved_alumni_pref', JSON.stringify({
        year: selectYear?.value || 'ALL',
        className: selectClass.value
      }));
    } catch (e) {}
  });

  // Tự động kiểm tra: nếu chưa từng có thông tin lưu trữ dưới LocalStorage thì bật Modal ngay
  setTimeout(() => {
    const saved = localStorage.getItem('chs_saved_alumni_pref');
    if (!saved) {
      goToStep(1);
      openWizard();
    }
  }, 600);
</script>
