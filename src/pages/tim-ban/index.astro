---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossLinkingNav from '../../components/CrossLinkingNav.astro';
import { GRADUATION_YEARS_SUMMARY, TOTAL_OFFICIAL_ALUMNI } from '../../data/officialAlumniSummary';
---

<BaseLayout
  title="Tra Cứu Danh Sách Cựu Học Sinh THPT Xuân Lộc (1986 – 2011)"
  description="Cơ sở dữ liệu chính thức gần 12.000 cựu học sinh Trường THPT Xuân Lộc tốt nghiệp qua 25 niên khóa từ năm 1986 đến năm 2011."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_70%_at_50%_-10%,rgba(221,107,32,0.18),rgba(255,255,255,0))]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Dữ Liệu Hồ Sơ Lưu Trữ Nhà Trường • 1986 – 2011</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Danh Bạ & Tra Cứu Cựu Học Sinh THPT Xuân Lộc
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed mb-6">
        Hệ thống tra cứu thông tin chính thức của <strong class="text-warmOrange-400 font-bold">{TOTAL_OFFICIAL_ALUMNI.toLocaleString()}</strong> cựu học sinh tốt nghiệp qua 25 khóa học (1986 – 2011).
      </p>

      <!-- Quick stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto pt-2 text-left">
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Tổng cựu học sinh</span>
          <span class="text-xl font-extrabold text-warmOrange-400">{TOTAL_OFFICIAL_ALUMNI.toLocaleString()}</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Số niên khóa lưu trữ</span>
          <span class="text-xl font-extrabold text-white">{GRADUATION_YEARS_SUMMARY.length} Khóa</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Giai đoạn lưu trữ</span>
          <span class="text-xl font-extrabold text-white">1986 – 2011</span>
        </div>
        <div class="bg-navy-900/80 p-3.5 rounded-2xl border border-navy-800">
          <span class="text-[11px] text-slate-400 font-medium block">Trạng thái hồ sơ</span>
          <span class="text-xl font-extrabold text-emerald-400">100% Chính thức</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Search & Explorer App -->
  <section class="py-10 bg-slate-50 min-h-[70vh]" id="app-tra-cuu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Toolbar: Select Year, Select Class & Search Name -->
      <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-navy-950 flex items-center gap-2">
              <span>🔍</span>
              <span>Bộ Lọc & Tra Cứu Danh Sách Học Sinh</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Chọn năm tốt nghiệp, lớp hoặc gõ tên để tra cứu danh sách bạn bè cùng khóa.</p>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-500" id="status-loading-text">Đang tải dữ liệu hồ sơ...</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
          <!-- Select Year -->
          <div class="sm:col-span-4">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Năm Tốt Nghiệp / Niên Khóa</label>
            <select
              id="select-year"
              class="w-full px-3.5 py-2.5 rounded-2xl border border-slate-300 text-xs font-semibold text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
            >
              <option value="ALL">Tất cả các năm (1986 – 2011)</option>
              {GRADUATION_YEARS_SUMMARY.map(y => (
                <option value={y.year}>Năm {y.year} ({y.batch} • {y.totalStudents} HS)</option>
              ))}
            </select>
          </div>

          <!-- Select Class -->
          <div class="sm:col-span-3">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Lớp Học</label>
            <select
              id="select-class"
              class="w-full px-3.5 py-2.5 rounded-2xl border border-slate-300 text-xs font-semibold text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
            >
              <option value="ALL">Tất cả các lớp</option>
            </select>
          </div>

          <!-- Search Name -->
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Tìm Họ và Tên</label>
            <div class="relative">
              <input
                type="text"
                id="search-name"
                placeholder="Gõ họ tên cựu học sinh cần tìm..."
                class="w-full pl-9 pr-4 py-2.5 rounded-2xl border border-slate-300 text-xs font-medium text-navy-950 focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-slate-50 focus:bg-white transition"
              />
              <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Year Badges Grid (Interactive Navigation) -->
      <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-navy-950 uppercase tracking-wider">Chọn Nhanh Niên Khóa:</span>
          <span class="text-[11px] text-slate-500">Bấm vào năm để xem toàn bộ danh sách</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="year-pills-container">
          <button
            class="year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs"
            data-year="ALL"
          >
            Tất Cả ({TOTAL_OFFICIAL_ALUMNI.toLocaleString()})
          </button>
          {GRADUATION_YEARS_SUMMARY.map(y => (
            <button
              class="year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80"
              data-year={y.year}
            >
              {y.year} <span class="text-[10px] text-slate-500">({y.totalStudents})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Results Table -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden space-y-0">
        <!-- Results header count & pagination summary -->
        <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h3 class="font-bold text-navy-950 text-sm" id="results-summary-title">
              Danh sách cựu học sinh
            </h3>
          </div>
          <div class="text-xs text-slate-500" id="pagination-info">
            Hiển thị 0 / 0 học sinh
          </div>
        </div>

        <!-- Table View -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 text-navy-900 font-bold uppercase tracking-wider text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3.5 px-4 sm:px-6 w-14 text-center">STT</th>
                <th class="py-3.5 px-4 sm:px-6">Họ và Tên Học Sinh</th>
                <th class="py-3.5 px-3 sm:px-4">Lớp</th>
                <th class="py-3.5 px-3 sm:px-4">Niên Khóa</th>
                <th class="py-3.5 px-3 sm:px-4">Ngày Sinh</th>
                <th class="py-3.5 px-3 sm:px-4">Giới Tính</th>
                <th class="py-3.5 px-4 sm:px-6">Nơi Sinh / Quê Quán</th>
                <th class="py-3.5 px-4 sm:px-6 text-center">Trạng Thái</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700" id="alumni-table-body">
              <tr>
                <td colspan="8" class="text-center py-12 text-slate-400">
                  Đang tải cơ sở dữ liệu cựu học sinh...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination Controls -->
        <div class="p-4 bg-slate-50/80 border-t border-slate-200 flex items-center justify-between gap-4">
          <button
            id="prev-page-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            &larr; Trang Trước
          </button>
          <span class="text-xs font-semibold text-slate-600" id="page-indicator">
            Trang 1 / 1
          </span>
          <button
            id="next-page-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Trang Sau &rarr;
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Submit Info Section for New/Unregistered Alumni -->
  <section class="py-16 bg-white border-t border-slate-200" id="dang-ky-thong-tin">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-2 mb-8">
        <div class="inline-flex items-center space-x-1 text-warmOrange-600 text-xs font-bold uppercase tracking-wider">
          <span>Bổ Sung & Cập Nhật Hồ Sơ</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Bạn Thuộc Khóa Sau 2011 Hoặc Muốn Cập Nhật?</h2>
        <p class="text-slate-500 text-xs sm:text-sm">
          Nếu bạn tốt nghiệp các khóa từ 2012 đến nay hoặc muốn bổ sung thông tin liên lạc (Nghề nghiệp, SĐT, Facebook), vui lòng gửi biểu mẫu dưới đây.
        </p>
      </div>

      <form id="alumni-register-form" class="bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Họ và Tên *</label>
            <input
              type="text"
              name="fullName"
              required
              placeholder="VD: Nguyễn Văn Nam"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Năm Tốt Nghiệp / Niên Khóa *</label>
            <input
              type="text"
              name="batch"
              required
              placeholder="VD: 2015 hoặc Khóa 2012 - 2015"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Lớp Học (VD: 12A1) *</label>
            <input
              type="text"
              name="className"
              required
              placeholder="VD: 12A1"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Thầy/Cô Giáo Viên Chủ Nhiệm</label>
            <input
              type="text"
              name="teacher"
              placeholder="VD: Thầy Luân / Cô Thủy..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Nghề Nghiệp / Đơn Vị Công Tác</label>
            <input
              type="text"
              name="job"
              placeholder="VD: Kỹ sư phần mềm / Bác sĩ / Doanh nhân..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Tỉnh Thành / Nơi Đang Sinh Sống *</label>
            <input
              type="text"
              name="location"
              required
              placeholder="VD: TP. Hồ Chí Minh / Đồng Nai..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Số Điện Thoại / Zalo (Tùy chọn)</label>
            <input
              type="tel"
              name="phone"
              placeholder="09xx xxx xxx"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email / Facebook (Tùy chọn)</label>
            <input
              type="text"
              name="facebook"
              placeholder="Email hoặc link Facebook..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-warmOrange-500 focus:outline-none bg-white"
            />
          </div>
        </div>

        <div id="alumni-form-notice" class="hidden p-4 rounded-xl text-xs font-medium"></div>

        <button
          type="submit"
          id="alumni-submit-btn"
          class="w-full py-3.5 rounded-xl text-white font-bold text-sm bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 shadow-md shadow-warmOrange-500/20 transition transform active:scale-[0.99]"
        >
          Gửi Thông Tin Cập Nhật Danh Bạ
        </button>
      </form>
    </div>
  </section>

  <!-- Cross Linking Footer -->
  <CrossLinkingNav currentModule="tim-ban" />
</BaseLayout>

<script>
  interface Alumnus {
    id: string;
    fullName: string;
    gradYear: number;
    batch: string;
    className: string;
    dob?: string;
    gender?: string;
    pob?: string;
  }

  let allAlumniData: Alumnus[] = [];
  let filteredList: Alumnus[] = [];
  let currentPage = 1;
  const pageSize = 50;

  const selectYear = document.getElementById('select-year') as HTMLSelectElement | null;
  const selectClass = document.getElementById('select-class') as HTMLSelectElement | null;
  const searchName = document.getElementById('search-name') as HTMLInputElement | null;
  const tableBody = document.getElementById('alumni-table-body');
  const summaryTitle = document.getElementById('results-summary-title');
  const paginationInfo = document.getElementById('pagination-info');
  const pageIndicator = document.getElementById('page-indicator');
  const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
  const statusLoading = document.getElementById('status-loading-text');
  const yearPillButtons = document.querySelectorAll<HTMLButtonElement>('.year-pill-btn');

  // Load JSON database asynchronously
  async function loadDatabase() {
    try {
      const res = await fetch('/data/official_alumni_all.json');
      if (!res.ok) throw new Error('Failed to load JSON');
      allAlumniData = await res.json();
      filteredList = allAlumniData;

      if (statusLoading) {
        statusLoading.textContent = `Đã tải ${allAlumniData.length.toLocaleString()} hồ sơ`;
        statusLoading.className = 'text-xs font-semibold text-emerald-600';
      }

      updateClassDropdown();
      renderTable();
    } catch (err) {
      console.error(err);
      if (statusLoading) {
        statusLoading.textContent = 'Lỗi tải dữ liệu';
        statusLoading.className = 'text-xs font-semibold text-rose-600';
      }
    }
  }

  function updateClassDropdown() {
    if (!selectClass) return;
    const selectedYear = selectYear?.value || 'ALL';
    
    let classes: string[] = [];
    if (selectedYear === 'ALL') {
      classes = Array.from(new Set(allAlumniData.map(a => a.className))).filter(Boolean).sort();
    } else {
      const yr = parseInt(selectedYear, 10);
      classes = Array.from(new Set(allAlumniData.filter(a => a.gradYear === yr).map(a => a.className))).filter(Boolean).sort();
    }

    selectClass.innerHTML = '<option value="ALL">Tất cả các lớp</option>' + 
      classes.map(c => `<option value="${c}">Lớp ${c}</option>`).join('');
  }

  function applyFilters() {
    const selectedYear = selectYear?.value || 'ALL';
    const selectedClass = selectClass?.value || 'ALL';
    const query = searchName?.value.toLowerCase().trim() || '';

    filteredList = allAlumniData.filter(a => {
      const matchYear = selectedYear === 'ALL' || a.gradYear.toString() === selectedYear;
      const matchClass = selectedClass === 'ALL' || a.className.toLowerCase() === selectedClass.toLowerCase();
      const matchName = query === '' || a.fullName.toLowerCase().includes(query) || (a.pob && a.pob.toLowerCase().includes(query));
      return matchYear && matchClass && matchName;
    });

    currentPage = 1;
    renderTable();
  }

  function renderTable() {
    if (!tableBody) return;

    const total = filteredList.length;
    const totalPages = Math.ceil(total / pageSize) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, total);
    const pageItems = filteredList.slice(startIndex, endIndex);

    // Update summaries
    if (summaryTitle) {
      const yr = selectYear?.value;
      summaryTitle.textContent = yr && yr !== 'ALL'
        ? `Danh sách cựu học sinh tốt nghiệp năm ${yr} (${total.toLocaleString()} học sinh)`
        : `Toàn bộ danh sách cựu học sinh (${total.toLocaleString()} học sinh)`;
    }

    if (paginationInfo) {
      paginationInfo.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên tổng số ${total.toLocaleString()} học sinh`;
    }

    if (pageIndicator) {
      pageIndicator.textContent = `Trang ${currentPage} / ${totalPages}`;
    }

    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

    if (pageItems.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-12 text-slate-500">
            <span class="text-2xl block mb-2">🔍</span>
            <strong>Không tìm thấy cựu học sinh phù hợp với bộ lọc.</strong>
            <p class="text-xs text-slate-400 mt-1">Hãy thử xóa bớt từ khóa hoặc chọn năm tốt nghiệp khác.</p>
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = pageItems.map((item, idx) => `
      <tr class="hover:bg-slate-50/80 transition">
        <td class="py-3 px-4 sm:px-6 font-semibold text-slate-400 text-center">${startIndex + idx + 1}</td>
        <td class="py-3 px-4 sm:px-6 font-bold text-navy-950 whitespace-nowrap">${item.fullName}</td>
        <td class="py-3 px-3 sm:px-4 whitespace-nowrap">
          <span class="px-2 py-0.5 rounded-md bg-navy-50 text-navy-800 text-xs font-bold border border-navy-100">
            ${item.className}
          </span>
        </td>
        <td class="py-3 px-3 sm:px-4 text-xs font-semibold text-warmOrange-600 whitespace-nowrap">${item.batch}</td>
        <td class="py-3 px-3 sm:px-4 text-xs text-slate-600 whitespace-nowrap">${item.dob || '-'}</td>
        <td class="py-3 px-3 sm:px-4 text-xs text-slate-600 whitespace-nowrap">${item.gender || '-'}</td>
        <td class="py-3 px-4 sm:px-6 text-xs text-slate-600">${item.pob || '-'}</td>
        <td class="py-3 px-4 sm:px-6 text-center whitespace-nowrap">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
            Hồ sơ gốc
          </span>
        </td>
      </tr>
    `).join('');
  }

  // Event Listeners
  selectYear?.addEventListener('change', () => {
    updateClassDropdown();
    // Update pill styles
    const val = selectYear.value;
    yearPillButtons.forEach(btn => {
      if (btn.getAttribute('data-year') === val) {
        btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
      } else {
        btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
      }
    });
    applyFilters();
  });

  selectClass?.addEventListener('change', applyFilters);
  searchName?.addEventListener('input', applyFilters);

  yearPillButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const year = btn.getAttribute('data-year') || 'ALL';
      if (selectYear) selectYear.value = year;
      updateClassDropdown();
      yearPillButtons.forEach(b => {
        b.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-slate-100 text-slate-700 hover:bg-warmOrange-100 hover:text-warmOrange-900 border border-slate-200/80';
      });
      btn.className = 'year-pill-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-navy-950 text-white shadow-xs';
      applyFilters();
    });
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderTable();
      document.getElementById('app-tra-cuu')?.scrollIntoView({ behavior: 'smooth' });
    }
  });

  nextBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredList.length / pageSize) || 1;
    if (currentPage < totalPages) {
      currentPage++;
      renderTable();
      document.getElementById('app-tra-cuu')?.scrollIntoView({ behavior: 'smooth' });
    }
  });

  // Load database on DOM ready
  document.addEventListener('DOMContentLoaded', loadDatabase);

  // Form submission
  const form = document.getElementById('alumni-register-form') as HTMLFormElement | null;
  const notice = document.getElementById('alumni-form-notice');
  const submitBtn = document.getElementById('alumni-submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!submitBtn || !notice) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Đang lưu danh bạ...';

    setTimeout(() => {
      notice.className = 'p-4 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
      notice.innerHTML = '🎉 <strong>Gửi thông tin thành công!</strong> Cảm ơn bạn. Thông tin cập nhật của bạn đã được ghi nhận vào hệ thống Danh bạ Cựu học sinh THPT Xuân Lộc.';
      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Gửi Thông Tin Cập Nhật Danh Bạ';
    }, 700);
  });
</script>
