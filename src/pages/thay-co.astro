---
import BaseLayout from '../layouts/BaseLayout.astro';
import TributeWall from '../components/TributeWall.astro';
import CrossLinkingNav from '../components/CrossLinkingNav.astro';
import { 
  departmentsData, 
  facultyMembersData, 
  facultyDevPhases, 
  facultyPillars 
} from '../data/facultyDirectory';

const teachersList = [
  {
    name: "Thầy Kiều Mạnh Hà",
    role: "Hiệu trưởng Nhà trường (Đương nhiệm)",
    subject: "Quản lý Giáo dục - Cựu Học Sinh",
    quote: "Kế thừa và phát huy truyền thống vẻ vang, xây dựng THPT Xuân Lộc thành ngôi trường hạnh phúc và chất lượng cao.",
    years: "2018 - Nay",
  },
  {
    name: "Thầy Phan Bá Kiên",
    role: "Phó Hiệu trưởng Nhà trường",
    subject: "Ban Giám Hiệu - Toán học",
    quote: "Mỗi ngày đến trường là một niềm vui, mỗi tiết học là một sự tiến bộ của các em học sinh.",
    years: "2016 - Nay",
  },
  {
    name: "Thầy Hồ Đức Nghỉ",
    role: "Phó Hiệu trưởng Nhà trường",
    subject: "Ban Giám Hiệu - Lịch sử",
    quote: "Kỷ cương - Tình thương - Trách nhiệm luôn là kim chỉ nam trong sự nghiệp giáo dục.",
    years: "2020 - Nay",
  },
  {
    name: "Cô Lê Thị Hiền",
    role: "Giáo viên Cốt cán - Hướng dẫn NCKH",
    subject: "Môn Hóa Học - Cựu Học Sinh",
    quote: "Hướng dẫn các em biến những ý tưởng sáng tạo khoa học thành công trình đạt giải Quốc gia là niềm tự hào lớn nhất.",
    years: "2005 - Nay",
  },
  {
    name: "Thầy Đặng Thành Luân",
    role: "Giáo viên Toán - Nguyên Bí thư Đoàn trường",
    subject: "Môn Toán - Công tác Đoàn (Cựu Học Sinh)",
    quote: "Tuổi trẻ THPT Xuân Lộc luôn tràn đầy ngọn lửa nhiệt huyết và tinh thần xung kích.",
    years: "2000 - Nay",
  },
  {
    name: "Thầy Nguyễn Văn Hiếu",
    role: "Nguyên Hiệu trưởng qua các thời kỳ",
    subject: "Quản lý Giáo dục - Toán",
    quote: "Mỗi thế hệ học trò trưởng thành và sống tử tế là phần thưởng lớn nhất của người cầm phấn.",
    years: "1990 - 2002",
  },
  {
    name: "Cô Huỳnh Thu Thủy",
    role: "Tổ trưởng Chuyên môn",
    subject: "Môn Vật Lý",
    quote: "Mỗi bài học vật lý là một sự khám phá thú vị về thế giới tự nhiên xung quanh ta.",
    years: "2003 - Nay",
  }
];

const alumniTeacherGenerations = [
  {
    phase: "Thế hệ Cựu học sinh 1985 – 1995",
    role: "Cán bộ quản lý trường, Tổ trưởng/Tổ phó chuyên môn",
    achievements: "Trực tiếp bồi dưỡng hàng trăm học sinh giỏi đạt giải cấp tỉnh các môn Toán, Vật lý, Hóa học, Ngữ văn. Đạt danh hiệu Giáo viên dạy giỏi cấp tỉnh, Chiến sĩ thi đua cấp cơ sở và cấp tỉnh.",
    badge: "Thế hệ Tiên Phong"
  },
  {
    phase: "Cô Lê Thị Hiền & Thế hệ cựu học sinh 2000s",
    role: "Giáo viên chuyên môn, Giáo viên hướng dẫn NCKH",
    achievements: "Hướng dẫn học sinh liên tục đạt giải cao tại Cuộc thi Sáng tạo Thanh thiếu niên nhi đồng và Cuộc thi KHKT cấp tỉnh, cấp Quốc gia.",
    badge: "Nghiên cứu & Sáng tạo"
  },
  {
    phase: "Thế hệ Cựu học sinh trẻ (Khóa 2010 trở đi)",
    role: "Giáo viên bộ môn Tin học, Ngoại ngữ, Kỹ năng sống",
    achievements: "Lực lượng tiên phong chuyển đổi số trong nhà trường, ứng dụng CNTT, AI trong soạn giảng; phụ trách ban cố vấn các CLB học thuật, truyền thông XLMedia của trường.",
    badge: "Chuyển Đổi Số"
  }
];
---

<BaseLayout
  title="Kỷ Yếu Đội Ngũ Giáo Viên & Tri Ân Thầy Cô (1985 - Nay) - THPT Xuân Lộc"
  description="Kỷ yếu danh bạ thầy cô giáo qua các thời kỳ theo từng tổ chuyên môn và lưu giữ những lời dạy quý báu của nhà giáo Trường THPT Xuân Lộc."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-14 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Tôn Sư Trọng Đạo • 40 Năm Nghĩa Tình Thầy Trò (1985 – Nay)</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Kỷ Yếu Đội Ngũ Giáo Viên & Tri Ân Thầy Cô
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base">
        Kính dâng lòng biết ơn sâu sắc đến những người lái đò thầm lặng đã dìu dắt bao thế hệ học sinh Xuân Lộc vươn cao, tỏa sáng.
      </p>
    </div>
  </section>

  <!-- 3 Chặng đường phát triển đội ngũ sư phạm -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Hành Trình 40 Năm Chuyển Mình Sư Phạm</h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2">Từ lứa nhà giáo xung phong thời kỳ đầu đến đội ngũ trên 20% Thạc sĩ và hơn 30% cựu học sinh trở về kế thừa</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {facultyDevPhases.map((phase) => (
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-navy-900 text-warmOrange-300 text-[11px] font-bold mb-3">
                {phase.phase}
              </span>
              <h3 class="font-bold text-navy-900 text-base mb-2">{phase.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{phase.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ban Giám Hiệu & Thầy Cô Tiêu Biểu -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl font-bold text-navy-950">Gương Mặt Thầy Cô Tiêu Biểu</h2>
          <p class="text-xs text-slate-600">Lời tâm huyết và dấu ấn cống hiến của các thầy cô qua các thời kỳ</p>
        </div>
        <a href="#ky-yeu-to-chuyen-mon" class="inline-flex items-center space-x-1 text-xs font-bold text-warmOrange-600 hover:text-warmOrange-700 bg-warmOrange-50 px-3.5 py-2 rounded-xl border border-warmOrange-200">
          <span>Xem Danh Sách Theo 9 Tổ Chuyên Môn</span>
          <span>↓</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teachersList.map((teacher) => (
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition duration-200">
            <div>
              <div class="flex items-center space-x-4 mb-4">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-navy-800 to-navy-900 flex items-center justify-center text-warmOrange-400 font-bold text-xl shadow-inner border border-navy-700">
                  {teacher.name.split(' ').pop()?.[0]}
                </div>
                <div>
                  <h3 class="font-bold text-navy-900 text-lg">{teacher.name}</h3>
                  <p class="text-xs text-warmOrange-600 font-semibold">{teacher.role}</p>
                  <p class="text-xs text-slate-500">Thời gian công tác: {teacher.years}</p>
                </div>
              </div>

              <blockquote class="p-4 rounded-xl bg-slate-50 text-xs text-slate-700 italic border-l-2 border-warmOrange-500 leading-relaxed my-3">
                "{teacher.quote}"
              </blockquote>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span class="font-medium bg-slate-100 px-2.5 py-0.5 rounded">{teacher.subject}</span>
              <a href="#gui-loi-chuc-thay-co" class="text-warmOrange-600 hover:underline font-semibold">Gửi lời tri ân &rarr;</a>
            </div>
          </div>
        ))}
      </div>

      <!-- Nét đặc thù: Cựu học sinh trở thành giáo viên -->
      <div class="mt-14 bg-white rounded-3xl p-8 md:p-10 border border-warmOrange-200/80 shadow-sm relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-warmOrange-100/50 pointer-events-none"></div>
        <div class="max-w-3xl mb-8">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-100 text-warmOrange-800 text-xs font-bold uppercase tracking-wider mb-2">
            <span>Truyền Thống Kế Thừa Đặc Biệt</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">Nét Đặc Thù: Thế Hệ Cựu Học Sinh Trở Về Giảng Dạy</h2>
          <p class="text-slate-600 text-sm mt-2 leading-relaxed">
            Một trong những niềm tự hào lớn nhất của THPT Xuân Lộc là tỷ lệ kế thừa thế hệ rất cao: hàng chục cựu học sinh xuất sắc sau khi tốt nghiệp ĐH Sư phạm đã tình nguyện quay về cống hiến cho chính mái trường mình từng theo học.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {alumniTeacherGenerations.map((gen) => (
            <div class="bg-gradient-to-br from-slate-50 to-orange-50/30 rounded-2xl p-6 border border-slate-200/90 flex flex-col justify-between hover:border-warmOrange-300 transition">
              <div>
                <span class="inline-block px-2.5 py-1 rounded-md bg-warmOrange-500 text-white text-[11px] font-semibold mb-3">
                  {gen.badge}
                </span>
                <h3 class="font-bold text-navy-900 text-base mb-1">{gen.phase}</h3>
                <p class="text-xs font-semibold text-warmOrange-700 mb-3">{gen.role}</p>
                <p class="text-xs text-slate-600 leading-relaxed">{gen.achievements}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- KỶ YẾU DANH SÁCH GIÁO VIÊN THEO 9 TỔ CHUYÊN MÔN (SIDEBAR LAYOUT) -->
  <section class="py-16 bg-white border-t border-b border-slate-200" id="ky-yeu-to-chuyen-mon">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-3xl mx-auto space-y-2">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-navy-100 text-navy-900 text-xs font-bold uppercase tracking-wider">
          <span>Kỷ Yếu Sư Phạm 1985 – Nay</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-950">
          Danh Sách Thầy Cô Theo 9 Tổ Chuyên Môn
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm">
          Chọn tổ chuyên môn ở cột bên trái để tra cứu nhanh thông tin đội ngũ nhà giáo đang công tác, đã nghỉ hưu hoặc đã chuyển công tác.
        </p>
      </div>

      <!-- Layout 2 Cột: Sidebar Trái (Tổ Chuyên Môn) + Content Phải (Bảng Giáo Viên) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="faculty-app">
        <!-- Cột Trái: Sidebar Bộ Lọc Các Tổ Chuyên Môn (Sticky) -->
        <div class="lg:col-span-4 bg-slate-50/90 p-5 rounded-3xl border border-slate-200 shadow-sm sticky top-24">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200">
            <h3 class="font-bold text-navy-950 text-sm uppercase tracking-wider flex items-center gap-2">
              <span>📚</span>
              <span>Tổ Chuyên Môn</span>
            </h3>
            <span class="text-[11px] font-semibold text-slate-500 bg-white px-2 py-0.5 rounded-full border border-slate-200">
              {facultyMembersData.length} Thầy Cô
            </span>
          </div>

          <div class="space-y-1.5 max-h-[600px] overflow-y-auto pr-1">
            <button
              class="dept-filter-btn w-full text-left px-3.5 py-3 rounded-2xl text-xs font-bold transition flex items-center justify-between bg-navy-950 text-white shadow-sm border border-navy-900"
              data-dept="all"
            >
              <span class="flex items-center gap-2">
                <span class="text-base">🏫</span>
                <span>Tất Cả Các Tổ</span>
              </span>
              <span class="text-[11px] bg-navy-800/80 text-warmOrange-300 px-2 py-0.5 rounded-full font-bold">
                {facultyMembersData.length}
              </span>
            </button>

            {departmentsData.map((d) => {
              const count = facultyMembersData.filter(m => m.departmentId === d.id).length;
              return (
                <button
                  class="dept-filter-btn w-full text-left px-3.5 py-2.5 rounded-2xl text-xs font-semibold transition flex items-center justify-between bg-white text-slate-700 hover:bg-slate-100 hover:text-navy-950 border border-slate-200/80"
                  data-dept={d.id}
                >
                  <span class="flex items-center gap-2 truncate">
                    <span class="text-base">{d.icon}</span>
                    <span class="truncate">{d.name}</span>
                  </span>
                  <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium ml-2 shrink-0">
                    {count}
                  </span>
                </button>
              );
            })}
          </div>

          <!-- Thông tin tóm tắt tổ đang chọn -->
          <div class="mt-4 pt-3 border-t border-slate-200 text-xs text-slate-500">
            <p id="dept-desc-box" class="italic leading-relaxed">
              Hiển thị toàn bộ danh sách thầy cô giáo THPT Xuân Lộc từ 1985 đến nay.
            </p>
          </div>
        </div>

        <!-- Cột Phải: Bảng Danh Sách Giáo Viên Chi Tiết -->
        <div class="lg:col-span-8 space-y-4">
          <!-- Thanh trạng thái kết quả -->
          <div class="flex items-center justify-between px-1">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-bold text-navy-900" id="current-filter-title">
                Tất Cả Các Tổ ({facultyMembersData.length} Thầy Cô)
              </span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-slate-500">
              <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Đang dạy</span>
              <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Hưu trí</span>
            </div>
          </div>

          <!-- Bảng danh sách giáo viên -->
          <div class="overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-50 text-navy-900 font-bold uppercase tracking-wider text-[11px] border-b border-slate-200">
                <tr>
                  <th class="py-3.5 px-4 sm:px-5">Họ và Tên Giáo Viên</th>
                  <th class="py-3.5 px-3 sm:px-4">Tổ Bộ Môn</th>
                  <th class="py-3.5 px-3 sm:px-4">Thời Gian</th>
                  <th class="py-3.5 px-3 sm:px-4">Tình Trạng</th>
                  <th class="py-3.5 px-4 sm:px-5">Dấu Ấn / Ghi Chú Chuyên Môn</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700" id="faculty-table-body">
                {facultyMembersData.map((member) => (
                  <tr class="faculty-row hover:bg-slate-50/80 transition" data-dept={member.departmentId}>
                    <td class="py-3.5 px-4 sm:px-5 font-bold text-navy-950 whitespace-nowrap">
                      {member.name}
                    </td>
                    <td class="py-3.5 px-3 sm:px-4 text-slate-600 whitespace-nowrap">
                      <span class="px-2 py-0.5 rounded bg-slate-100 text-[11px] font-medium text-slate-800">
                        {member.departmentName}
                      </span>
                    </td>
                    <td class="py-3.5 px-3 sm:px-4 font-medium text-slate-500 whitespace-nowrap">
                      {member.period}
                    </td>
                    <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        member.status === 'Đang công tác' ? 'bg-emerald-100 text-emerald-800' :
                        member.status === 'Đã nghỉ hưu' ? 'bg-amber-100 text-amber-800' :
                        'bg-slate-200 text-slate-700'
                      }`}>
                        {member.status}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 sm:px-5 text-xs text-slate-600 leading-relaxed">
                      {member.roleOrNote}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Phân tích 3 trụ cột sức mạnh đội ngũ -->
      <div class="bg-navy-950 text-white rounded-3xl p-8 md:p-10 border border-navy-800">
        <h3 class="text-xl font-bold mb-6 text-warmOrange-400 text-center">
          3 Trụ Cột Khẳng Định Bản Sắc Đội Ngũ Sư Phạm Xuân Lộc
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {facultyPillars.map((p) => (
            <div class="bg-navy-900/80 rounded-2xl p-6 border border-navy-800 space-y-2">
              <div class="text-2xl">{p.icon}</div>
              <h4 class="font-bold text-white text-sm">{p.title}</h4>
              <p class="text-xs text-slate-300 leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tribute Wall Section -->
  <section class="py-12 bg-slate-50" id="gui-loi-chuc-thay-co">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <TributeWall teachers={teachersList.map(t => t.name)} />
    </div>
  </section>

  <!-- Cross Linking Footer -->
  <CrossLinkingNav currentModule="thay-co" />
</BaseLayout>

<script>
  function setupFacultyFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.dept-filter-btn');
    const rows = document.querySelectorAll<HTMLTableRowElement>('.faculty-row');
    const titleEl = document.getElementById('current-filter-title');
    const descEl = document.getElementById('dept-desc-box');

    const deptDescriptions: Record<string, string> = {
      'all': 'Hiển thị toàn bộ danh sách thầy cô giáo THPT Xuân Lộc từ 1985 đến nay.',
      'toan': 'Tổ Toán học: Nòng cốt bồi dưỡng tư duy logic, STEM Toán và đội tuyển HSG.',
      'van': 'Tổ Ngữ văn: Gìn giữ hồn văn học, dự án trải nghiệm và văn hóa đọc.',
      'ly-cn': 'Tổ Vật lý - Công nghệ: Tiên phong hướng dẫn NCKH, sáng tạo kỹ thuật và thực nghiệm.',
      'hoa': 'Tổ Hóa học: Đổi mới thí nghiệm số, luyện thi chuyên sâu và bồi dưỡng HSG.',
      'sinh': 'Tổ Sinh học: Thực địa sinh thái Chứa Chan, Y sinh và bảo vệ môi trường.',
      'tin': 'Tổ Tin học: Huấn luyện HSG Quốc gia môn Tin học, chuyển đổi số & AI.',
      'su-dia-gdcd': 'Tổ Sử - Địa - GDKT&PL: Giáo dục di sản, chủ quyền biển đảo và pháp lý học đường.',
      'ngoai-ngu': 'Tổ Ngoại ngữ (Tiếng Anh): Phát triển CLB E-Club, mô hình Debate và chứng chỉ quốc tế.',
      'the-chat-gdqp': 'Tổ Thể dục - GDQP-AN: Đoàn Hội khỏe Phù Đổng, hội thao GDQP và rèn luyện thể chất.'
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dept = btn.getAttribute('data-dept') || 'all';

        // Style updates cho nút được chọn ở sidebar
        buttons.forEach((b) => {
          b.classList.remove('bg-navy-950', 'text-white', 'shadow-sm', 'border-navy-900');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-200/80');
          const countBadge = b.querySelector('span:last-child');
          if (countBadge) {
            countBadge.className = 'text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium ml-2 shrink-0';
          }
        });

        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200/80');
        btn.classList.add('bg-navy-950', 'text-white', 'shadow-sm', 'border-navy-900');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.className = 'text-[11px] bg-navy-800/80 text-warmOrange-300 px-2 py-0.5 rounded-full font-bold ml-2 shrink-0';
        }

        // Lọc số hàng và cập nhật tiêu đề
        let visibleCount = 0;
        rows.forEach((row) => {
          const rowDept = row.getAttribute('data-dept');
          if (dept === 'all' || rowDept === dept) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Cập nhật tiêu đề và mô tả
        const btnName = btn.querySelector('span.truncate, span:first-child')?.textContent?.trim() || 'Tất Cả Các Tổ';
        if (titleEl) {
          titleEl.textContent = `${btnName} (${visibleCount} Thầy Cô)`;
        }
        if (descEl && deptDescriptions[dept]) {
          descEl.textContent = deptDescriptions[dept];
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFacultyFilter);
</script>

