---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Quỹ Học Bổng Cựu Học Sinh THPT Xuân Lộc - Tiếp Sức Đến Trường"
  description="Quỹ học bổng cựu học sinh Trường THPT Xuân Lộc kết nối các tấm lòng hảo tâm, tài trợ và trao học bổng cho học sinh nghèo vượt khó hiếu học."
>
  <!-- Hero Section -->
  <section class="bg-navy-950 text-white py-16 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-warmOrange-500/20 text-warmOrange-300 border border-warmOrange-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>Thông Báo Ban Liên Lạc</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Quỹ Học Bổng Cựu Học Sinh THPT Xuân Lộc
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base">
        Chương trình quỹ học bổng đang trong quá trình chuẩn bị và hoàn thiện quy chế vận hành cùng Nhà trường cho năm học mới.
      </p>
    </div>
  </section>

  <!-- Coming Soon Section -->
  <section class="py-16 bg-slate-50 min-h-[50vh] flex items-center">
    <div class="max-w-xl mx-auto px-4 text-center space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-warmOrange-100 text-warmOrange-600 flex items-center justify-center mx-auto shadow-sm">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-navy-900">Tính Năng Đang Tạm Đóng</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Hệ thống tiếp nhận tài trợ Quỹ Học Bổng trực tuyến đang tạm thời đóng để cập nhật danh sách và kế hoạch trao học bổng cho niên khóa mới. Mọi thông tin chính thức sẽ được Ban Liên Lạc thông báo tại mục Tin Tức & Sự Kiện.
      </p>
      <div class="pt-2">
        <a
          href="/"
          class="inline-block px-6 py-3 rounded-xl text-white font-semibold text-sm bg-navy-900 hover:bg-navy-800 shadow-md transition"
        >
          Quay Về Trang Chủ
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
