---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ban Quản Trị Cổng Thông Tin - CHSXUANLOC.COM"
  description="Khu vực quản trị dành cho Ban Liên Lạc duyệt bài viết kỷ yếu và danh sách đăng ký học bổng."
>
  <section class="bg-navy-950 text-white py-10 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 text-xs font-semibold uppercase tracking-wider mb-2">
          <span>Hệ thống Quản Trị Firebase</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-white">Bảng Điều Khiển Ban Quản Trị</h1>
      </div>
      
      <!-- Auth Status & Action -->
      <div id="auth-actions" class="flex items-center space-x-3">
        <!-- Google Sign-in or Logged user info rendered by JS -->
      </div>
    </div>
  </section>

  <!-- Admin Main Container -->
  <section class="py-10 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Unauthenticated View -->
      <div id="login-required" class="max-w-md mx-auto my-12 bg-white p-8 rounded-2xl border border-slate-200 shadow-xl text-center space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-navy-900 text-warmOrange-400 flex items-center justify-center mx-auto shadow-md">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-navy-900">Yêu Cầu Xác Thực Quản Trị</h2>
          <p class="text-xs text-slate-500 mt-2">
            Vui lòng đăng nhập bằng tài khoản Google được cấp quyền quản trị của Ban Liên Lạc Cựu Học Sinh THPT Xuân Lộc.
          </p>
        </div>

        <button
          id="google-signin-btn"
          class="w-full py-3 px-4 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-sm flex items-center justify-center space-x-3 transition active:scale-95"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Đăng nhập với Google</span>
        </button>
      </div>

      <!-- Authenticated Dashboard -->
      <div id="admin-dashboard" class="hidden space-y-8">
        
        <!-- Navigation Tabs -->
        <div class="flex border-b border-slate-200 space-x-4">
          <button id="tab-submissions" class="pb-3 px-2 border-b-2 border-warmOrange-500 font-bold text-sm text-navy-900">
            Duyệt Kỷ Yếu & Tâm Sự (<span id="count-pending">0</span>)
          </button>
          <button id="tab-scholarships" class="pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900">
            Danh Sách Đăng Ký Tài Trợ Học Bổng
          </button>
          <button id="tab-automation" class="pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5">
            <span>⚡ Tự Động Hóa & Actions</span>
          </button>
        </div>

        <!-- Section 1: Submissions Management -->
        <div id="panel-submissions" class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-navy-900">Bài gửi kỷ yếu cần phê duyệt</h2>
            <button id="btn-refresh-submissions" class="text-xs text-warmOrange-600 font-semibold hover:underline flex items-center space-x-1">
              <span>Làm mới danh sách</span>
            </button>
          </div>

          <div id="submissions-table-loading" class="py-12 text-center text-slate-400">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-warmOrange-500 border-t-transparent mb-2"></div>
            <p class="text-xs">Đang đồng bộ dữ liệu từ Cloud Firestore...</p>
          </div>

          <div id="submissions-table-empty" class="hidden py-8 text-center text-slate-500 bg-white rounded-xl border border-slate-200">
            <p class="text-sm font-medium">Hiện không có bài viết nào đang chờ duyệt</p>
          </div>

          <div id="submissions-container" class="grid grid-cols-1 md:grid-cols-2 gap-6 hidden"></div>
        </div>

        <!-- Section 2: Scholarships List -->
        <div id="panel-scholarships" class="hidden space-y-4">
          <h2 class="text-lg font-bold text-navy-900">Danh Sách Đăng Ký Tài Trợ Học Bổng</h2>
          
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-100 text-navy-900 uppercase font-semibold border-b border-slate-200">
                  <tr>
                    <th class="p-3.5">Họ Tên / Đơn Vị</th>
                    <th class="p-3.5">Khóa</th>
                    <th class="p-3.5">Số Điện Thoại</th>
                    <th class="p-3.5">Mức Đăng Ký</th>
                    <th class="p-3.5">Lời Chúc / Ghi Chú</th>
                    <th class="p-3.5">Thời Gian</th>
                  </tr>
                </thead>
                <tbody id="scholarships-tbody" class="divide-y divide-slate-100">
                  <!-- Render dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Section 3: Automation & GitHub Actions Trigger -->
        <div id="panel-automation" class="hidden space-y-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-xl">
                ⚙️
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-900">Điều Khiển Tự Động Hóa (GitHub Actions & AI)</h2>
                <p class="text-xs text-slate-500">Kích hoạt tác vụ quét tin tức, AI sáng tác bài tâm sự hoặc Build lại website theo yêu cầu</p>
              </div>
            </div>

            <!-- GitHub Personal Access Token Config -->
            <div class="mb-6 p-4 rounded-xl bg-slate-50 border border-slate-200">
              <label class="block text-xs font-bold text-slate-700 mb-1.5 flex items-center justify-between">
                <span>GitHub Personal Access Token (PAT) <span class="text-slate-400 font-normal">(Cần quyền `repo` hoặc `workflow`)</span>:</span>
                <a href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=CHS+Xuan+Loc+Admin+Trigger" target="_blank" rel="noopener noreferrer" class="text-warmOrange-600 hover:underline font-normal text-xs">Tạo token tại đây &rarr;</a>
              </label>
              <div class="flex space-x-2">
                <input 
                  type="password" 
                  id="gh-pat-input" 
                  placeholder="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" 
                  class="flex-1 px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-warmOrange-500 font-mono"
                />
                <button 
                  id="btn-save-pat" 
                  class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold transition"
                >
                  Lưu vào trình duyệt
                </button>
              </div>
              <p class="text-[11px] text-slate-500 mt-1.5">
                🔒 Token được lưu an toàn trong trình duyệt (LocalStorage) của bạn và chỉ được gửi trực tiếp tới GitHub API khi bạn bấm kích hoạt.
              </p>
            </div>

            <!-- Action Trigger Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- Trigger Card 1: AI Daily Tam Su & News Sync -->
              <div class="p-4 rounded-xl border border-purple-200 bg-purple-50/50 hover:bg-purple-50 transition space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-100 px-2 py-0.5 rounded">Tin tức & Sáng tác AI</span>
                  <span class="text-[11px] text-slate-400">sync-facebook-news.yml</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-navy-900">Chạy Quét Tin Tức & AI Tâm Tình</h3>
                  <p class="text-xs text-slate-600 mt-1">
                    Kích hoạt AI quét bài Fanpage trường, tin Cổng TTĐT Xuân Lộc và tự động viết 1 bài tâm sự/thơ hoài niệm mới.
                  </p>
                </div>
                <button 
                  id="btn-trigger-sync-news" 
                  class="w-full py-2.5 px-4 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg text-xs shadow-sm transition flex items-center justify-center space-x-2"
                >
                  <span>🚀 Kích hoạt ngay</span>
                </button>
              </div>

              <!-- Trigger Card 2: Re-deploy Website -->
              <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/50 hover:bg-blue-50 transition space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-2 py-0.5 rounded">Hệ thống & Build</span>
                  <span class="text-[11px] text-slate-400">deploy.yml</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-navy-900">Build & Triển Khai Hosting</h3>
                  <p class="text-xs text-slate-600 mt-1">
                    Kích hoạt quy trình build lại toàn bộ các trang tĩnh và đẩy bản phát hành mới nhất lên Firebase Hosting.
                  </p>
                </div>
                <button 
                  id="btn-trigger-deploy" 
                  class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-xs shadow-sm transition flex items-center justify-center space-x-2"
                >
                  <span>🌐 Kích hoạt Deploy</span>
                </button>
              </div>

            </div>

            <!-- Direct GitHub Actions Link -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>Bạn cũng có thể xem trực tiếp nhật ký và tiến độ chạy trên GitHub:</span>
              <a 
                href="https://github.com/cfmvn/chsxuanloc/actions" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center font-bold text-navy-800 hover:text-warmOrange-600 transition"
              >
                <span>Mở trang GitHub Actions</span>
                <span class="ml-1">&rarr;</span>
              </a>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { auth, googleProvider, db } from '../lib/firebase';
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
  import { collection, query, orderBy, getDocs, doc, updateDoc, deleteDoc } from 'firebase/firestore';

  const loginRequired = document.getElementById('login-required');
  const adminDashboard = document.getElementById('admin-dashboard');
  const authActions = document.getElementById('auth-actions');
  const googleBtn = document.getElementById('google-signin-btn');
  
  const tabSubmissions = document.getElementById('tab-submissions');
  const tabScholarships = document.getElementById('tab-scholarships');
  const tabAutomation = document.getElementById('tab-automation');
  const panelSubmissions = document.getElementById('panel-submissions');
  const panelScholarships = document.getElementById('panel-scholarships');
  const panelAutomation = document.getElementById('panel-automation');

  const ghPatInput = document.getElementById('gh-pat-input') as HTMLInputElement | null;
  const btnSavePat = document.getElementById('btn-save-pat');
  const btnTriggerSyncNews = document.getElementById('btn-trigger-sync-news');
  const btnTriggerDeploy = document.getElementById('btn-trigger-deploy');

  const scholarshipsTbody = document.getElementById('scholarships-tbody');

  // Danh sách Email Admin được ủy quyền từ biến môi trường (hỗ trợ nhiều email cách nhau bằng dấu phẩy)
  const allowedAdminEmailsStr = import.meta.env.PUBLIC_ADMIN_EMAILS || 'chsxuanloc@gmail.com,thepottershousevn@gmail.com';
  const allowedAdminEmails = allowedAdminEmailsStr
    .split(',')
    .map((e: string) => e.trim().toLowerCase())
    .filter(Boolean);

  // Lắng nghe trạng thái đăng nhập Firebase Auth & Phân quyền Admin
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      const userEmail = (user.email || '').toLowerCase().trim();
      const isAuthorized = allowedAdminEmails.includes(userEmail);

      if (!isAuthorized) {
        // Tài khoản không có trong danh sách được phép
        alert(`Tài khoản "${user.email}" không thuộc danh sách Ban Quản Trị được cấp quyền. Vui lòng đăng nhập bằng tài khoản Admin!`);
        await signOut(auth);
        if (loginRequired) loginRequired.classList.remove('hidden');
        if (adminDashboard) adminDashboard.classList.add('hidden');
        if (authActions) authActions.innerHTML = '';
        return;
      }

      // Xác thực thành công (thuộc danh sách Admin)
      if (loginRequired) loginRequired.classList.add('hidden');
      if (adminDashboard) adminDashboard.classList.remove('hidden');

      if (authActions) {
        authActions.innerHTML = `
          <div class="flex items-center space-x-3">
            <span class="text-xs text-emerald-400 font-semibold hidden sm:inline">🛡️ ${user.displayName || user.email}</span>
            <button id="btn-signout" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600/80 hover:bg-rose-600 text-white transition">
              Đăng xuất
            </button>
          </div>
        `;
        document.getElementById('btn-signout')?.addEventListener('click', () => signOut(auth));
      }

      loadAdminSubmissions();
      loadAdminScholarships();

    } else {
      if (loginRequired) loginRequired.classList.remove('hidden');
      if (adminDashboard) adminDashboard.classList.add('hidden');
      if (authActions) authActions.innerHTML = '';
    }
  });

  googleBtn?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập thất bại: ' + (err.message || 'Lỗi không xác định'));
    }
  });

  // Load saved PAT from localStorage
  const STORAGE_KEY_GH_PAT = 'chs_admin_gh_pat';
  if (ghPatInput) {
    ghPatInput.value = localStorage.getItem(STORAGE_KEY_GH_PAT) || '';
  }

  btnSavePat?.addEventListener('click', () => {
    if (ghPatInput) {
      localStorage.setItem(STORAGE_KEY_GH_PAT, ghPatInput.value.trim());
      alert('✅ Đã lưu GitHub Access Token vào trình duyệt!');
    }
  });

  // Function to dispatch GitHub Action workflow
  async function triggerGitHubWorkflow(workflowFile: string, btnElement: HTMLElement | null, successMsg: string) {
    const pat = (ghPatInput?.value || localStorage.getItem(STORAGE_KEY_GH_PAT) || '').trim();
    if (!pat) {
      alert('⚠️ Vui lòng nhập GitHub Personal Access Token (PAT) và bấm "Lưu vào trình duyệt" trước khi kích hoạt!');
      tabAutomation?.click();
      ghPatInput?.focus();
      return;
    }

    if (!btnElement) return;
    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>Đang gửi lệnh tới GitHub...</span>`;
    (btnElement as HTMLButtonElement).disabled = true;

    try {
      const repoOwner = 'cfmvn';
      const repoName = 'chsxuanloc';
      const response = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/actions/workflows/${workflowFile}/dispatches`, {
        method: 'POST',
        headers: {
          'Accept': 'application/vnd.github+json',
          'Authorization': `Bearer ${pat}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({
          ref: 'main'
        })
      });

      if (response.status === 204) {
        alert(`🎉 Thành công! ${successMsg}\nGitHub Actions đang xử lý trong nền.`);
      } else {
        const data = await response.json().catch(() => ({}));
        alert(`❌ Lỗi (${response.status}): ${data.message || 'Không thể kích hoạt workflow. Vui lòng kiểm tra lại Token & Quyền hạn!'}`);
      }
    } catch (err: any) {
      alert('❌ Lỗi kết nối tới GitHub API: ' + (err.message || err));
    } finally {
      btnElement.innerHTML = originalText;
      (btnElement as HTMLButtonElement).disabled = false;
    }
  }

  btnTriggerSyncNews?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình AI Quét tin tức & Tự động sáng tác bài tâm sự mới ngay bây giờ?')) {
      triggerGitHubWorkflow('sync-facebook-news.yml', btnTriggerSyncNews, 'Đã kích hoạt quét tin tức & AI sáng tác bài tâm sự!');
    }
  });

  btnTriggerDeploy?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình Build & Deploy lại toàn bộ website lên Firebase Hosting?')) {
      triggerGitHubWorkflow('deploy.yml', btnTriggerDeploy, 'Đã kích hoạt Deploy website lên Firebase Hosting!');
    }
  });

  // Tab switching
  tabSubmissions?.addEventListener('click', () => {
    tabSubmissions.className = 'pb-3 px-2 border-b-2 border-warmOrange-500 font-bold text-sm text-navy-900';
    tabScholarships!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900';
    tabAutomation!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5';
    panelSubmissions?.classList.remove('hidden');
    panelScholarships?.classList.add('hidden');
    panelAutomation?.classList.add('hidden');
  });

  tabScholarships?.addEventListener('click', () => {
    tabScholarships.className = 'pb-3 px-2 border-b-2 border-warmOrange-500 font-bold text-sm text-navy-900';
    tabSubmissions!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900';
    tabAutomation!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5';
    panelScholarships?.classList.remove('hidden');
    panelSubmissions?.classList.add('hidden');
    panelAutomation?.classList.add('hidden');
  });

  tabAutomation?.addEventListener('click', () => {
    tabAutomation.className = 'pb-3 px-2 border-b-2 border-warmOrange-500 font-bold text-sm text-navy-900 flex items-center space-x-1.5';
    tabSubmissions!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900';
    tabScholarships!.className = 'pb-3 px-2 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-navy-900';
    panelAutomation?.classList.remove('hidden');
    panelSubmissions?.classList.add('hidden');
    panelScholarships?.classList.add('hidden');
  });

  refreshBtn?.addEventListener('click', () => {
    loadAdminSubmissions();
    loadAdminScholarships();
  });

  // Load submissions for Admin review
  async function loadAdminSubmissions() {
    if (!submissionsContainer || !submissionsLoading || !submissionsEmpty) return;
    submissionsLoading.classList.remove('hidden');
    submissionsEmpty.classList.add('hidden');
    submissionsContainer.classList.add('hidden');

    try {
      const q = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      submissionsLoading.classList.add('hidden');

      if (snapshot.empty) {
        submissionsEmpty.classList.remove('hidden');
        if (countPending) countPending.textContent = '0';
        return;
      }

      let pendingCount = 0;
      submissionsContainer.innerHTML = '';
      submissionsContainer.classList.remove('hidden');

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const id = docSnap.id;
        if (item.status === 'pending') pendingCount++;

        const card = document.createElement('div');
        card.className = `bg-white rounded-2xl border ${item.status === 'approved' ? 'border-emerald-200' : 'border-amber-300 ring-2 ring-amber-100'} p-5 shadow-sm space-y-4`;
        
        let imagePart = '';
        if (item.imageUrl) {
          imagePart = `
            <div class="h-44 rounded-lg overflow-hidden bg-slate-100">
              <img src="${item.imageUrl}" class="w-full h-full object-cover" />
            </div>
          `;
        }

        const statusBadge = item.status === 'approved' 
          ? '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800">Đã Duyệt</span>' 
          : '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-800">Chờ Duyệt</span>';

        card.innerHTML = `
          <div class="flex items-center justify-between">
            ${statusBadge}
            <span class="text-xs text-slate-400">${item.batch || ''}</span>
          </div>

          ${imagePart}

          <div>
            <h3 class="font-bold text-navy-900 text-base">${escapeHtml(item.fullName)} ${item.className ? `(${escapeHtml(item.className)})` : ''}</h3>
            ${item.contactInfo ? `<p class="text-xs text-slate-500 font-medium">LH: ${escapeHtml(item.contactInfo)}</p>` : ''}
            <p class="text-xs text-slate-700 mt-2 bg-slate-50 p-3 rounded-lg border border-slate-100 whitespace-pre-line">${escapeHtml(item.message)}</p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-2">
            ${item.status !== 'approved' ? `
              <button class="btn-approve px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 text-white hover:bg-emerald-700 transition" data-id="${id}">
                ✓ Phê Duyệt
              </button>
            ` : `
              <button class="btn-unapprove px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-600 text-white hover:bg-amber-700 transition" data-id="${id}">
                Ẩn Khỏi Web
              </button>
            `}
            <button class="btn-delete px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 transition" data-id="${id}">
              Xóa
            </button>
          </div>
        `;

        submissionsContainer.appendChild(card);
      });

      if (countPending) countPending.textContent = pendingCount.toString();

      // Attach actions
      document.querySelectorAll('.btn-approve').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await updateDoc(doc(db, 'submissions', docId), { status: 'approved' });
            loadAdminSubmissions();
          }
        });
      });

      document.querySelectorAll('.btn-unapprove').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await updateDoc(doc(db, 'submissions', docId), { status: 'pending' });
            loadAdminSubmissions();
          }
        });
      });

      document.querySelectorAll('.btn-delete').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          if (!confirm('Bạn có chắc chắn muốn xóa bài viết này không?')) return;
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await deleteDoc(doc(db, 'submissions', docId));
            loadAdminSubmissions();
          }
        });
      });

    } catch (err) {
      console.error('Lỗi khi fetch Admin submissions:', err);
    }
  }

  // Load scholarships for Admin review
  async function loadAdminScholarships() {
    if (!scholarshipsTbody) return;

    try {
      const q = query(collection(db, 'scholarships'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      scholarshipsTbody.innerHTML = '';
      if (snapshot.empty) {
        scholarshipsTbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-400">Chưa có thông tin đăng ký tài trợ nào</td></tr>';
        return;
      }

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const dateStr = item.createdAt ? new Date(item.createdAt.toDate()).toLocaleDateString('vi-VN') : '';
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="p-3.5 font-bold text-navy-900">${escapeHtml(item.fullName)}</td>
          <td class="p-3.5">${escapeHtml(item.batch || '—')}</td>
          <td class="p-3.5 text-warmOrange-600 font-mono">${escapeHtml(item.phone)}</td>
          <td class="p-3.5 font-semibold text-emerald-700">${escapeHtml(item.amount)} đ</td>
          <td class="p-3.5 text-slate-500 max-w-xs truncate" title="${escapeHtml(item.note || '')}">${escapeHtml(item.note || '—')}</td>
          <td class="p-3.5 text-slate-400">${dateStr}</td>
        `;
        scholarshipsTbody.appendChild(tr);
      });
    } catch (err) {
      console.error('Lỗi khi fetch scholarships:', err);
    }
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
