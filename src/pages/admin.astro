        if (id) openEditAlbumModal(id);
      });
    });

    document.querySelectorAll('.btn-quick-album-approve').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).getAttribute('data-id');
        if (id) {
          await updateDoc(doc(db, 'album_submissions', id), { status: 'approved' });
          loadAdminAlbums();
        }
      });
    });

    document.querySelectorAll('.btn-quick-album-reject').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).getAttribute('data-id');
        if (id) {
          await updateDoc(doc(db, 'album_submissions', id), { status: 'rejected' });
          loadAdminAlbums();
        }
      });
    });

    document.querySelectorAll('.btn-quick-album-delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).getAttribute('data-id');
        if (!id) return;
        
        const item = loadedAlbums.find((a) => a.id === id);
        if (item?.source === 'code') {
          if (confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn Album "${item.title}" khỏi file code src/data/albums.json không?\n(Hệ thống sẽ cập nhật trực tiếp lên GitHub)`)) {
            await deleteCodeAlbum(id);
          }
        } else {
          if (confirm('Bạn có chắc chắn muốn xóa album đóng góp này không?')) {
            await deleteDoc(doc(db, 'album_submissions', id));
            loadAdminAlbums();
          }
        }
      });
    });
  }

  // Render photo thumbnails with Delete action inside Modal
  function renderModalPhotoThumbnails() {
    if (!modalAlbumThumbnails) return;
    const countEl = document.getElementById('modal-photo-count');
    if (countEl) countEl.textContent = currentEditingPhotos.length.toString();

    if (currentEditingPhotos.length === 0) {
      modalAlbumThumbnails.innerHTML = '<p class="text-xs text-slate-400 col-span-full py-6 text-center italic">Album chưa có ảnh nào. Bấm nút "+ Thêm Ảnh Mới Vào Album" ở trên để bổ sung ảnh.</p>';
      return;
    }

    modalAlbumThumbnails.innerHTML = currentEditingPhotos
      .map((p, index) => {
        const src = typeof p === 'string' ? p : p.src;
        const caption = typeof p === 'object' && p.caption ? p.caption : '';
        return `
          <div class="relative group rounded-xl overflow-hidden border border-slate-200 aspect-square bg-slate-900 shadow-2xs">
            <img src="${src}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 cursor-pointer" onclick="window.open('${src}', '_blank')" />
            
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-1.5 p-1">
              <button
                type="button"
                class="btn-delete-single-photo p-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-[10px] font-bold transition cursor-pointer shadow-sm"
                data-index="${index}"
                title="Xóa ảnh này khỏi album"
              >
                🗑️
              </button>
            </div>

            <span class="absolute bottom-1 left-1 bg-black/70 text-white text-[9px] px-1.5 py-0.2 rounded font-mono">#${index + 1}</span>
          </div>
        `;
      })
      .join('');

    // Attach delete single photo listeners
    modalAlbumThumbnails.querySelectorAll('.btn-delete-single-photo').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute('data-index') || '-1', 10);
        if (idx >= 0 && idx < currentEditingPhotos.length) {
          currentEditingPhotos.splice(idx, 1);
          renderModalPhotoThumbnails();
        }
      });
    });
  }

  // Open Album Modal
  function openEditAlbumModal(id: string) {
    const item = loadedAlbums.find((a) => a.id === id);
    if (!item || !modalEditAlbum) return;

    const isCode = item.source === 'code';
    const typeBadge = document.getElementById('modal-album-type-badge');
    const mainTitle = document.getElementById('modal-album-main-title');
    const driveSection = document.getElementById('modal-drive-section');
    const statusSection = document.getElementById('modal-status-section');
    const sourceInput = document.getElementById('edit-album-source') as HTMLInputElement | null;

    if (sourceInput) sourceInput.value = isCode ? 'code' : 'firestore';

    if (typeBadge) {
      if (isCode) {
        typeBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800';
        typeBadge.textContent = '🏛️ Album Mã Nguồn (Code Web)';
      } else {
        typeBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800';
        typeBadge.textContent = '📥 Đóng Góp Người Dùng (Firestore)';
      }
    }

    if (mainTitle) {
      mainTitle.textContent = isCode ? `Biên Tập Album: ${item.title}` : 'Kiểm Duyệt & Xử Lý Album Đóng Góp';
    }

    if (driveSection) {
      if (isCode) driveSection.classList.add('hidden');
      else driveSection.classList.remove('hidden');
    }

    if (statusSection) {
      if (isCode) statusSection.classList.add('hidden');
      else statusSection.classList.remove('hidden');
    }

    if (modalAlbumDocId) modalAlbumDocId.textContent = id;
    if (editAlbumDocId) editAlbumDocId.value = id;
    if (editAlbumTitle) editAlbumTitle.value = item.title || '';
    if (editAlbumCategory) editAlbumCategory.value = item.category || 'truong-xua';
    if (editAlbumSender) editAlbumSender.value = item.senderName || 'CHS Xuân Lộc';
    if (editAlbumYear) editAlbumYear.value = item.year || '';
    if (editAlbumDriveUrl) editAlbumDriveUrl.value = item.driveUrl || '';
    if (editAlbumNote) editAlbumNote.value = item.note || '';

    if (btnOpenDrive) {
      if (item.driveUrl) {
        btnOpenDrive.href = item.driveUrl;
        btnOpenDrive.classList.remove('hidden');
      } else {
        btnOpenDrive.classList.add('hidden');
      }
    }

    // Load photos into state
    if (isCode && Array.isArray(item.photos)) {
      currentEditingPhotos = JSON.parse(JSON.stringify(item.photos));
    } else if (Array.isArray(item.previews)) {
      currentEditingPhotos = item.previews.map((src: string) => ({ src, caption: item.title }));
    } else {
      currentEditingPhotos = [];
    }

    renderModalPhotoThumbnails();

    // Close add photo box if open
    const addBox = document.getElementById('add-photo-box');
    if (addBox) addBox.classList.add('hidden');

    // Status Radio
    const statusVal = item.status || 'pending';
    const statusRadio = document.querySelector<HTMLInputElement>(`input[name="edit-album-status"][value="${statusVal}"]`);
    if (statusRadio) statusRadio.checked = true;

    modalEditAlbum.classList.remove('hidden');
  }

  // Elements for Upload & Paste
  const dropzonePasteArea = document.getElementById('dropzone-paste-area');
  const inputFilePhotos = document.getElementById('input-file-photos') as HTMLInputElement | null;
  const uploadProgressInfo = document.getElementById('upload-progress-info');
  const uploadProgressText = document.getElementById('upload-progress-text');

  // Compress Image to WebP Data URL client-side (Max 1600px, 82% quality)
  async function compressImageToWebP(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          const maxDim = 1600;

          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            resolve(e.target?.result as string);
            return;
          }

          ctx.drawImage(img, 0, 0, width, height);
          const webpDataUrl = canvas.toDataURL('image/webp', 0.82);
          resolve(webpDataUrl);
        };
        img.onerror = reject;
        img.src = e.target?.result as string;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  // Handle batch file additions (from File Input, Drag Drop or Clipboard)
  async function handleFilesAddition(files: FileList | File[]) {
    const fileArray = Array.from(files).filter((f) => f.type.startsWith('image/'));
    if (fileArray.length === 0) return;

    if (uploadProgressInfo && uploadProgressText) {
      uploadProgressInfo.classList.remove('hidden');
      uploadProgressText.textContent = `Đang xử lý & nén ${fileArray.length} hình ảnh...`;
    }

    const albumTitle = editAlbumTitle?.value.trim() || 'Album kỷ niệm';

    try {
      for (let i = 0; i < fileArray.length; i++) {
        const file = fileArray[i];
        if (uploadProgressText) {
          uploadProgressText.textContent = `Đang xử lý (${i + 1}/${fileArray.length}): ${file.name}...`;
        }
        const compressedWebp = await compressImageToWebP(file);
        currentEditingPhotos.push({
          src: compressedWebp,
          caption: albumTitle,
          originalUrl: file.name,
        });
      }

      renderModalPhotoThumbnails();
    } catch (err: any) {
      alert('Lỗi xử lý file ảnh: ' + (err.message || err));
    } finally {
      if (uploadProgressInfo) uploadProgressInfo.classList.add('hidden');
      if (inputFilePhotos) inputFilePhotos.value = '';
    }
  }

  // Click on dropzone triggers file picker
  dropzonePasteArea?.addEventListener('click', () => {
    inputFilePhotos?.click();
  });

  inputFilePhotos?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) {
      handleFilesAddition(files);
    }
  });

  // Drag and Drop Events
  dropzonePasteArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzonePasteArea.classList.add('border-warmOrange-500', 'bg-orange-50');
  });

  dropzonePasteArea?.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropzonePasteArea.classList.remove('border-warmOrange-500', 'bg-orange-50');
  });

  dropzonePasteArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzonePasteArea.classList.remove('border-warmOrange-500', 'bg-orange-50');
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
      handleFilesAddition(e.dataTransfer.files);
    }
  });

  // Global Paste Event (Ctrl + V) when Modal is Open
  document.addEventListener('paste', async (e: ClipboardEvent) => {
    if (!modalEditAlbum || modalEditAlbum.classList.contains('hidden')) return;

    // Don't intercept if user is typing in regular text inputs
    const activeEl = document.activeElement;
    if (activeEl && (activeEl.id === 'edit-album-title' || activeEl.id === 'edit-album-sender' || activeEl.id === 'edit-album-year' || activeEl.id === 'edit-album-driveUrl' || activeEl.id === 'edit-album-note' || activeEl.id === 'input-new-photos-urls')) {
      return;
    }

    const items = e.clipboardData?.items;
    if (!items) return;

    const imageFiles: File[] = [];
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        const file = items[i].getAsFile();
        if (file) imageFiles.push(file);
      }
    }

    if (imageFiles.length > 0) {
      e.preventDefault();
      // Ensure add photo box is visible
      if (addPhotoBox) addPhotoBox.classList.remove('hidden');
      await handleFilesAddition(imageFiles);
    }
  });

  // Toggle Add Photo Box
  const btnToggleAddPhoto = document.getElementById('btn-toggle-add-photo');
  const addPhotoBox = document.getElementById('add-photo-box');
  const btnCancelAddPhotos = document.getElementById('btn-cancel-add-photos');
  const btnConfirmAddPhotos = document.getElementById('btn-confirm-add-photos');
  const inputNewPhotosUrls = document.getElementById('input-new-photos-urls') as HTMLTextAreaElement | null;

  btnToggleAddPhoto?.addEventListener('click', () => {
    if (addPhotoBox) {
      addPhotoBox.classList.toggle('hidden');
      if (!addPhotoBox.classList.contains('hidden')) {
        inputNewPhotosUrls?.focus();
      }
    }
  });

  btnCancelAddPhotos?.addEventListener('click', () => {
    if (addPhotoBox) addPhotoBox.classList.add('hidden');
    if (inputNewPhotosUrls) inputNewPhotosUrls.value = '';
  });

  btnConfirmAddPhotos?.addEventListener('click', () => {
    const raw = inputNewPhotosUrls?.value.trim() || '';
    if (!raw) {
      alert('Vui lòng nhập ít nhất một đường dẫn ảnh!');
      inputNewPhotosUrls?.focus();
      return;
    }

    const urls = raw
      .split(/[\n,]/)
      .map((u) => u.trim())
      .filter((u) => u.startsWith('http://') || u.startsWith('https://'));

    if (urls.length === 0) {
      alert('Không tìm thấy đường dẫn ảnh hợp lệ (bắt đầu bằng http:// hoặc https://)');
      return;
    }

    const albumTitle = editAlbumTitle?.value.trim() || 'Album kỷ niệm';
    urls.forEach((url) => {
      currentEditingPhotos.push({
        src: url,
        caption: albumTitle,
        originalUrl: url,
      });
    });

    if (inputNewPhotosUrls) inputNewPhotosUrls.value = '';
    if (addPhotoBox) addPhotoBox.classList.add('hidden');
    renderModalPhotoThumbnails();
  });

  function closeAlbumModal() {
    if (modalEditAlbum) modalEditAlbum.classList.add('hidden');
  }

  btnCloseModalAlbum?.addEventListener('click', closeAlbumModal);
  btnModalAlbumCancel?.addEventListener('click', closeAlbumModal);

  modalEditAlbum?.addEventListener('click', (e) => {
    if (e.target === modalEditAlbum) closeAlbumModal();
  });

  // Save Album (handles both Code Album via GitHub API and Firestore submissions)
  btnModalAlbumSave?.addEventListener('click', async () => {
    const id = editAlbumDocId?.value;
    if (!id) return;

    const source = (document.getElementById('edit-album-source') as HTMLInputElement)?.value || 'firestore';
    const title = editAlbumTitle?.value.trim() || '';
    const category = editAlbumCategory?.value || 'truong-xua';
    const senderName = editAlbumSender?.value.trim() || '';
    const year = editAlbumYear?.value.trim() || '';
    const driveUrl = editAlbumDriveUrl?.value.trim() || '';
    const note = editAlbumNote?.value.trim() || '';
    const selectedStatus = document.querySelector<HTMLInputElement>('input[name="edit-album-status"]:checked')?.value || 'pending';

    if (!title) {
      alert('Vui lòng nhập tên Album!');
      editAlbumTitle?.focus();
      return;
    }

    if (btnModalAlbumSave) {
      btnModalAlbumSave.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>Đang lưu và đồng bộ...</span>`;
      (btnModalAlbumSave as HTMLButtonElement).disabled = true;
    }

    try {
      if (source === 'code') {
        // Update static album in memory & push to GitHub
        await saveCodeAlbumToGitHub(id, {
          title,
          photos: currentEditingPhotos,
          photoCount: currentEditingPhotos.length,
          coverImage: currentEditingPhotos[0]?.src || '',
        });
      } else {
        // Update Firestore album submission
        const previews = currentEditingPhotos.map((p) => (typeof p === 'string' ? p : p.src));
        await updateDoc(doc(db, 'album_submissions', id), {
          title,
          category,
          senderName,
          year,
          driveUrl,
          note,
          previews,
          photoCount: previews.length,
          status: selectedStatus,
          updatedAt: serverTimestamp(),
        });

        alert('🎉 Đã cập nhật thành công Album đóng góp!');
        closeAlbumModal();
        loadAdminAlbums();
      }
    } catch (err: any) {
      alert('❌ Lỗi khi cập nhật Album: ' + (err.message || err));
    } finally {
      if (btnModalAlbumSave) {
        btnModalAlbumSave.innerHTML = `<span>💾 Lưu Thay Đổi & Cập Nhật Code</span>`;
        (btnModalAlbumSave as HTMLButtonElement).disabled = false;
      }
    }
  });

  // Save Code Album directly to GitHub repo
  async function saveCodeAlbumToGitHub(slug: string, updatedFields: any) {
    if (!activePat) {
      alert('⚠️ Bạn cần cấu hình GitHub PAT trong tab Cài Đặt để cập nhật file code albums.json!');
      switchTab('settings');
      return;
    }

    const repoOwner = 'cfmvn';
    const repoName = 'chsxuanloc';
    const filePath = 'src/data/albums.json';

    // 1. Fetch current file sha & content from GitHub
    const getRes = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${filePath}`, {
      headers: {
        'Accept': 'application/vnd.github+json',
        'Authorization': `Bearer ${activePat}`,
        'X-GitHub-Api-Version': '2022-11-28',
      },
    });

    if (!getRes.ok) {
      throw new Error(`Không thể đọc file từ GitHub (${getRes.status}). Vui lòng kiểm tra lại GitHub Token.`);
    }

    const getData = await getRes.json();
    const currentSha = getData.sha;
    // Decode base64 UTF-8
    const rawContent = decodeURIComponent(escape(atob(getData.content.replace(/\n/g, ''))));
    const albumsArray: any[] = JSON.parse(rawContent);

    // 2. Find and update the album
    const idx = albumsArray.findIndex((a) => a.slug === slug);
    if (idx !== -1) {
      albumsArray[idx] = {
        ...albumsArray[idx],
        ...updatedFields,
      };
    } else {
      // Add new album to JSON
      albumsArray.unshift({
        slug,
        ...updatedFields,
      });
    }

    // 3. Encode back to UTF-8 Base64
    const newJsonString = JSON.stringify(albumsArray, null, 2);
    const encodedContent = btoa(unescape(encodeURIComponent(newJsonString)));

    // 4. Commit to GitHub
    const putRes = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${filePath}`, {
      method: 'PUT',
      headers: {
        'Accept': 'application/vnd.github+json',
        'Authorization': `Bearer ${activePat}`,
        'X-GitHub-Api-Version': '2022-11-28',
      },
      body: JSON.stringify({
        message: `feat(albums): cap nhat album [${slug}] - ${updatedFields.title} qua Admin Dashboard`,
        content: encodedContent,
        sha: currentSha,
        branch: 'main',
      }),
    });

    if (!putRes.ok) {
      const errData = await putRes.json().catch(() => ({}));
      throw new Error(`Lỗi ghi vào GitHub (${putRes.status}): ${errData.message || 'Thất bại'}`);
    }

    // Update in-memory static data
    allStaticAlbums = albumsArray;
    const staticEl = document.getElementById('static-albums-json');
    if (staticEl) staticEl.textContent = JSON.stringify(albumsArray);

    alert(`🎉 ĐÃ ĐỒNG BỘ THÀNH CÔNG VÀO GITHUB!\n\nAlbum "${updatedFields.title}" đã được cập nhật trực tiếp vào file src/data/albums.json trên repo.\nCloudflare Pages sẽ tự động build lại trong 1 phút.`);
    closeAlbumModal();
    loadAdminAlbums();
  }

  // Delete Code Album directly from GitHub repo
  async function deleteCodeAlbum(slug: string) {
    if (!activePat) {
      alert('⚠️ Bạn cần cấu hình GitHub PAT trong tab Cài Đặt để xóa album khỏi file code!');
      switchTab('settings');
      return;
    }

    try {
      const repoOwner = 'cfmvn';
      const repoName = 'chsxuanloc';
      const filePath = 'src/data/albums.json';

      const getRes = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${filePath}`, {
        headers: {
          'Accept': 'application/vnd.github+json',
          'Authorization': `Bearer ${activePat}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
      });

      if (!getRes.ok) throw new Error('Không thể đọc file từ GitHub');

      const getData = await getRes.json();
      const currentSha = getData.sha;
      const rawContent = decodeURIComponent(escape(atob(getData.content.replace(/\n/g, ''))));
      const albumsArray: any[] = JSON.parse(rawContent);

      const filtered = albumsArray.filter((a) => a.slug !== slug);
      const newJsonString = JSON.stringify(filtered, null, 2);
      const encodedContent = btoa(unescape(encodeURIComponent(newJsonString)));

      const putRes = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${filePath}`, {
        method: 'PUT',
        headers: {
          'Accept': 'application/vnd.github+json',
          'Authorization': `Bearer ${activePat}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({
          message: `chore(albums): xoa album [${slug}] qua Admin Dashboard`,
          content: encodedContent,
          sha: currentSha,
          branch: 'main',
        }),
      });

      if (!putRes.ok) throw new Error('Lỗi khi xóa album trên GitHub');

      allStaticAlbums = filtered;
      alert('🎉 Đã xóa thành công Album khỏi file code GitHub!');
      loadAdminAlbums();
    } catch (err: any) {
      alert('❌ Lỗi khi xóa album: ' + (err.message || err));
    }
  }

  // Delete Album from Modal
  btnModalAlbumDelete?.addEventListener('click', async () => {
    const id = editAlbumDocId?.value;
    if (!id) return;

    const source = (document.getElementById('edit-album-source') as HTMLInputElement)?.value || 'firestore';
    if (source === 'code') {
      if (confirm('Bạn có chắc chắn muốn xóa album này vĩnh viễn khỏi file code GitHub không?')) {
        closeAlbumModal();
        await deleteCodeAlbum(id);
      }
    } else {
      if (confirm('Bạn có chắc chắn muốn xóa album đóng góp này không?')) {
        try {
          await deleteDoc(doc(db, 'album_submissions', id));
          alert('Đã xóa album thành công!');
          closeAlbumModal();
          loadAdminAlbums();
        } catch (err: any) {
          alert('❌ Lỗi khi xóa album: ' + (err.message || err));
        }
      }
    }
  });

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
