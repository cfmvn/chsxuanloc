  // Open Edit Modal
  function openEditModal(id: string) {
    const item = loadedSubmissions.find((s) => s.id === id);
    if (!item || !modalEditSubmission) return;

    if (modalDocId) modalDocId.textContent = id;
    if (editDocId) editDocId.value = id;
    if (editFullName) editFullName.value = item.fullName || '';
    if (editBatch) editBatch.value = item.batch || '';
    if (editClassName) editClassName.value = item.className || '';
    if (editTopic) editTopic.value = item.topic || 'ao-trang';
    if (editTitle) editTitle.value = item.title || '';
    if (editMessage) editMessage.value = item.message || '';

    // Set status radio
    const statusVal = item.status || 'pending';
    const statusRadio = document.querySelector<HTMLInputElement>(`input[name="edit-status"][value="${statusVal}"]`);
    if (statusRadio) statusRadio.checked = true;

    // Image preview
    if (modalImagePreviewWrap && modalImagePreview) {
      if (item.imageUrl) {
        modalImagePreview.src = item.imageUrl;
        modalImagePreviewWrap.classList.remove('hidden');
      } else {
        modalImagePreviewWrap.classList.add('hidden');
      }
    }

    modalEditSubmission.classList.remove('hidden');
  }

  function closeModal() {
    if (modalEditSubmission) modalEditSubmission.classList.add('hidden');
  }

  btnCloseModal?.addEventListener('click', closeModal);
  btnModalCancel?.addEventListener('click', closeModal);

  // Close modal when clicking outside
  modalEditSubmission?.addEventListener('click', (e) => {
    if (e.target === modalEditSubmission) closeModal();
  });

  // Save changes from Modal
  btnModalSave?.addEventListener('click', async () => {
    const id = editDocId?.value;
    if (!id) return;

    const fullName = editFullName?.value.trim() || '';
    const batch = editBatch?.value.trim() || '';
    const className = editClassName?.value.trim() || '';
    const topic = editTopic?.value || 'ao-trang';
    const title = editTitle?.value.trim() || '';
    const message = editMessage?.value.trim() || '';
    const selectedStatus = document.querySelector<HTMLInputElement>('input[name="edit-status"]:checked')?.value || 'pending';

    if (!message) {
      alert('Vui lòng nhập nội dung bài viết!');
      editMessage?.focus();
      return;
    }

    if (btnModalSave) {
      btnModalSave.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>Đang lưu...</span>`;
      (btnModalSave as HTMLButtonElement).disabled = true;
    }

    try {
      await updateDoc(doc(db, 'submissions', id), {
        fullName,
        batch,
        className,
        topic,
        title,
        message,
        status: selectedStatus,
        updatedAt: serverTimestamp(),
      });

      alert('🎉 Đã cập nhật thành công bài viết!');
      closeModal();
      loadAdminSubmissions();
    } catch (err: any) {
      alert('❌ Lỗi khi cập nhật bài viết: ' + (err.message || err));
    } finally {
      if (btnModalSave) {
        btnModalSave.innerHTML = `<span>💾 Lưu & Áp Dụng</span>`;
        (btnModalSave as HTMLButtonElement).disabled = false;
      }
    }
  });

  // Delete from Modal
  btnModalDelete?.addEventListener('click', async () => {
    const id = editDocId?.value;
    if (!id || !confirm('Bạn có chắc chắn muốn xóa bài viết này vĩnh viễn khỏi hệ thống không?')) return;

    try {
      await deleteDoc(doc(db, 'submissions', id));
      alert('Đã xóa bài viết thành công!');
      closeModal();
      loadAdminSubmissions();
    } catch (err: any) {
      alert('❌ Lỗi khi xóa bài viết: ' + (err.message || err));
    }
  });


  // Load scholarships for Admin review
  async function loadAdminScholarships() {
    if (!scholarshipsTbody) return;

    try {
      const q = query(collection(db, 'scholarships'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      scholarshipsTbody.innerHTML = '';
      if (snapshot.empty) {
        scholarshipsTbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Chưa có thông tin đăng ký tài trợ nào</td></tr>';
        return;
      }

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const dateStr = item.createdAt ? new Date(item.createdAt.toDate()).toLocaleDateString('vi-VN') : '';
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="p-3.5 font-bold text-navy-900">${escapeHtml(item.fullName)}</td>
          <td class="p-3.5">${escapeHtml(item.batch || '—')}</td>
          <td class="p-3.5 text-warmOrange-600 font-mono">${escapeHtml(item.phone)}</td>
          <td class="p-3.5 font-semibold text-emerald-700">${escapeHtml(item.amount)} đ</td>
          <td class="p-3.5 text-slate-500 max-w-xs truncate" title="${escapeHtml(item.note || '')}">${escapeHtml(item.note || '—')}</td>
          <td class="p-3.5 text-slate-400">${dateStr}</td>
        `;
        scholarshipsTbody.appendChild(tr);
      });
    } catch (err) {
      console.error('Lỗi khi fetch scholarships:', err);
    }
  }

  // Album Filter switching
  albumFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentAlbumFilter = btn.getAttribute('data-status') || 'pending';
      albumFilterBtns.forEach((b) => {
        b.classList.remove('bg-white', 'text-navy-950', 'shadow-xs', 'font-bold');
        b.classList.add('text-slate-600', 'font-medium');
      });
      btn.classList.remove('text-slate-600', 'font-medium');
      btn.classList.add('bg-white', 'text-navy-950', 'shadow-xs', 'font-bold');
      renderFilteredAlbums();
    });
  });

  // Current editing photos state
  let currentEditingPhotos: Array<{ src: string; caption?: string; originalUrl?: string }> = [];

  // Parse static albums from injected payload
  function getStaticAlbums(): any[] {
    try {
      const el = document.getElementById('static-albums-json');
      if (el && el.textContent) {
        return JSON.parse(el.textContent);
      }
    } catch (e) {
      console.error('Error parsing static albums:', e);
    }
    return [];
  }

  let allStaticAlbums: any[] = getStaticAlbums();

  // Load Album Submissions from Firestore & Merge with Code Albums
  async function loadAdminAlbums() {
    if (!albumsTableWrap || !albumsLoading || !albumsEmpty) return;
    albumsLoading.classList.remove('hidden');
    albumsEmpty.classList.add('hidden');
    albumsTableWrap.classList.add('hidden');

    try {
      const q = query(collection(db, 'album_submissions'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      albumsLoading.classList.add('hidden');

      loadedAlbums = [];
      let countP = 0;
      let countA = 0;
      let countR = 0;

      // 1. Add Firestore submissions
      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const id = docSnap.id;
        const entry = { id, source: 'firestore', ...item };
        loadedAlbums.push(entry);

        if (item.status === 'pending' || !item.status) countP++;
        else if (item.status === 'approved') countA++;
        else if (item.status === 'rejected') countR++;
      });

      // 2. Add Code Albums from albums.json as 'approved'
      allStaticAlbums.forEach((alb) => {
        // Tag category based on title
        const t = (alb.title || '').toLowerCase();
        let cat = 'truong-xua';
        if (t.includes('khai giảng') || t.includes('tổng kết') || t.includes('sơ kết') || t.includes('chuẩn quốc gia') || t.includes('nhà trường')) {
          cat = 'nha-truong';
        } else if (t.includes('20-11') || t.includes('20/11') || t.includes('nhà giáo') || t.includes('thầy cô') || t.includes('tri ân') || t.includes('giao ước')) {
          cat = 'tri-an';
        } else if (t.includes('nguồn') || t.includes('núi') || t.includes('chứa chan') || t.includes('dã ngoại') || t.includes('hội trại') || t.includes('tham quan') || t.includes('bóng đá') || t.includes('thể thao')) {
          cat = 'hoat-dong';
        } else if (t.includes('kỷ yếu') || t.includes('lưu bút') || t.includes('họp lớp') || t.includes('khóa') || t.includes('lớp')) {
          cat = 'ky-yeu';
        }

        loadedAlbums.push({
          id: alb.slug,
          slug: alb.slug,
          title: alb.title,
          category: cat,
          senderName: 'CHS Xuân Lộc',
          year: alb.slug.match(/\d{4}/)?.[0] || '',
          photoCount: alb.photoCount || alb.photos?.length || 0,
          photos: alb.photos || [],
          coverImage: alb.coverImage,
          previews: (alb.photos || []).slice(0, 8).map((p: any) => p.src),
          status: 'approved',
          source: 'code',
          createdAt: new Date('2026-01-01T00:00:00'),
        });
        countA++;
      });

      if (badgeAlbumsPending) badgeAlbumsPending.textContent = countP.toString();
      if (badgeAlbumsApproved) badgeAlbumsApproved.textContent = countA.toString();
      if (badgeAlbumsRejected) badgeAlbumsRejected.textContent = countR.toString();
      if (badgeAlbumsAll) badgeAlbumsAll.textContent = loadedAlbums.length.toString();
      if (countPendingAlbums) countPendingAlbums.textContent = countP.toString();

      renderFilteredAlbums();
    } catch (err: any) {
      console.error('Lỗi khi fetch album_submissions:', err);
      albumsLoading.classList.add('hidden');
      if (albumsEmpty) albumsEmpty.classList.remove('hidden');
    }
  }

  // Render filtered albums
