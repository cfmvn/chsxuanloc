                      id="btn-clear-pat" 
                      class="px-3 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-semibold transition"
                      title="Xóa token khỏi hệ thống"
                    >
                      Xóa
                    </button>
                  </div>
                </div>

                <div id="pat-feedback" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

                <div class="text-[11px] text-slate-500 space-y-1 pt-1">
                  <p>🔒 <strong>Cơ chế bảo mật:</strong> Token được lưu trữ an toàn trong Cloud Firestore (Collection <code>settings/app_config</code>) và đồng bộ trong trình duyệt của Ban Quản Trị.</p>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { auth, googleProvider, db } from '../lib/firebase';
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
  import { collection, query, orderBy, getDocs, doc, setDoc, getDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';

  const loginRequired = document.getElementById('login-required');
  const adminDashboard = document.getElementById('admin-dashboard');
  const authActions = document.getElementById('auth-actions');
  const googleBtn = document.getElementById('google-signin-btn');
  
  const tabSubmissions = document.getElementById('tab-submissions');
  const tabAlbums = document.getElementById('tab-albums');
  const tabScholarships = document.getElementById('tab-scholarships');
  const tabAutomation = document.getElementById('tab-automation');
  const tabSettings = document.getElementById('tab-settings');
  const tabAutoBadge = document.getElementById('tab-auto-badge');

  const panelSubmissions = document.getElementById('panel-submissions');
  const panelAlbums = document.getElementById('panel-albums');
  const panelScholarships = document.getElementById('panel-scholarships');
  const panelAutomation = document.getElementById('panel-automation');
  const panelSettings = document.getElementById('panel-settings');
  const autoLockedBanner = document.getElementById('automation-locked-banner');

  const ghPatInput = document.getElementById('gh-pat-input') as HTMLInputElement | null;
  const btnSavePat = document.getElementById('btn-save-pat');
  const btnClearPat = document.getElementById('btn-clear-pat');
  const btnTogglePatVisibility = document.getElementById('btn-toggle-pat-visibility');
  const patStatusBadge = document.getElementById('pat-status-badge');
  const btnGoToSettings = document.getElementById('btn-go-to-settings');

  const btnTriggerSyncNews = document.getElementById('btn-trigger-sync-news') as HTMLButtonElement | null;
  const btnTriggerGenerateStory = document.getElementById('btn-trigger-generate-story') as HTMLButtonElement | null;
  const btnTriggerDeploy = document.getElementById('btn-trigger-deploy') as HTMLButtonElement | null;
  const btnRefreshSubmissions = document.getElementById('btn-refresh-submissions');
  const btnRefreshAlbums = document.getElementById('btn-refresh-albums');
  const btnRefreshScholarships = document.getElementById('btn-refresh-scholarships');

  const submissionsTableWrap = document.getElementById('submissions-table-wrap');
  const submissionsTbody = document.getElementById('submissions-tbody');
  const submissionsLoading = document.getElementById('submissions-table-loading');
  const submissionsEmpty = document.getElementById('submissions-table-empty');
  const countPending = document.getElementById('count-pending');
  const badgePending = document.getElementById('badge-pending');
  const badgeApproved = document.getElementById('badge-approved');
  const badgeRejected = document.getElementById('badge-rejected');
  const badgeAll = document.getElementById('badge-all');
  const subFilterBtns = document.querySelectorAll<HTMLButtonElement>('.sub-filter-btn');

  // Album Submission Elements
  const albumsTableWrap = document.getElementById('albums-table-wrap');
  const albumsTbody = document.getElementById('albums-tbody');
  const albumsLoading = document.getElementById('albums-table-loading');
  const albumsEmpty = document.getElementById('albums-table-empty');
  const countPendingAlbums = document.getElementById('count-pending-albums');
  const badgeAlbumsPending = document.getElementById('badge-albums-pending');
  const badgeAlbumsApproved = document.getElementById('badge-albums-approved');
  const badgeAlbumsRejected = document.getElementById('badge-albums-rejected');
  const badgeAlbumsAll = document.getElementById('badge-albums-all');
  const albumFilterBtns = document.querySelectorAll<HTMLButtonElement>('.album-filter-btn');

  // Album Modal elements
  const modalEditAlbum = document.getElementById('modal-edit-album');
  const btnCloseModalAlbum = document.getElementById('btn-close-modal-album');
  const btnModalAlbumCancel = document.getElementById('btn-modal-album-cancel');
  const btnModalAlbumSave = document.getElementById('btn-modal-album-save');
  const btnModalAlbumDelete = document.getElementById('btn-modal-album-delete');
  const modalAlbumDocId = document.getElementById('modal-album-doc-id');
  const editAlbumDocId = document.getElementById('edit-album-doc-id') as HTMLInputElement | null;
  const editAlbumTitle = document.getElementById('edit-album-title') as HTMLInputElement | null;
  const editAlbumCategory = document.getElementById('edit-album-category') as HTMLSelectElement | null;
  const editAlbumSender = document.getElementById('edit-album-sender') as HTMLInputElement | null;
  const editAlbumYear = document.getElementById('edit-album-year') as HTMLInputElement | null;
  const editAlbumDriveUrl = document.getElementById('edit-album-driveUrl') as HTMLInputElement | null;
  const editAlbumNote = document.getElementById('edit-album-note') as HTMLTextAreaElement | null;
  const btnOpenDrive = document.getElementById('btn-open-drive') as HTMLAnchorElement | null;
  const modalAlbumThumbnails = document.getElementById('modal-album-thumbnails');

  // Modal elements
  const modalEditSubmission = document.getElementById('modal-edit-submission');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnModalCancel = document.getElementById('btn-modal-cancel');
  const btnModalSave = document.getElementById('btn-modal-save');
  const btnModalDelete = document.getElementById('btn-modal-delete');
  const modalDocId = document.getElementById('modal-doc-id');
  const editDocId = document.getElementById('edit-doc-id') as HTMLInputElement | null;
  const editFullName = document.getElementById('edit-fullName') as HTMLInputElement | null;
  const editBatch = document.getElementById('edit-batch') as HTMLInputElement | null;
  const editClassName = document.getElementById('edit-className') as HTMLInputElement | null;
  const editTopic = document.getElementById('edit-topic') as HTMLSelectElement | null;
  const editTitle = document.getElementById('edit-title') as HTMLInputElement | null;
  const editMessage = document.getElementById('edit-message') as HTMLTextAreaElement | null;
  const modalImagePreviewWrap = document.getElementById('modal-image-preview-wrap');
  const modalImagePreview = document.getElementById('modal-image-preview') as HTMLImageElement | null;

  const scholarshipsTbody = document.getElementById('scholarships-tbody');

  // State
  let loadedSubmissions: any[] = [];
  let currentSubFilter = 'pending';
  let loadedAlbums: any[] = [];
  let currentAlbumFilter = 'pending';

  // Danh mục Album mapping
  const albumCategoryMap: Record<string, { label: string; icon: string }> = {
    'nha-truong': { label: 'Nhà Trường', icon: '🏫' },
    'tri-an': { label: 'Tri Ân', icon: '💐' },
    'hoat-dong': { label: 'Hoạt Động', icon: '🏕️' },
    'truong-xua': { label: 'Trường Xưa', icon: '🏛️' },
    'ky-yeu': { label: 'Kỷ Yếu', icon: '📖' },
    'khac': { label: 'Khác', icon: '✨' },
  };

  // Danh sách Email Admin được ủy quyền
  const allowedAdminEmailsStr = import.meta.env.PUBLIC_ADMIN_EMAILS || 'chsxuanloc@gmail.com,thepottershousevn@gmail.com';
  const allowedAdminEmails = allowedAdminEmailsStr
    .split(',')
    .map((e: string) => e.trim().toLowerCase())
    .filter(Boolean);

  // Local storage cache key
  const STORAGE_KEY_GH_PAT = 'chs_admin_gh_pat';
  // Khởi tạo activePat ngay lập tức từ localStorage khi load trang
  let activePat = (typeof localStorage !== 'undefined' ? (localStorage.getItem(STORAGE_KEY_GH_PAT) || '') : '').trim();

  // Tab Manager with URL Hash sync
  function switchTab(tabName: string, pushHash = true) {
    const validTabs = ['submissions', 'albums', 'scholarships', 'automation', 'settings'];
    const activeTab = validTabs.includes(tabName) ? tabName : 'submissions';

    // If trying to open automation but token is missing, redirect with warning
    if (activeTab === 'automation' && !activePat) {
      if (autoLockedBanner) autoLockedBanner.classList.remove('hidden');
    } else {
      if (autoLockedBanner) autoLockedBanner.classList.add('hidden');
    }

    const tabsMap: Record<string, { tabEl: HTMLElement | null; panelEl: HTMLElement | null }> = {
      submissions: { tabEl: tabSubmissions, panelEl: panelSubmissions },
      albums: { tabEl: tabAlbums, panelEl: panelAlbums },
      scholarships: { tabEl: tabScholarships, panelEl: panelScholarships },
      automation: { tabEl: tabAutomation, panelEl: panelAutomation },
      settings: { tabEl: tabSettings, panelEl: panelSettings },
    };

    Object.keys(tabsMap).forEach((key) => {
      const item = tabsMap[key];
      if (key === activeTab) {
        item.tabEl?.classList.remove('border-transparent', 'text-slate-500');
        item.tabEl?.classList.add('border-warmOrange-500', 'font-bold', 'text-navy-900');
        item.panelEl?.classList.remove('hidden');
      } else {
        item.tabEl?.classList.remove('border-warmOrange-500', 'font-bold', 'text-navy-900');
        item.tabEl?.classList.add('border-transparent', 'text-slate-500');
        item.panelEl?.classList.add('hidden');
      }
    });

    if (pushHash) {
      history.replaceState(null, '', `#${activeTab}`);
    }
  }

  // Bind Tab Click Events
  tabSubmissions?.addEventListener('click', () => switchTab('submissions'));
  tabAlbums?.addEventListener('click', () => switchTab('albums'));
  tabScholarships?.addEventListener('click', () => switchTab('scholarships'));
  tabAutomation?.addEventListener('click', () => {
    // Luôn kiểm tra activePat mới nhất (hoặc lấy từ localStorage nếu có)
    if (!activePat) {
      const cached = (localStorage.getItem(STORAGE_KEY_GH_PAT) || '').trim();
      if (cached) {
        updatePatState(cached);
      }
    }

    if (!activePat) {
      alert('⚠️ Bạn chưa cấu hình GitHub Personal Access Token. Vui lòng cài đặt trước!');
      switchTab('settings');
      ghPatInput?.focus();
    } else {
      switchTab('automation');
    }
  });
  tabSettings?.addEventListener('click', () => switchTab('settings'));
  btnGoToSettings?.addEventListener('click', () => switchTab('settings'));

  // Listen to hash changes in browser
  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) switchTab(hash, false);
  });

  // Update PAT Status UI
  function updatePatState(token: string) {
    activePat = (token || '').trim();

    if (activePat) {
      if (ghPatInput) ghPatInput.value = activePat;
      if (patStatusBadge) {
        patStatusBadge.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-800';
        patStatusBadge.textContent = '🟢 Đã cấu hình Token';
      }
      if (tabAutoBadge) tabAutoBadge.classList.add('hidden');
      if (tabAutomation) tabAutomation.classList.remove('opacity-60');
      if (btnTriggerSyncNews) btnTriggerSyncNews.disabled = false;
      if (btnTriggerGenerateStory) btnTriggerGenerateStory.disabled = false;
      if (btnTriggerDeploy) btnTriggerDeploy.disabled = false;
      if (autoLockedBanner) autoLockedBanner.classList.add('hidden');
    } else {
      if (ghPatInput) ghPatInput.value = '';
      if (patStatusBadge) {
        patStatusBadge.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-800';
        patStatusBadge.textContent = '🔴 Chưa cài đặt Token';
      }
      if (tabAutoBadge) tabAutoBadge.classList.remove('hidden');
      if (tabAutomation) tabAutomation.classList.add('opacity-60');
      if (btnTriggerSyncNews) btnTriggerSyncNews.disabled = true;
      if (btnTriggerGenerateStory) btnTriggerGenerateStory.disabled = true;
      if (btnTriggerDeploy) btnTriggerDeploy.disabled = true;
    }
  }

  const patFeedback = document.getElementById('pat-feedback');

  function showPatFeedback(msg: string, type: 'success' | 'error' | 'info') {
    if (!patFeedback) return;
    patFeedback.className = `p-3 rounded-xl text-xs font-semibold ${
      type === 'success' 
        ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
        : type === 'error'
        ? 'bg-rose-50 text-rose-800 border border-rose-200'
        : 'bg-blue-50 text-blue-800 border border-blue-200'
    }`;
    patFeedback.textContent = msg;
    patFeedback.classList.remove('hidden');
  }

  // Load PAT from Firestore and LocalStorage
  async function loadPatFromDatabase() {
    // 1. Kiểm tra LocalStorage trước để render giao diện tức thì
    const cachedPat = (localStorage.getItem(STORAGE_KEY_GH_PAT) || '').trim();
    if (cachedPat) {
      updatePatState(cachedPat);
    }

    // 2. Fetch config từ Firestore settings/app_config
    try {
      const snap = await getDoc(doc(db, 'settings', 'app_config'));
      if (snap.exists() && snap.data()?.githubPat) {
        const dbPat = (snap.data().githubPat || '').trim();
        if (dbPat) {
          localStorage.setItem(STORAGE_KEY_GH_PAT, dbPat);
          updatePatState(dbPat);
          return;
        }
      }
      
      // Nếu Firestore chưa có nhưng LocalStorage đã có token, ta tự động đồng bộ ngược lên Firestore
      if (cachedPat) {
        setDoc(doc(db, 'settings', 'app_config'), {
          githubPat: cachedPat,
          updatedAt: serverTimestamp(),
          updatedBy: auth.currentUser?.email || 'admin',
        }, { merge: true }).catch(() => {});
      }
    } catch (err) {
      console.warn('Lỗi khi đọc token từ Firestore (vẫn sử dụng token lưu trong trình duyệt):', err);
      // Giữ nguyên cachedPat, không xóa token
      if (cachedPat) {
        updatePatState(cachedPat);
      }
    }
  }

  // Save PAT to Firestore & LocalStorage
  btnSavePat?.addEventListener('click', async () => {
    const val = (ghPatInput?.value || '').trim();
    if (!val) {
      showPatFeedback('⚠️ Vui lòng nhập GitHub Personal Access Token trước khi lưu!', 'error');
      ghPatInput?.focus();
      return;
    }

    // 1. Lưu ngay tức thì vào LocalStorage & cập nhật UI
    localStorage.setItem(STORAGE_KEY_GH_PAT, val);
    updatePatState(val);
    showPatFeedback('✓ Đang lưu Token và đồng bộ lên Database...', 'info');

    // 2. Đồng bộ lên Firestore
    try {
      await setDoc(doc(db, 'settings', 'app_config'), {
        githubPat: val,
        updatedAt: serverTimestamp(),
        updatedBy: auth.currentUser?.email || 'admin',
      }, { merge: true });

      showPatFeedback('🎉 Đã lưu thành công GitHub Token vào cơ sở dữ liệu và trình duyệt! Tab Tự Động Hóa đã sẵn sàng hoạt động.', 'success');
    } catch (err: any) {
      console.warn('Lỗi khi sync PAT lên Firestore:', err);
      showPatFeedback('✓ Đã lưu Token vào trình duyệt của bạn (Tab Tự Động Hóa đã sẵn sàng hoạt động)!', 'success');
    }
  });

  // Clear PAT
  btnClearPat?.addEventListener('click', async () => {
    if (!confirm('Bạn có chắc chắn muốn xóa Token khỏi hệ thống không?')) return;

    localStorage.removeItem(STORAGE_KEY_GH_PAT);
    updatePatState('');
    showPatFeedback('Đã xóa Token khỏi hệ thống.', 'info');

    try {
      await setDoc(doc(db, 'settings', 'app_config'), {
        githubPat: '',
        updatedAt: serverTimestamp(),
      }, { merge: true });
    } catch {}
  });

  // Toggle Visibility
  btnTogglePatVisibility?.addEventListener('click', () => {
    if (ghPatInput) {
      ghPatInput.type = ghPatInput.type === 'password' ? 'text' : 'password';
    }
  });

  // Function to dispatch GitHub Action workflow
  async function triggerGitHubWorkflow(workflowFile: string, btnElement: HTMLElement | null, successMsg: string) {
    if (!activePat) {
      alert('⚠️ Bạn chưa cài đặt GitHub Personal Access Token (PAT). Vui lòng vào tab Cài Đặt!');
      switchTab('settings');
      ghPatInput?.focus();
      return;
    }

    if (!btnElement) return;
    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>Đang gửi lệnh tới GitHub...</span>`;
    (btnElement as HTMLButtonElement).disabled = true;

    try {
      const repoOwner = 'cfmvn';
      const repoName = 'chsxuanloc';
      const response = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/actions/workflows/${workflowFile}/dispatches`, {
        method: 'POST',
        headers: {
          'Accept': 'application/vnd.github+json',
          'Authorization': `Bearer ${activePat}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({
          ref: 'main'
        })
      });

      if (response.status === 204) {
        alert(`🎉 Thành công! ${successMsg}\nGitHub Actions đang xử lý trong nền.`);
      } else {
        const data = await response.json().catch(() => ({}));
        alert(`❌ Lỗi (${response.status}): ${data.message || 'Không thể kích hoạt workflow. Vui lòng kiểm tra lại Token trong tab Cài Đặt!'}`);
      }
    } catch (err: any) {
      alert('❌ Lỗi kết nối tới GitHub API: ' + (err.message || err));
    } finally {
      btnElement.innerHTML = originalText;
      (btnElement as HTMLButtonElement).disabled = false;
    }
  }

  btnTriggerSyncNews?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình AI Quét tin tức Fanpage & Cổng TTĐT ngay bây giờ?')) {
      triggerGitHubWorkflow('sync-news.yml', btnTriggerSyncNews, 'Đã kích hoạt quét & xuất bản tin tức trường!');
    }
  });

  btnTriggerGenerateStory?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt AI sáng tác 1 bài viết mới cho Góc Tâm Tình ngay bây giờ?')) {
      triggerGitHubWorkflow('generate-tam-su.yml', btnTriggerGenerateStory, 'Đã kích hoạt AI sáng tác bài viết mới cho Góc Tâm Tình!');
    }
  });

  btnTriggerDeploy?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình Build & Deploy lại toàn bộ website lên Firebase Hosting?')) {
      triggerGitHubWorkflow('deploy.yml', btnTriggerDeploy, 'Đã kích hoạt Deploy website lên Firebase Hosting!');
    }
  });

  // Auth State Listener
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      const userEmail = (user.email || '').toLowerCase().trim();
      const isAuthorized = allowedAdminEmails.includes(userEmail);

      if (!isAuthorized) {
        alert(`Tài khoản "${user.email}" không thuộc danh sách Ban Quản Trị được cấp quyền.`);
        await signOut(auth);
        if (loginRequired) loginRequired.classList.remove('hidden');
        if (adminDashboard) adminDashboard.classList.add('hidden');
        if (authActions) authActions.innerHTML = '';
        return;
      }

      if (loginRequired) loginRequired.classList.add('hidden');
      if (adminDashboard) adminDashboard.classList.remove('hidden');

      if (authActions) {
        authActions.innerHTML = `
          <div class="flex items-center space-x-3">
            <span class="text-xs text-emerald-400 font-semibold hidden sm:inline">🛡️ ${user.displayName || user.email}</span>
            <button id="btn-signout" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600/80 hover:bg-rose-600 text-white transition">
              Đăng xuất
            </button>
          </div>
        `;
        document.getElementById('btn-signout')?.addEventListener('click', () => signOut(auth));
      }

      // Load Settings & Data
      await loadPatFromDatabase();

      // Activate initial tab from URL hash
      const initialHash = window.location.hash.replace('#', '');
      switchTab(initialHash || 'submissions', false);

      loadAdminSubmissions();
      loadAdminAlbums();
      loadAdminScholarships();

    } else {
      if (loginRequired) loginRequired.classList.remove('hidden');
      if (adminDashboard) adminDashboard.classList.add('hidden');
      if (authActions) authActions.innerHTML = '';
    }
  });

  googleBtn?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập thất bại: ' + (err.message || 'Lỗi không xác định'));
    }
  });

  btnRefreshSubmissions?.addEventListener('click', () => loadAdminSubmissions());
  btnRefreshAlbums?.addEventListener('click', () => loadAdminAlbums());
  btnRefreshScholarships?.addEventListener('click', () => loadAdminScholarships());

  // Status Filter switching
  subFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentSubFilter = btn.getAttribute('data-status') || 'pending';
      subFilterBtns.forEach((b) => {
        b.classList.remove('bg-white', 'text-navy-950', 'shadow-xs', 'font-bold');
        b.classList.add('text-slate-600', 'font-medium');
      });
      btn.classList.remove('text-slate-600', 'font-medium');
      btn.classList.add('bg-white', 'text-navy-950', 'shadow-xs', 'font-bold');
      renderFilteredSubmissions();
    });
  });

  // Topic Map
  const topicMap: Record<string, { label: string; icon: string }> = {
    'ao-trang': { label: 'Áo trắng & Bạn cũ', icon: '🌸' },
    'thay-co': { label: 'Bên bục giảng', icon: '💐' },
    'lap-nghiep': { label: 'Lập nghiệp', icon: '💼' },
    'tam-tinh': { label: 'Tâm tình', icon: '💌' },
  };

  // Load submissions from Firestore
  async function loadAdminSubmissions() {
    if (!submissionsTableWrap || !submissionsLoading || !submissionsEmpty) return;
    submissionsLoading.classList.remove('hidden');
    submissionsEmpty.classList.add('hidden');
    submissionsTableWrap.classList.add('hidden');

    try {
      const q = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      submissionsLoading.classList.add('hidden');

      loadedSubmissions = [];
      let countP = 0;
      let countA = 0;
      let countR = 0;

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const id = docSnap.id;
        const entry = { id, ...item };
        loadedSubmissions.push(entry);

        if (item.status === 'pending' || !item.status) countP++;
        else if (item.status === 'approved') countA++;
        else if (item.status === 'rejected') countR++;
      });

      if (badgePending) badgePending.textContent = countP.toString();
      if (badgeApproved) badgeApproved.textContent = countA.toString();
      if (badgeRejected) badgeRejected.textContent = countR.toString();
      if (badgeAll) badgeAll.textContent = loadedSubmissions.length.toString();
      if (countPending) countPending.textContent = countP.toString();

      renderFilteredSubmissions();
    } catch (err) {
      console.error('Lỗi khi fetch Admin submissions:', err);
      if (submissionsLoading) submissionsLoading.classList.add('hidden');
      if (submissionsEmpty) submissionsEmpty.classList.remove('hidden');
    }
  }

  // Render submissions table according to selected filter
  function renderFilteredSubmissions() {
    if (!submissionsTbody || !submissionsTableWrap || !submissionsEmpty) return;

    let filtered = loadedSubmissions;
    if (currentSubFilter === 'pending') {
      filtered = loadedSubmissions.filter((s) => s.status === 'pending' || !s.status);
    } else if (currentSubFilter === 'approved') {
      filtered = loadedSubmissions.filter((s) => s.status === 'approved');
    } else if (currentSubFilter === 'rejected') {
      filtered = loadedSubmissions.filter((s) => s.status === 'rejected');
    }

    if (filtered.length === 0) {
      submissionsTableWrap.classList.add('hidden');
      submissionsEmpty.classList.remove('hidden');
      return;
    }

    submissionsEmpty.classList.add('hidden');
    submissionsTableWrap.classList.remove('hidden');
