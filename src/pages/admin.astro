---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ban Quản Trị Cổng Thông Tin - CHSXUANLOC.COM"
  description="Khu vực quản trị dành cho Ban Liên Lạc duyệt bài viết kỷ yếu, danh sách đăng ký học bổng và cài đặt hệ thống."
>
  <section class="bg-navy-950 text-white py-10 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 text-xs font-semibold uppercase tracking-wider mb-2">
          <span>Hệ thống Quản Trị CHS Xuân Lộc</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-white">Bảng Điều Khiển Ban Quản Trị</h1>
      </div>
      
      <!-- Auth Status & Action -->
      <div id="auth-actions" class="flex items-center space-x-3">
        <!-- Google Sign-in or Logged user info rendered by JS -->
      </div>
    </div>
  </section>

  <!-- Admin Main Container -->
  <section class="py-10 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Unauthenticated View -->
      <div id="login-required" class="max-w-md mx-auto my-12 bg-white p-8 rounded-2xl border border-slate-200 shadow-xl text-center space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-navy-900 text-warmOrange-400 flex items-center justify-center mx-auto shadow-md">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-navy-900">Yêu Cầu Xác Thực Quản Trị</h2>
          <p class="text-xs text-slate-500 mt-2">
            Vui lòng đăng nhập bằng tài khoản Google được cấp quyền quản trị của Ban Liên Lạc Cựu Học Sinh THPT Xuân Lộc.
          </p>
        </div>

        <button
          id="google-signin-btn"
          class="w-full py-3 px-4 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-sm flex items-center justify-center space-x-3 transition active:scale-95"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Đăng nhập với Google</span>
        </button>
      </div>

      <!-- Authenticated Dashboard -->
      <div id="admin-dashboard" class="hidden space-y-8">
        
        <!-- Navigation Tabs with Hash Tracking -->
        <div class="flex border-b border-slate-200 space-x-2 sm:space-x-4 overflow-x-auto">
          <button id="tab-submissions" data-tab="submissions" class="pb-3 px-2 sm:px-3 border-b-2 border-warmOrange-500 font-bold text-xs sm:text-sm text-navy-900 whitespace-nowrap transition-colors">
            Duyệt Kỷ Yếu & Lưu Bút (<span id="count-pending">0</span>)
          </button>
          <button id="tab-scholarships" data-tab="scholarships" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 whitespace-nowrap transition-colors">
            Danh Sách Học Bổng
          </button>
          <button id="tab-automation" data-tab="automation" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5 whitespace-nowrap transition-colors">
            <span>⚡ Tự Động Hóa</span>
            <span id="tab-auto-badge" class="hidden text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-normal">Chưa cài đặt</span>
          </button>
          <button id="tab-settings" data-tab="settings" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5 whitespace-nowrap transition-colors">
            <span>⚙️ Cài Đặt</span>
          </button>
        </div>

        <!-- Section 1: Submissions Management -->
        <div id="panel-submissions" class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-bold text-navy-900">Bài gửi kỷ yếu & lưu bút cần phê duyệt</h2>
            <button id="btn-refresh-submissions" class="text-xs text-warmOrange-600 font-semibold hover:underline flex items-center space-x-1">
              <span>Làm mới danh sách</span>
            </button>
          </div>

          <div id="submissions-table-loading" class="py-12 text-center text-slate-400">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-warmOrange-500 border-t-transparent mb-2"></div>
            <p class="text-xs">Đang đồng bộ dữ liệu từ Cloud Firestore...</p>
          </div>

          <div id="submissions-table-empty" class="hidden py-8 text-center text-slate-500 bg-white rounded-xl border border-slate-200">
            <p class="text-sm font-medium">Hiện không có bài viết nào đang chờ duyệt</p>
          </div>

          <div id="submissions-container" class="grid grid-cols-1 md:grid-cols-2 gap-6 hidden"></div>
        </div>

        <!-- Section 2: Scholarships List -->
        <div id="panel-scholarships" class="hidden space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-bold text-navy-900">Danh Sách Đăng Ký Tài Trợ Học Bổng "Tiếp Sức Đến Trường"</h2>
            <button id="btn-refresh-scholarships" class="text-xs text-warmOrange-600 font-semibold hover:underline">
              Làm mới
            </button>
          </div>
          
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-100 text-navy-900 uppercase font-semibold border-b border-slate-200">
                  <tr>
                    <th class="p-3.5">Họ Tên / Đơn Vị</th>
                    <th class="p-3.5">Khóa</th>
                    <th class="p-3.5">Số Điện Thoại</th>
                    <th class="p-3.5">Mức Đăng Ký</th>
                    <th class="p-3.5">Lời Chúc / Ghi Chú</th>
                    <th class="p-3.5">Thời Gian</th>
                  </tr>
                </thead>
                <tbody id="scholarships-tbody" class="divide-y divide-slate-100">
                  <!-- Render dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Section 3: Automation Trigger -->
        <div id="panel-automation" class="hidden space-y-6">
          
          <!-- Warning banner if Token is missing -->
          <div id="automation-locked-banner" class="hidden p-5 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 space-y-2">
            <div class="flex items-center space-x-2 font-bold text-sm">
              <span>⚠️</span>
              <span>Chưa Cài Đặt GitHub Personal Access Token (PAT)</span>
            </div>
            <p class="text-xs text-amber-800 leading-relaxed">
              Để kích hoạt tự động hóa AI quét tin tức hoặc Deploy lại website, hệ thống cần GitHub Access Token để xác thực lệnh điều khiển. Vui lòng vào mục <strong>Cài Đặt</strong> để lưu cấu hình.
            </p>
            <div class="pt-2">
              <button id="btn-go-to-settings" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg text-xs transition">
                👉 Đi đến tab Cài Đặt
              </button>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-xl">
                ⚡
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-900">Điều Khiển Tự Động Hóa (GitHub Actions & AI)</h2>
                <p class="text-xs text-slate-500">Kích hoạt tác vụ quét tin tức, AI sáng tác bài tâm sự hoặc Build lại website theo yêu cầu</p>
              </div>
            </div>

            <!-- Action Trigger Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              
              <!-- Trigger Card 1: News Sync Only -->
              <div class="p-5 rounded-2xl border border-blue-200 bg-blue-50/40 hover:bg-blue-50 transition flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-2 py-0.5 rounded">Tin tức trường</span>
                    <span class="text-[10px] text-slate-400 font-mono">sync-news.yml</span>
                  </div>
                  <h3 class="text-sm font-bold text-navy-900">Quét & Đồng Bộ Tin Tức</h3>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Kích hoạt AI quét bài viết mới nhất từ Fanpage THPT Xuân Lộc & Cổng TTĐT Huyện Xuân Lộc để xuất bản tin tức.
                  </p>
                </div>
                <button 
                  id="btn-trigger-sync-news" 
                  class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow-sm transition flex items-center justify-center space-x-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span>📰 Kích hoạt Quét Tin Tức</span>
                </button>
              </div>

              <!-- Trigger Card 2: AI Tam Su Generation Only -->
              <div class="p-5 rounded-2xl border border-purple-200 bg-purple-50/40 hover:bg-purple-50 transition flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-100 px-2 py-0.5 rounded">Góc Tâm Tình</span>
                    <span class="text-[10px] text-slate-400 font-mono">generate-tam-su.yml</span>
                  </div>
                  <h3 class="text-sm font-bold text-navy-900">AI Sáng Tác Tâm Tình CHS</h3>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Kích hoạt AI viết 1 bài tản văn, hồi ức hoặc bài thơ mới về mái trường Xuân Lộc xưa vào mục Góc Tâm Tình.
                  </p>
                </div>
                <button 
                  id="btn-trigger-generate-story" 
                  class="w-full py-2.5 px-4 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl text-xs shadow-sm transition flex items-center justify-center space-x-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span>✍️ Kích hoạt AI Viết Bài</span>
                </button>
              </div>

              <!-- Trigger Card 3: Re-deploy Website -->
              <div class="p-5 rounded-2xl border border-emerald-200 bg-emerald-50/40 hover:bg-emerald-50 transition flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Hệ thống & Build</span>
                    <span class="text-[10px] text-slate-400 font-mono">deploy.yml</span>
                  </div>
                  <h3 class="text-sm font-bold text-navy-900">Build & Triển Khai Hosting</h3>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Kích hoạt quy trình build lại toàn bộ các trang tĩnh và đẩy bản phát hành mới nhất lên Firebase Hosting.
                  </p>
                </div>
                <button 
                  id="btn-trigger-deploy" 
                  class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow-sm transition flex items-center justify-center space-x-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span>🌐 Kích hoạt Deploy Web</span>
                </button>
              </div>

            </div>

            <!-- Direct GitHub Actions Link -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>Xem trực tiếp tiến độ chạy trên GitHub:</span>
              <a 
                href="https://github.com/cfmvn/chsxuanloc/actions" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center font-bold text-navy-800 hover:text-warmOrange-600 transition"
              >
                <span>Mở trang GitHub Actions</span>
                <span class="ml-1">&rarr;</span>
              </a>
            </div>

          </div>
        </div>

        <!-- Section 4: System Settings -->
        <div id="panel-settings" class="hidden space-y-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
            <div class="flex items-center space-x-3 pb-4 border-b border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center font-bold text-xl">
                ⚙️
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-900">Cài Đặt Hệ Thống & Tích Hợp</h2>
                <p class="text-xs text-slate-500">Cấu hình bảo mật và lưu trữ khóa kết nối vào cơ sở dữ liệu</p>
              </div>
            </div>

            <!-- GitHub PAT Card -->
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-bold text-navy-900">GitHub Personal Access Token (PAT)</h3>
                  <p class="text-xs text-slate-500 mt-0.5">Dùng để xác thực khi kích hoạt các quy trình Tự Động Hóa & AI (cần quyền <code>repo</code> hoặc <code>workflow</code>).</p>
                </div>
                <div id="pat-status-badge" class="text-xs px-2.5 py-1 rounded-full font-semibold bg-slate-100 text-slate-600">
                  Đang kiểm tra...
                </div>
              </div>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold text-slate-700">
                      Mã Token:
                    </label>
                    <a href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=CHS+Xuan+Loc+Admin+Trigger" target="_blank" rel="noopener noreferrer" class="text-warmOrange-600 hover:underline font-semibold text-xs">
                      Tạo token mới trên GitHub &rarr;
                    </a>
                  </div>
                  <div class="flex space-x-2">
                    <input 
                      type="password" 
                      id="gh-pat-input" 
                      placeholder="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" 
                      class="flex-1 px-3.5 py-2.5 text-xs border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-warmOrange-500 font-mono bg-white"
                    />
                    <button 
                      type="button" 
                      id="btn-toggle-pat-visibility"
                      class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl text-xs font-semibold transition"
                      title="Hiện / Ẩn token"
                    >
                      👁️
                    </button>
                    <button 
                      type="button"
                      id="btn-save-pat" 
                      class="px-5 py-2.5 bg-navy-950 hover:bg-warmOrange-600 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-1.5"
                    >
                      <span>Lưu Cấu Hình</span>
                    </button>
                    <button 
                      type="button"
                      id="btn-clear-pat" 
                      class="px-3 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-semibold transition"
                      title="Xóa token khỏi hệ thống"
                    >
                      Xóa
                    </button>
                  </div>
                </div>

                <div id="pat-feedback" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

                <div class="text-[11px] text-slate-500 space-y-1 pt-1">
                  <p>🔒 <strong>Cơ chế bảo mật:</strong> Token được lưu trữ an toàn trong Cloud Firestore (Collection <code>settings/app_config</code>) và đồng bộ trong trình duyệt của Ban Quản Trị.</p>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { auth, googleProvider, db } from '../lib/firebase';
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
  import { collection, query, orderBy, getDocs, doc, setDoc, getDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';

  const loginRequired = document.getElementById('login-required');
  const adminDashboard = document.getElementById('admin-dashboard');
  const authActions = document.getElementById('auth-actions');
  const googleBtn = document.getElementById('google-signin-btn');
  
  const tabSubmissions = document.getElementById('tab-submissions');
  const tabScholarships = document.getElementById('tab-scholarships');
  const tabAutomation = document.getElementById('tab-automation');
  const tabSettings = document.getElementById('tab-settings');
  const tabAutoBadge = document.getElementById('tab-auto-badge');

  const panelSubmissions = document.getElementById('panel-submissions');
  const panelScholarships = document.getElementById('panel-scholarships');
  const panelAutomation = document.getElementById('panel-automation');
  const panelSettings = document.getElementById('panel-settings');
  const autoLockedBanner = document.getElementById('automation-locked-banner');

  const ghPatInput = document.getElementById('gh-pat-input') as HTMLInputElement | null;
  const btnSavePat = document.getElementById('btn-save-pat');
  const btnClearPat = document.getElementById('btn-clear-pat');
  const btnTogglePatVisibility = document.getElementById('btn-toggle-pat-visibility');
  const patStatusBadge = document.getElementById('pat-status-badge');
  const btnGoToSettings = document.getElementById('btn-go-to-settings');

  const btnTriggerSyncNews = document.getElementById('btn-trigger-sync-news') as HTMLButtonElement | null;
  const btnTriggerGenerateStory = document.getElementById('btn-trigger-generate-story') as HTMLButtonElement | null;
  const btnTriggerDeploy = document.getElementById('btn-trigger-deploy') as HTMLButtonElement | null;
  const btnRefreshSubmissions = document.getElementById('btn-refresh-submissions');
  const btnRefreshScholarships = document.getElementById('btn-refresh-scholarships');

  const submissionsContainer = document.getElementById('submissions-container');
  const submissionsLoading = document.getElementById('submissions-table-loading');
  const submissionsEmpty = document.getElementById('submissions-table-empty');
  const countPending = document.getElementById('count-pending');
  const scholarshipsTbody = document.getElementById('scholarships-tbody');

  // Danh sách Email Admin được ủy quyền
  const allowedAdminEmailsStr = import.meta.env.PUBLIC_ADMIN_EMAILS || 'chsxuanloc@gmail.com,thepottershousevn@gmail.com';
  const allowedAdminEmails = allowedAdminEmailsStr
    .split(',')
    .map((e: string) => e.trim().toLowerCase())
    .filter(Boolean);

  const STORAGE_KEY_GH_PAT = 'chs_admin_gh_pat';
  let activePat = '';

  // Tab Manager with URL Hash sync
  function switchTab(tabName: string, pushHash = true) {
    const validTabs = ['submissions', 'scholarships', 'automation', 'settings'];
    const activeTab = validTabs.includes(tabName) ? tabName : 'submissions';

    // If trying to open automation but token is missing, redirect with warning
    if (activeTab === 'automation' && !activePat) {
      if (autoLockedBanner) autoLockedBanner.classList.remove('hidden');
    } else {
      if (autoLockedBanner) autoLockedBanner.classList.add('hidden');
    }

    const tabsMap: Record<string, { tabEl: HTMLElement | null; panelEl: HTMLElement | null }> = {
      submissions: { tabEl: tabSubmissions, panelEl: panelSubmissions },
      scholarships: { tabEl: tabScholarships, panelEl: panelScholarships },
      automation: { tabEl: tabAutomation, panelEl: panelAutomation },
      settings: { tabEl: tabSettings, panelEl: panelSettings },
    };

    Object.keys(tabsMap).forEach((key) => {
      const item = tabsMap[key];
      if (key === activeTab) {
        item.tabEl?.classList.remove('border-transparent', 'text-slate-500');
        item.tabEl?.classList.add('border-warmOrange-500', 'font-bold', 'text-navy-900');
        item.panelEl?.classList.remove('hidden');
      } else {
        item.tabEl?.classList.remove('border-warmOrange-500', 'font-bold', 'text-navy-900');
        item.tabEl?.classList.add('border-transparent', 'text-slate-500');
        item.panelEl?.classList.add('hidden');
      }
    });

    if (pushHash) {
      history.replaceState(null, '', `#${activeTab}`);
    }
  }

  // Bind Tab Click Events
  tabSubmissions?.addEventListener('click', () => switchTab('submissions'));
  tabScholarships?.addEventListener('click', () => switchTab('scholarships'));
  tabAutomation?.addEventListener('click', () => {
    if (!activePat) {
      alert('⚠️ Bạn chưa cấu hình GitHub Personal Access Token. Vui lòng cài đặt trước!');
      switchTab('settings');
      ghPatInput?.focus();
    } else {
      switchTab('automation');
    }
  });
  tabSettings?.addEventListener('click', () => switchTab('settings'));
  btnGoToSettings?.addEventListener('click', () => switchTab('settings'));

  // Listen to hash changes in browser
  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) switchTab(hash, false);
  });

  // Update PAT Status UI
  function updatePatState(token: string) {
    activePat = token.trim();

    if (activePat) {
      if (ghPatInput) ghPatInput.value = activePat;
      if (patStatusBadge) {
        patStatusBadge.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-800';
        patStatusBadge.textContent = '🟢 Đã cấu hình Token';
      }
      if (tabAutoBadge) tabAutoBadge.classList.add('hidden');
      if (tabAutomation) tabAutomation.classList.remove('opacity-60');
      if (btnTriggerSyncNews) btnTriggerSyncNews.disabled = false;
      if (btnTriggerGenerateStory) btnTriggerGenerateStory.disabled = false;
      if (btnTriggerDeploy) btnTriggerDeploy.disabled = false;
      if (autoLockedBanner) autoLockedBanner.classList.add('hidden');
    } else {
      if (ghPatInput) ghPatInput.value = '';
      if (patStatusBadge) {
        patStatusBadge.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-800';
        patStatusBadge.textContent = '🔴 Chưa cài đặt Token';
      }
      if (tabAutoBadge) tabAutoBadge.classList.remove('hidden');
      if (tabAutomation) tabAutomation.classList.add('opacity-60');
      if (btnTriggerSyncNews) btnTriggerSyncNews.disabled = true;
      if (btnTriggerGenerateStory) btnTriggerGenerateStory.disabled = true;
      if (btnTriggerDeploy) btnTriggerDeploy.disabled = true;
    }
  }

  const patFeedback = document.getElementById('pat-feedback');

  function showPatFeedback(msg: string, type: 'success' | 'error' | 'info') {
    if (!patFeedback) return;
    patFeedback.className = `p-3 rounded-xl text-xs font-semibold ${
      type === 'success' 
        ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
        : type === 'error'
        ? 'bg-rose-50 text-rose-800 border border-rose-200'
        : 'bg-blue-50 text-blue-800 border border-blue-200'
    }`;
    patFeedback.textContent = msg;
    patFeedback.classList.remove('hidden');
  }

  // Load PAT from Firestore and LocalStorage
  async function loadPatFromDatabase() {
    // 1. Check LocalStorage first for instant render
    const cachedPat = localStorage.getItem(STORAGE_KEY_GH_PAT) || '';
    if (cachedPat) {
      updatePatState(cachedPat);
    }

    // 2. Fetch official config from Firestore with timeout
    try {
      const fetchPromise = getDoc(doc(db, 'settings', 'app_config'));
      const timeoutPromise = new Promise((resolve) => setTimeout(resolve, 2500));
      const res: any = await Promise.race([fetchPromise, timeoutPromise]);
      if (res && res.exists && res.exists() && res.data()?.githubPat) {
        const dbPat = res.data().githubPat;
        localStorage.setItem(STORAGE_KEY_GH_PAT, dbPat);
        updatePatState(dbPat);
      } else if (!cachedPat) {
        updatePatState('');
      }
    } catch (err) {
      console.warn('Không thể đọc settings từ Firestore:', err);
    }
  }

  // Save PAT to Firestore & LocalStorage
  btnSavePat?.addEventListener('click', async () => {
    const val = (ghPatInput?.value || '').trim();
    if (!val) {
      showPatFeedback('⚠️ Vui lòng nhập GitHub Personal Access Token trước khi lưu!', 'error');
      ghPatInput?.focus();
      return;
    }

    // 1. Lưu ngay tức thì vào LocalStorage & cập nhật UI
    localStorage.setItem(STORAGE_KEY_GH_PAT, val);
    updatePatState(val);
    showPatFeedback('✓ Đang lưu Token và đồng bộ lên Database...', 'info');

    // 2. Đồng bộ lên Firestore với timeout
    try {
      const savePromise = setDoc(doc(db, 'settings', 'app_config'), {
        githubPat: val,
        updatedAt: serverTimestamp(),
        updatedBy: auth.currentUser?.email || 'admin',
      }, { merge: true });

      const timeoutPromise = new Promise((resolve) => setTimeout(resolve, 3000));
      await Promise.race([savePromise, timeoutPromise]);

      showPatFeedback('🎉 Đã lưu thành công GitHub Token vào cơ sở dữ liệu và trình duyệt! Tab Tự Động Hóa đã sẵn sàng hoạt động.', 'success');
    } catch (err: any) {
      console.warn('Lỗi khi sync PAT lên Firestore:', err);
      showPatFeedback('✓ Đã lưu Token vào trình duyệt của bạn (Tab Tự Động Hóa đã sẵn sàng hoạt động)!', 'success');
    }
  });

  // Clear PAT
  btnClearPat?.addEventListener('click', async () => {
    if (!confirm('Bạn có chắc chắn muốn xóa Token khỏi hệ thống không?')) return;

    localStorage.removeItem(STORAGE_KEY_GH_PAT);
    updatePatState('');
    showPatFeedback('Đã xóa Token khỏi hệ thống.', 'info');

    try {
      const clearPromise = setDoc(doc(db, 'settings', 'app_config'), {
        githubPat: '',
        updatedAt: serverTimestamp(),
      }, { merge: true });
      const timeoutPromise = new Promise((resolve) => setTimeout(resolve, 2000));
      await Promise.race([clearPromise, timeoutPromise]);
    } catch {}
  });

  // Toggle Visibility
  btnTogglePatVisibility?.addEventListener('click', () => {
    if (ghPatInput) {
      ghPatInput.type = ghPatInput.type === 'password' ? 'text' : 'password';
    }
  });

  // Function to dispatch GitHub Action workflow
  async function triggerGitHubWorkflow(workflowFile: string, btnElement: HTMLElement | null, successMsg: string) {
    if (!activePat) {
      alert('⚠️ Bạn chưa cài đặt GitHub Personal Access Token (PAT). Vui lòng vào tab Cài Đặt!');
      switchTab('settings');
      ghPatInput?.focus();
      return;
    }

    if (!btnElement) return;
    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>Đang gửi lệnh tới GitHub...</span>`;
    (btnElement as HTMLButtonElement).disabled = true;

    try {
      const repoOwner = 'cfmvn';
      const repoName = 'chsxuanloc';
      const response = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/actions/workflows/${workflowFile}/dispatches`, {
        method: 'POST',
        headers: {
          'Accept': 'application/vnd.github+json',
          'Authorization': `Bearer ${activePat}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({
          ref: 'main'
        })
      });

      if (response.status === 204) {
        alert(`🎉 Thành công! ${successMsg}\nGitHub Actions đang xử lý trong nền.`);
      } else {
        const data = await response.json().catch(() => ({}));
        alert(`❌ Lỗi (${response.status}): ${data.message || 'Không thể kích hoạt workflow. Vui lòng kiểm tra lại Token trong tab Cài Đặt!'}`);
      }
    } catch (err: any) {
      alert('❌ Lỗi kết nối tới GitHub API: ' + (err.message || err));
    } finally {
      btnElement.innerHTML = originalText;
      (btnElement as HTMLButtonElement).disabled = false;
    }
  }

  btnTriggerSyncNews?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình AI Quét tin tức Fanpage & Cổng TTĐT ngay bây giờ?')) {
      triggerGitHubWorkflow('sync-news.yml', btnTriggerSyncNews, 'Đã kích hoạt quét & xuất bản tin tức trường!');
    }
  });

  btnTriggerGenerateStory?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt AI sáng tác 1 bài viết mới cho Góc Tâm Tình ngay bây giờ?')) {
      triggerGitHubWorkflow('generate-tam-su.yml', btnTriggerGenerateStory, 'Đã kích hoạt AI sáng tác bài viết mới cho Góc Tâm Tình!');
    }
  });

  btnTriggerDeploy?.addEventListener('click', () => {
    if (confirm('Bạn muốn kích hoạt quy trình Build & Deploy lại toàn bộ website lên Firebase Hosting?')) {
      triggerGitHubWorkflow('deploy.yml', btnTriggerDeploy, 'Đã kích hoạt Deploy website lên Firebase Hosting!');
    }
  });

  // Auth State Listener
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      const userEmail = (user.email || '').toLowerCase().trim();
      const isAuthorized = allowedAdminEmails.includes(userEmail);

      if (!isAuthorized) {
        alert(`Tài khoản "${user.email}" không thuộc danh sách Ban Quản Trị được cấp quyền.`);
        await signOut(auth);
        if (loginRequired) loginRequired.classList.remove('hidden');
        if (adminDashboard) adminDashboard.classList.add('hidden');
        if (authActions) authActions.innerHTML = '';
        return;
      }

      if (loginRequired) loginRequired.classList.add('hidden');
      if (adminDashboard) adminDashboard.classList.remove('hidden');

      if (authActions) {
        authActions.innerHTML = `
          <div class="flex items-center space-x-3">
            <span class="text-xs text-emerald-400 font-semibold hidden sm:inline">🛡️ ${user.displayName || user.email}</span>
            <button id="btn-signout" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600/80 hover:bg-rose-600 text-white transition">
              Đăng xuất
            </button>
          </div>
        `;
        document.getElementById('btn-signout')?.addEventListener('click', () => signOut(auth));
      }

      // Load Settings & Data
      await loadPatFromDatabase();

      // Activate initial tab from URL hash
      const initialHash = window.location.hash.replace('#', '');
      switchTab(initialHash || 'submissions', false);

      loadAdminSubmissions();
      loadAdminScholarships();

    } else {
      if (loginRequired) loginRequired.classList.remove('hidden');
      if (adminDashboard) adminDashboard.classList.add('hidden');
      if (authActions) authActions.innerHTML = '';
    }
  });

  googleBtn?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, googleProvider);
    } catch (err: any) {
      alert('Đăng nhập thất bại: ' + (err.message || 'Lỗi không xác định'));
    }
  });

  btnRefreshSubmissions?.addEventListener('click', () => loadAdminSubmissions());
  btnRefreshScholarships?.addEventListener('click', () => loadAdminScholarships());

  // Load submissions for Admin review
  async function loadAdminSubmissions() {
    if (!submissionsContainer || !submissionsLoading || !submissionsEmpty) return;
    submissionsLoading.classList.remove('hidden');
    submissionsEmpty.classList.add('hidden');
    submissionsContainer.classList.add('hidden');

    try {
      const q = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      submissionsLoading.classList.add('hidden');

      if (snapshot.empty) {
        submissionsEmpty.classList.remove('hidden');
        if (countPending) countPending.textContent = '0';
        return;
      }

      let pendingCount = 0;
      submissionsContainer.innerHTML = '';
      submissionsContainer.classList.remove('hidden');

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const id = docSnap.id;
        if (item.status === 'pending') pendingCount++;

        const card = document.createElement('div');
        card.className = `bg-white rounded-2xl border ${item.status === 'approved' ? 'border-emerald-200' : 'border-amber-300 ring-2 ring-amber-100'} p-5 shadow-sm space-y-4`;
        
        let imagePart = '';
        if (item.imageUrl) {
          imagePart = `
            <div class="h-48 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 flex items-center justify-center">
              <img src="${item.imageUrl}" class="w-full h-full object-cover cursor-pointer hover:scale-105 transition duration-200" onclick="window.open('${item.imageUrl}', '_blank')" />
            </div>
          `;
        }

        const statusBadge = item.status === 'approved' 
          ? '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">✓ Đã Phê Duyệt</span>' 
          : '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">⏳ Chờ Duyệt</span>';

        card.innerHTML = `
          <div class="flex items-center justify-between">
            ${statusBadge}
            <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">${item.batch ? item.batch.replace('khoa-', 'Khóa ') : ''}</span>
          </div>

          ${imagePart}

          <div>
            <h3 class="font-bold text-navy-900 text-base">${escapeHtml(item.fullName)} ${item.className ? `(${escapeHtml(item.className)})` : ''}</h3>
            ${item.contactInfo ? `<p class="text-xs text-slate-500 font-medium mt-0.5">LH: ${escapeHtml(item.contactInfo)}</p>` : ''}
            <p class="text-xs text-slate-700 mt-2 bg-slate-50 p-3.5 rounded-xl border border-slate-100 whitespace-pre-line leading-relaxed italic">"${escapeHtml(item.message)}"</p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-2">
            ${item.status !== 'approved' ? `
              <button class="btn-approve px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition shadow-sm" data-id="${id}">
                ✓ Phê Duyệt Ngay
              </button>
            ` : `
              <button class="btn-unapprove px-3.5 py-2 rounded-xl text-xs font-semibold bg-amber-600 hover:bg-amber-700 text-white transition" data-id="${id}">
                Ẩn Khỏi Web
              </button>
            `}
            <button class="btn-delete px-3 py-2 rounded-xl text-xs font-semibold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 transition" data-id="${id}">
              Xóa
            </button>
          </div>
        `;

        submissionsContainer.appendChild(card);
      });

      if (countPending) countPending.textContent = pendingCount.toString();

      // Attach actions
      document.querySelectorAll('.btn-approve').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await updateDoc(doc(db, 'submissions', docId), { status: 'approved' });
            loadAdminSubmissions();
          }
        });
      });

      document.querySelectorAll('.btn-unapprove').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await updateDoc(doc(db, 'submissions', docId), { status: 'pending' });
            loadAdminSubmissions();
          }
        });
      });

      document.querySelectorAll('.btn-delete').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          if (!confirm('Bạn có chắc chắn muốn xóa bài viết này không?')) return;
          const docId = (e.target as HTMLElement).getAttribute('data-id');
          if (docId) {
            await deleteDoc(doc(db, 'submissions', docId));
            loadAdminSubmissions();
          }
        });
      });

    } catch (err) {
      console.error('Lỗi khi fetch Admin submissions:', err);
    }
  }

  // Load scholarships for Admin review
  async function loadAdminScholarships() {
    if (!scholarshipsTbody) return;

    try {
      const q = query(collection(db, 'scholarships'), orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);

      scholarshipsTbody.innerHTML = '';
      if (snapshot.empty) {
        scholarshipsTbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Chưa có thông tin đăng ký tài trợ nào</td></tr>';
        return;
      }

      snapshot.forEach((docSnap) => {
        const item = docSnap.data();
        const dateStr = item.createdAt ? new Date(item.createdAt.toDate()).toLocaleDateString('vi-VN') : '';
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="p-3.5 font-bold text-navy-900">${escapeHtml(item.fullName)}</td>
          <td class="p-3.5">${escapeHtml(item.batch || '—')}</td>
          <td class="p-3.5 text-warmOrange-600 font-mono">${escapeHtml(item.phone)}</td>
          <td class="p-3.5 font-semibold text-emerald-700">${escapeHtml(item.amount)} đ</td>
          <td class="p-3.5 text-slate-500 max-w-xs truncate" title="${escapeHtml(item.note || '')}">${escapeHtml(item.note || '—')}</td>
          <td class="p-3.5 text-slate-400">${dateStr}</td>
        `;
        scholarshipsTbody.appendChild(tr);
      });
    } catch (err) {
      console.error('Lỗi khi fetch scholarships:', err);
    }
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
