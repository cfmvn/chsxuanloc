    if (currentAlbumFilter === 'pending') {
      filtered = loadedAlbums.filter((a) => a.status === 'pending' || !a.status);
    } else if (currentAlbumFilter === 'approved') {
      filtered = loadedAlbums.filter((a) => a.status === 'approved');
    } else if (currentAlbumFilter === 'rejected') {
      filtered = loadedAlbums.filter((a) => a.status === 'rejected');
    }

