---
import BaseLayout from '../layouts/BaseLayout.astro';
import staticAlbumsData from '../data/albums.json';
---

<BaseLayout
  title="Ban Quản Trị Cổng Thông Tin - CHSXUANLOC.COM"
  description="Khu vực quản trị dành cho Ban Liên Lạc duyệt bài viết kỷ yếu, danh sách đăng ký học bổng và cài đặt hệ thống."
>
  <script id="static-albums-json" type="application/json" set:html={JSON.stringify(staticAlbumsData)} />
  <section class="bg-navy-950 text-white py-10 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-warmOrange-500/20 text-warmOrange-300 text-xs font-semibold uppercase tracking-wider mb-2">
          <span>Hệ thống Quản Trị CHS Xuân Lộc</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-white">Bảng Điều Khiển Ban Quản Trị</h1>
      </div>
      
      <!-- Auth Status & Action -->
      <div id="auth-actions" class="flex items-center space-x-3">
        <!-- Google Sign-in or Logged user info rendered by JS -->
      </div>
    </div>
  </section>

  <!-- Admin Main Container -->
  <section class="py-10 bg-slate-50 min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Unauthenticated View -->
      <div id="login-required" class="max-w-md mx-auto my-12 bg-white p-8 rounded-2xl border border-slate-200 shadow-xl text-center space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-navy-900 text-warmOrange-400 flex items-center justify-center mx-auto shadow-md">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-navy-900">Yêu Cầu Xác Thực Quản Trị</h2>
          <p class="text-xs text-slate-500 mt-2">
            Vui lòng đăng nhập bằng tài khoản Google được cấp quyền quản trị của Ban Liên Lạc Cựu Học Sinh THPT Xuân Lộc.
          </p>
        </div>

        <button
          id="google-signin-btn"
          class="w-full py-3 px-4 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-sm flex items-center justify-center space-x-3 transition active:scale-95"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Đăng nhập với Google</span>
        </button>
      </div>

      <!-- Authenticated Dashboard -->
      <div id="admin-dashboard" class="hidden space-y-8">
        
        <!-- Navigation Tabs with Hash Tracking -->
        <div class="flex border-b border-slate-200 space-x-2 sm:space-x-4 overflow-x-auto">
          <button id="tab-submissions" data-tab="submissions" class="pb-3 px-2 sm:px-3 border-b-2 border-warmOrange-500 font-bold text-xs sm:text-sm text-navy-900 whitespace-nowrap transition-colors">
            Duyệt Kỷ Yếu & Lưu Bút (<span id="count-pending">0</span>)
          </button>
          <button id="tab-albums" data-tab="albums" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 whitespace-nowrap transition-colors flex items-center space-x-1.5">
            <span>📸 Duyệt Album Ảnh</span>
            <span id="count-pending-albums" class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold">0</span>
          </button>
          <button id="tab-scholarships" data-tab="scholarships" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 whitespace-nowrap transition-colors">
            Danh Sách Học Bổng
          </button>
          <button id="tab-automation" data-tab="automation" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5 whitespace-nowrap transition-colors">
            <span>⚡ Tự Động Hóa</span>
            <span id="tab-auto-badge" class="hidden text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-normal">Chưa cài đặt</span>
          </button>
          <button id="tab-settings" data-tab="settings" class="pb-3 px-2 sm:px-3 border-b-2 border-transparent font-medium text-xs sm:text-sm text-slate-500 hover:text-navy-900 flex items-center space-x-1.5 whitespace-nowrap transition-colors">
            <span>⚙️ Cài Đặt</span>
          </button>
        </div>

        <!-- Section 1: Submissions Management -->
        <div id="panel-submissions" class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-navy-900">Quản Lý Kỷ Yếu & Lưu Bút Cựu Học Sinh</h2>
              <p class="text-xs text-slate-500">Xem danh sách, chỉnh sửa nội dung, duyệt hoặc từ chối bài viết</p>
            </div>
            <button id="btn-refresh-submissions" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-navy-950 transition shadow-xs flex items-center space-x-1.5 self-start sm:self-auto">
              <svg class="w-4 h-4 text-warmOrange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>Làm mới danh sách</span>
            </button>
          </div>

          <!-- Status Filter Pills -->
          <div class="flex items-center gap-2 p-1.5 bg-slate-200/70 rounded-2xl w-fit overflow-x-auto">
            <button
              class="sub-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-white text-navy-950 shadow-xs flex items-center space-x-1.5"
              data-status="pending"
            >
              <span>⏳ Chờ Duyệt</span>
              <span id="badge-pending" class="px-2 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-extrabold">0</span>
            </button>
            <button
              class="sub-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="approved"
            >
              <span>✓ Đang Publish</span>
              <span id="badge-approved" class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-extrabold">0</span>
            </button>
            <button
              class="sub-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="rejected"
            >
              <span>✕ Đã Từ Chối</span>
              <span id="badge-rejected" class="px-2 py-0.5 rounded-full text-[10px] bg-rose-100 text-rose-800 font-extrabold">0</span>
            </button>
            <button
              class="sub-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="all"
            >
              <span>Tất Cả</span>
              <span id="badge-all" class="px-2 py-0.5 rounded-full text-[10px] bg-slate-200 text-slate-700 font-extrabold">0</span>
            </button>
          </div>

          <!-- Loading State -->
          <div id="submissions-table-loading" class="py-16 text-center text-slate-400 space-y-2">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-warmOrange-500 border-t-transparent"></div>
            <p class="text-xs font-medium">Đang tải dữ liệu từ Cloud Firestore...</p>
          </div>

          <!-- Empty State -->
          <div id="submissions-table-empty" class="hidden py-12 text-center text-slate-500 bg-white rounded-2xl border border-dashed border-slate-300 p-6 space-y-2">
            <span class="text-3xl block">📭</span>
            <p class="text-sm font-bold text-navy-900">Không tìm thấy bài viết nào trong mục này</p>
            <p class="text-xs text-slate-400">Bạn có thể chọn tab lọc khác hoặc kích hoạt AI viết bài mới trong tab Tự Động Hóa.</p>
          </div>

          <!-- Submissions Table List -->
          <div id="submissions-table-wrap" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-navy-900 uppercase font-bold text-[11px] border-b border-slate-200 tracking-wider">
                  <tr>
                    <th class="py-3.5 px-4">Bài Viết & Tiêu Đề</th>
                    <th class="py-3.5 px-4">Tác Giả / Niên Khóa</th>
                    <th class="py-3.5 px-4">Chủ Đề</th>
                    <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                    <th class="py-3.5 px-4">Thời Gian</th>
                    <th class="py-3.5 px-4 text-right">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="submissions-tbody" class="divide-y divide-slate-100">
                  <!-- Render dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Submission Detail & Edit Modal -->
        <div id="modal-edit-submission" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-xs hidden">
          <div class="bg-white rounded-3xl max-w-3xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-xl">📝</span>
                <div>
                  <h3 class="text-base font-bold text-navy-900" id="modal-header-title">Chi Tiết & Biên Tập Bài Viết</h3>
                  <p class="text-[11px] text-slate-500" id="modal-header-meta">Mã: <span id="modal-doc-id" class="font-mono text-warmOrange-600"></span></p>
                </div>
              </div>
              <button id="btn-close-modal" class="w-8 h-8 rounded-full bg-slate-200/70 hover:bg-slate-300 text-slate-600 flex items-center justify-center transition">
                ✕
              </button>
            </div>

            <!-- Modal Body (Edit Form) -->
            <div class="p-6 overflow-y-auto space-y-4 text-xs flex-1">
              <input type="hidden" id="edit-doc-id" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Họ tên / Tác giả</label>
                  <input type="text" id="edit-fullName" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 bg-white" />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Niên khóa</label>
                  <input type="text" id="edit-batch" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 bg-white" placeholder="VD: Khóa 2004 - 2007" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Lớp / Thông tin phụ</label>
                  <input type="text" id="edit-className" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 bg-white" placeholder="VD: 12A1" />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Chủ đề bài viết</label>
                  <select id="edit-topic" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-warmOrange-500 bg-white">
                    <option value="ao-trang">🌸 Thời áo trắng & Bạn cũ</option>
                    <option value="thay-co">💐 Kỷ niệm bên bục giảng</option>
                    <option value="lap-nghiep">💼 Hành trình lập nghiệp</option>
                    <option value="tam-tinh">💌 Lời chưa kịp nói</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Tiêu đề bài viết</label>
                <input type="text" id="edit-title" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:ring-2 focus:ring-warmOrange-500 bg-white" placeholder="Tiêu đề gợi cảm xúc..." />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Nội dung bài viết / Thơ / Tản văn</label>
                <textarea id="edit-message" rows="8" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs leading-relaxed focus:ring-2 focus:ring-warmOrange-500 bg-white font-serif"></textarea>
              </div>

              <div id="modal-image-preview-wrap" class="hidden">
                <label class="block font-bold text-slate-700 mb-1">Ảnh kỷ niệm đính kèm</label>
                <div class="relative inline-block rounded-xl overflow-hidden border border-slate-200 max-h-48">
                  <img id="modal-image-preview" src="#" class="max-h-48 object-cover cursor-pointer" onclick="window.open(this.src, '_blank')" />
                </div>
              </div>

              <div class="pt-2">
                <label class="block font-bold text-slate-700 mb-1">Trạng thái phê duyệt</label>
                <div class="flex flex-wrap gap-3">
                  <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-amber-200 bg-amber-50 cursor-pointer">
                    <input type="radio" name="edit-status" value="pending" class="text-warmOrange-600 focus:ring-warmOrange-500" />
                    <span class="font-bold text-amber-800">⏳ Chờ duyệt (Pending)</span>
                  </label>
                  <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-emerald-200 bg-emerald-50 cursor-pointer">
                    <input type="radio" name="edit-status" value="approved" class="text-emerald-600 focus:ring-emerald-500" />
                    <span class="font-bold text-emerald-800">✓ Phê duyệt xuất bản (Approved)</span>
                  </label>
                  <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-rose-200 bg-rose-50 cursor-pointer">
                    <input type="radio" name="edit-status" value="rejected" class="text-rose-600 focus:ring-rose-500" />
                    <span class="font-bold text-rose-800">✕ Từ chối bài (Rejected)</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
              <button type="button" id="btn-modal-delete" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition">
                🗑️ Xóa Bài Viết
              </button>

              <div class="flex items-center space-x-2">
                <button type="button" id="btn-modal-cancel" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-200 transition">
                  Đóng
                </button>
                <button type="button" id="btn-modal-save" class="px-6 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-warmOrange-500 to-amber-600 hover:from-warmOrange-600 hover:to-amber-700 text-white transition shadow-sm flex items-center space-x-1.5">
                  <span>💾 Lưu & Áp Dụng</span>
                </button>
              </div>
            </div>
          </div>
        </div>


        <!-- Section: Album Submissions Management -->
        <div id="panel-albums" class="hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-navy-900">Quản Lý Album Ảnh Đóng Góp</h2>
              <p class="text-xs text-slate-500">Xem xét link Google Drive, ảnh kỷ niệm cựu học sinh gửi về và phê duyệt lên Thư Viện</p>
            </div>
            <button id="btn-refresh-albums" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-navy-950 transition shadow-xs flex items-center space-x-1.5 self-start sm:self-auto">
              <svg class="w-4 h-4 text-warmOrange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>Làm mới Album</span>
            </button>
          </div>

          <!-- Album Status Filter Pills -->
          <div class="flex items-center gap-2 p-1.5 bg-slate-200/70 rounded-2xl w-fit overflow-x-auto">
            <button
              class="album-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-white text-navy-950 shadow-xs flex items-center space-x-1.5"
              data-status="pending"
            >
              <span>⏳ Chờ Duyệt</span>
              <span id="badge-albums-pending" class="px-2 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-extrabold">0</span>
            </button>
            <button
              class="album-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="approved"
            >
              <span>✓ Đã Duyệt</span>
              <span id="badge-albums-approved" class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-extrabold">0</span>
            </button>
            <button
              class="album-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="rejected"
            >
              <span>✕ Đã Từ Chối</span>
              <span id="badge-albums-rejected" class="px-2 py-0.5 rounded-full text-[10px] bg-rose-100 text-rose-800 font-extrabold">0</span>
            </button>
            <button
              class="album-filter-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 hover:text-navy-950 transition flex items-center space-x-1.5"
              data-status="all"
            >
              <span>Tất Cả</span>
              <span id="badge-albums-all" class="px-2 py-0.5 rounded-full text-[10px] bg-slate-200 text-slate-700 font-extrabold">0</span>
            </button>
          </div>

          <!-- Loading State -->
          <div id="albums-table-loading" class="py-16 text-center text-slate-400 space-y-2">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-warmOrange-500 border-t-transparent"></div>
            <p class="text-xs font-medium">Đang tải danh sách album gửi về...</p>
          </div>

          <!-- Empty State -->
          <div id="albums-table-empty" class="hidden py-12 text-center text-slate-500 bg-white rounded-2xl border border-dashed border-slate-300 p-6 space-y-2">
            <span class="text-3xl block">🖼️</span>
            <p class="text-sm font-bold text-navy-900">Không có album ảnh nào trong mục này</p>
            <p class="text-xs text-slate-400">Các album do cựu học sinh đóng góp từ trang Thư Viện Album sẽ xuất hiện tại đây.</p>
          </div>

          <!-- Albums Table List -->
          <div id="albums-table-wrap" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-navy-900 uppercase font-bold text-[11px] border-b border-slate-200 tracking-wider">
                  <tr>
                    <th class="py-3.5 px-4">Album & Chủ Đề</th>
                    <th class="py-3.5 px-4">Người Gửi / Niên Khóa</th>
                    <th class="py-3.5 px-4">Google Drive / Số Lượng</th>
                    <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                    <th class="py-3.5 px-4">Thời Gian</th>
                    <th class="py-3.5 px-4 text-right">Thao Tác</th>
                  </tr>
                </thead>
                <tbody id="albums-tbody" class="divide-y divide-slate-100">
                  <!-- Render dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

